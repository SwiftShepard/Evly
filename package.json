{
  "name": "evly",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "description": "Evly — l'électrique mesuré. Comparateur indépendant de véhicules électriques pour le marché français.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-vehicle-snapshots.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:typo": "node scripts/check-emdash.mjs",
    "test:e2e": "playwright test",
    "sync:nyland": "node scripts/download-nyland.mjs && node scripts/sync-nyland-ranges.mjs",
    "audit:data": "node scripts/audit-vehicles.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "map:roads": "python scripts/map/build-road-graph.py scratch/osm/france.osm.pbf public/carte/routes.bin.gz",
    "map:places": "python scripts/map/build-places.py scratch/osm/france.osm.pbf public/carte",
    "map:chargers": "python scripts/map/build-chargers.py scratch/irve/irve.csv public/carte"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "astro": "^5.1.6",
    "chart.js": "^4.4.7",
    "d3-contour": "^4.0.2",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/d3-contour": "^3.0.6"
  }
}
