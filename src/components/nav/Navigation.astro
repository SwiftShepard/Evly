---
import Wordmark from "@/components/ui/Wordmark.astro";
import { url } from "@/lib/url";
import { ChevronDown, Menu, X } from "lucide-react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navigationStructure = [
  {
    label: "Véhicules",
    items: [
      { href: url("/vehicules/"), label: "Particuliers", desc: "Tout le catalogue, avec filtres" },
      { href: url("/marques/"), label: "Par marque", desc: "Les gammes électriques, marque par marque" },
      { href: url("/voitures-electriques/"), label: "Sélections", desc: "Citadines, SUV, familiales, petits budgets" },
      { href: url("/bons-plans/"), label: "Bons plans", desc: "Mieux équipé pour le même budget" },
      { href: url("/pro/vehicules/"), label: "Utilitaires (Pro)", desc: "Fourgons et ludospaces électriques" },
      { href: url("/leasing-social/"), label: "Leasing Social", desc: "Conditions et modèles éligibles" },
    ]
  },
  {
    label: "Outils",
    items: [
      { href: url("/comparer/"), label: "Comparateur", desc: "Jusqu'à 4 modèles côte à côte" },
      { href: url("/simulateur/"), label: "Calculateur TCO", desc: "Le coût réel sur plusieurs années" },
      { href: url("/pro/"), label: "Simulateur Pro", desc: "Le coût total pour une entreprise" },
    ]
  },
  {
    label: "Ressources",
    items: [
      { href: url("/methodologie/"), label: "Méthodologie", desc: "Comment on mesure et on calcule" },
      { href: url("/glossaire/"), label: "Glossaire", desc: "Les termes de l'électrique expliqués" },
    ]
  }
];

function isActive(href: string): boolean {
  const target = href.replace(/\/$/, "") || "/";
  const plain = target.replace(base, "") || "/";
  if (plain === "/") return pathname === "/" || pathname === base;
  return pathname === target || pathname.startsWith(target + "/");
}

function isGroupActive(group: typeof navigationStructure[0]): boolean {
  return group.items.some(item => isActive(item.href));
}
---

<header
  class="nav-header sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] backdrop-blur-xl backdrop-saturate-150"
>
  <div class="container-edit flex items-center justify-between gap-6 h-16">
    <a href={url("/")} class="flex items-baseline gap-3 min-h-[44px] py-2 shrink-0">
      <Wordmark size="lg" />
      <span class="hidden lg:inline text-[13px] text-[var(--color-text-faint)] tracking-[-0.005em]">L'électrique mesuré</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-1">
      {
        navigationStructure.map((group) => (
          <div class="nav-dropdown-group">
            <button
              class:list={[
                "nav-link h-9 px-3.5 text-[14.5px] tracking-[-0.01em] inline-flex items-center gap-1.5",
                isGroupActive(group)
                  ? "text-[var(--color-text)] font-medium"
                  : "text-[var(--color-text-muted)] hover:text-[var(--color-text)]",
              ]}
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.label}
              <ChevronDown size={14} strokeWidth={2} className="chevron opacity-50 transition-transform duration-200" aria-hidden="true" />
            </button>
            <div class="nav-dropdown-menu">
              {
                group.items.map((item) => (
                  <a
                    href={item.href}
                    class:list={["nav-dropdown-item", isActive(item.href) && "active"]}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    <span class="nav-dropdown-item-title">{item.label}</span>
                    <span class="nav-dropdown-item-desc">{item.desc}</span>
                  </a>
                ))
              }
            </div>
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={url("/recommandation/")} class="btn btn-primary btn-sm hidden md:inline-flex">
        Trouver mon VE
      </a>

      <details class="nav-mobile md:hidden">
        <summary
          class="list-none cursor-pointer text-[var(--color-text)] h-11 w-11 -mr-2 flex items-center justify-center rounded-full hover:bg-[var(--color-bg-subtle)]"
          aria-label="Ouvrir le menu"
        >
          <Menu size={20} strokeWidth={1.75} className="nav-mobile-open" aria-hidden="true" />
          <X size={20} strokeWidth={1.75} className="nav-mobile-close" aria-hidden="true" />
        </summary>
        {/* Positionné par rapport à l'en-tête (le flou d'arrière-plan en fait le bloc conteneur) */}
        <div class="mobile-menu absolute left-0 right-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto bg-[var(--color-bg)] border-t border-[var(--color-border)] px-4 pt-5 pb-8 z-50">
          {
            navigationStructure.map((group) => (
              <div class="mb-6">
                <p class="label-eyebrow px-1 mb-1.5">{group.label}</p>
                <ul class="flex flex-col">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          "flex items-baseline justify-between gap-3 px-1 py-2.5 border-b border-[var(--color-border)]",
                          isActive(item.href) ? "text-[var(--color-accent)]" : "text-[var(--color-text)]",
                        ]}
                        aria-current={isActive(item.href) ? "page" : undefined}
                      >
                        <span class="text-[17px] font-medium tracking-[-0.015em]">{item.label}</span>
                        <span class="text-[13px] text-[var(--color-text-faint)] text-right">{item.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <a href={url("/recommandation/")} class="btn btn-primary w-full">
            Trouver mon VE
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-mobile .nav-mobile-close { display: none; }
  .nav-mobile[open] .nav-mobile-open { display: none; }
  .nav-mobile[open] .nav-mobile-close { display: block; }
  .nav-mobile summary::-webkit-details-marker { display: none; }
</style>

<script>
  // Menus déroulants (ouverts au survol et au focus) : l'état ouvert/fermé est
  // annoncé aux lecteurs d'écran, Échap referme le menu et rend le focus au bouton.
  function setupNavDropdowns() {
    document.querySelectorAll<HTMLElement>(".nav-dropdown-group").forEach((group) => {
      const button = group.querySelector<HTMLButtonElement>("button");
      if (!button || group.dataset.a11yReady) return;
      group.dataset.a11yReady = "true";
      const sync = () => {
        const open = group.matches(":hover") || group.contains(document.activeElement);
        button.setAttribute("aria-expanded", String(open && !group.classList.contains("is-dismissed")));
      };
      group.addEventListener("mouseenter", () => { group.classList.remove("is-dismissed"); sync(); });
      group.addEventListener("mouseleave", sync);
      group.addEventListener("focusin", (e) => {
        if (e.target !== button) group.classList.remove("is-dismissed");
        sync();
      });
      group.addEventListener("focusout", () => requestAnimationFrame(() => { group.classList.remove("is-dismissed"); sync(); }));
      group.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        group.classList.add("is-dismissed");
        button.focus();
        sync();
      });
    });

    // Menu mobile plein écran : bloque le défilement de la page tant qu'il est ouvert
    document.querySelectorAll<HTMLDetailsElement>(".nav-mobile").forEach((menu) => {
      if (menu.dataset.ready) return;
      menu.dataset.ready = "true";
      menu.addEventListener("toggle", () => {
        document.documentElement.style.overflow = menu.open ? "hidden" : "";
      });
    });
  }
  setupNavDropdowns();
  document.addEventListener("astro:page-load", () => {
    document.documentElement.style.overflow = "";
    setupNavDropdowns();
  });
</script>
