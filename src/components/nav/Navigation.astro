---
import Wordmark from "@/components/ui/Wordmark.astro";
import { url } from "@/lib/url";
import { ChevronDown, Menu, X, Search, Route, ArrowRight } from "lucide-react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navigationStructure = [
  {
    label: "Véhicules",
    items: [
      { href: url("/vehicules/"), label: "Particuliers", desc: "Tout le catalogue, avec filtres" },
      { href: url("/marques/"), label: "Par marque", desc: "Les gammes électriques, marque par marque" },
      { href: url("/voitures-electriques/"), label: "Sélections", desc: "Citadines, SUV, familiales, petits budgets" },
      { href: url("/bons-plans/"), label: "Bons plans", desc: "Mieux équipé pour le même budget" },
      { href: url("/pro/vehicules/"), label: "Utilitaires (Pro)", desc: "Fourgons et ludospaces électriques" },
      { href: url("/leasing-social/"), label: "Leasing Social", desc: "Conditions et modèles éligibles" },
    ],
  },
  {
    label: "Outils",
    items: [
      { href: url("/ma-semaine/"), label: "Ma semaine", desc: "Votre quotidien et vos escapades, sur la carte" },
      { href: url("/comparer/"), label: "Comparateur", desc: "Jusqu'à 4 modèles côte à côte" },
      { href: url("/simulateur/"), label: "Calculateur TCO", desc: "Le coût réel sur plusieurs années" },
      { href: url("/pro/"), label: "Simulateur Pro", desc: "Le coût total pour une entreprise" },
    ],
  },
  {
    label: "Ressources",
    items: [
      { href: url("/methodologie/"), label: "Méthodologie", desc: "Comment on mesure et on calcule" },
      { href: url("/glossaire/"), label: "Glossaire", desc: "Les termes de l'électrique expliqués" },
    ],
  },
];

// Accès rapides proposés par la recherche quand rien n'est encore tapé
const quickLinks = [
  { href: url("/vehicules/"), label: "Tout le catalogue" },
  { href: url("/recommandation/"), label: "Trouver mon VE en quelques questions" },
  { href: url("/comparer/"), label: "Comparer des modèles" },
  { href: url("/simulateur/"), label: "Calculer le coût réel" },
  { href: url("/leasing-social/"), label: "Leasing social" },
];

function isActive(href: string): boolean {
  const target = href.replace(/\/$/, "") || "/";
  const plain = target.replace(base, "") || "/";
  if (plain === "/") return pathname === "/" || pathname === base;
  return pathname === target || pathname.startsWith(target + "/");
}

function isGroupActive(group: (typeof navigationStructure)[0]): boolean {
  return group.items.some((item) => isActive(item.href));
}
---

<header class="nav-shell sticky top-0 z-40 pt-2.5 md:pt-3">
  <div class="container-edit">
    <div class="nav-header nav-pill">
      <a href={url("/")} class="flex items-baseline gap-2.5 min-h-[44px] py-2 pl-1.5 shrink-0" aria-label="Evly, accueil">
        <Wordmark size="lg" />
      </a>

      <button type="button" class="search-trigger hidden lg:flex" data-search-open aria-haspopup="dialog">
        <Search size={16} strokeWidth={2} aria-hidden="true" />
        <span class="flex-1 text-left">Rechercher un modèle</span>
        <kbd>/</kbd>
      </button>

      <nav aria-label="Navigation principale" class="hidden xl:flex items-center gap-0.5">
        {navigationStructure.map((group) => (
          <div class="nav-dropdown-group">
            <button
              class:list={[
                "nav-link h-10 px-3.5 text-[14.5px] tracking-[-0.01em] inline-flex items-center gap-1.5",
                isGroupActive(group) ? "text-[var(--color-text)] font-semibold" : "text-[var(--color-text-muted)] hover:text-[var(--color-text)]",
              ]}
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              {group.label}
              <ChevronDown size={14} strokeWidth={2} className="chevron opacity-50 transition-transform duration-200" aria-hidden="true" />
            </button>
            <div class="nav-dropdown-menu">
              {group.items.map((item) => (
                <a href={item.href} class:list={["nav-dropdown-item", isActive(item.href) && "active"]} aria-current={isActive(item.href) ? "page" : undefined}>
                  <span class="nav-dropdown-item-title">{item.label}</span>
                  <span class="nav-dropdown-item-desc">{item.desc}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>

      <div class="flex items-center gap-1.5 ml-auto xl:ml-0">
        <button type="button" class="nav-icon-btn inline-flex lg:hidden" data-search-open aria-label="Rechercher un modèle" aria-haspopup="dialog">
          <Search size={19} strokeWidth={2} aria-hidden="true" />
        </button>

        {/* Mon trajet : réglage qui personnalise tout le site */}
        <div class="trip-control" data-trip-control>
          <button type="button" class="trip-chip" aria-expanded="false" aria-controls="trip-pop" data-trip-toggle>
            <Route size={16} strokeWidth={2} aria-hidden="true" />
            <span class="hidden sm:inline">Mon trajet</span>
            <b data-trip-label>40 km/j</b>
          </button>
          <div id="trip-pop" class="trip-pop" role="dialog" aria-label="Mon trajet quotidien" hidden>
            <p class="font-display text-[22px] font-extrabold tracking-[-0.03em] leading-none">Mon trajet</p>
            <p class="mt-1.5 text-[13px] text-[var(--color-text-muted)] leading-snug">Il sert à calculer, partout sur le site, combien de jours chaque modèle tient et ce que coûte votre énergie.</p>
            <label for="trip-km-nav" class="mt-5 flex items-baseline justify-between gap-3">
              <span class="text-[13.5px] font-medium">Trajet quotidien, aller et retour</span>
              <output for="trip-km-nav" class="font-display text-[24px] font-extrabold tracking-[-0.03em] text-[var(--color-accent)] whitespace-nowrap" data-trip-out>40 km</output>
            </label>
            <input id="trip-km-nav" type="range" min="10" max="200" step="5" value="40" class="trip-range mt-2" data-trip-range />
            <label class="trip-toggle mt-4">
              <input type="checkbox" data-trip-home checked />
              <span class="trip-toggle-ui" aria-hidden="true"></span>
              <span class="text-[13.5px]">Je peux recharger chez moi</span>
            </label>
            <a href={url("/ma-semaine/")} class="trip-week-link mt-4">
              <span>Voir ma semaine sur la carte</span>
              <ArrowRight size={15} strokeWidth={2.2} aria-hidden="true" />
            </a>
            <p class="mt-3 pt-3 border-t border-[var(--color-border)] text-[12px] text-[var(--color-text-faint)]">Enregistré sur cet appareil uniquement.</p>
          </div>
        </div>

        <a href={url("/recommandation/")} class="btn btn-primary btn-sm hidden md:inline-flex">Trouver mon VE</a>

        <button type="button" class="nav-icon-btn inline-flex xl:hidden" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
          <Menu size={20} strokeWidth={1.75} className="menu-open-icon" aria-hidden="true" />
          <X size={20} strokeWidth={1.75} className="menu-close-icon" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>

  {/* Menu plein écran (tablette, mobile) */}
  <div id="mobile-menu" class="mobile-sheet xl:hidden" hidden>
    <div class="container-edit py-6">
      {navigationStructure.map((group) => (
        <div class="mb-6">
          <p class="label-eyebrow px-1 mb-1.5">{group.label}</p>
          <ul class="flex flex-col">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["flex items-baseline justify-between gap-3 px-1 py-3 border-b border-[var(--color-border)]", isActive(item.href) ? "text-[var(--color-accent)]" : "text-[var(--color-text)]"]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  <span class="font-display text-[19px] font-bold tracking-[-0.02em] whitespace-nowrap shrink-0">{item.label}</span>
                  <span class="text-[13px] text-[var(--color-text-faint)] text-right">{item.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <a href={url("/recommandation/")} class="btn btn-primary w-full">Trouver mon VE</a>
    </div>
  </div>

  {/* Recherche instantanée */}
  <dialog class="search-dialog" aria-label="Rechercher un modèle" data-search-dialog data-index={url("/recherche.json")} data-base={url("/vehicules/")}>
    <div class="search-head">
      <Search size={20} strokeWidth={2} className="shrink-0 text-[var(--color-text-faint)]" aria-hidden="true" />
      <input type="search" class="search-input" placeholder="Renault 5, Tesla, Kia EV3…" autocomplete="off" spellcheck="false" aria-label="Modèle ou marque" aria-controls="search-results" data-search-input />
      <button type="button" class="search-close" data-search-close aria-label="Fermer la recherche"><kbd>Échap</kbd></button>
    </div>
    <div class="search-body">
      <ul id="search-results" class="search-results" role="listbox" aria-label="Résultats" data-search-results></ul>
      <div class="search-quick" data-search-quick>
        <p class="label-eyebrow px-3 mb-1.5">Accès rapides</p>
        <ul>
          {quickLinks.map((l) => (
            <li><a href={l.href} class="search-quick-link">{l.label}<ArrowRight size={15} strokeWidth={2} aria-hidden="true" /></a></li>
          ))}
        </ul>
      </div>
      <p class="search-empty" data-search-empty hidden>Aucun modèle ne correspond. Essayez une marque (« Kia ») ou un modèle (« EV3 »).</p>
    </div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> naviguer</span>
      <span><kbd>Entrée</kbd> ouvrir la fiche</span>
      <span class="ml-auto">La règle : <i class="rail-key rail-key-winter"></i> hiver <i class="rail-key rail-key-real"></i> réelle <i class="rail-key rail-key-promise"></i> promis</span>
    </div>
  </dialog>
</header>

<style>
  .nav-shell { pointer-events: none; }
  .nav-shell > * { pointer-events: auto; }
  .nav-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.75rem;
    padding: 0 0.5rem 0 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }
  .search-trigger {
    align-items: center;
    gap: 0.6rem;
    width: 15.5rem;
    height: 2.5rem;
    padding: 0 0.5rem 0 0.95rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-faint);
    font-size: 14px;
    transition: border-color 200ms var(--ease-out-expo), color 200ms var(--ease-out-expo);
  }
  .search-trigger:hover { border-color: var(--color-border-strong); color: var(--color-text-muted); }
  kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 4px 6px;
    border-radius: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-faint);
  }
  .nav-icon-btn {
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-text);
    transition: background-color 150ms var(--ease-out-expo);
  }
  .nav-icon-btn:hover { background: var(--color-bg-subtle); }
  .menu-close-icon { display: none; }
  [data-menu-toggle][aria-expanded="true"] .menu-open-icon { display: none; }
  [data-menu-toggle][aria-expanded="true"] .menu-close-icon { display: block; }

  .trip-control { position: relative; }
  .trip-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.5rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: var(--color-surface-accent);
    color: var(--color-accent);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 200ms var(--ease-out-expo), transform 160ms var(--ease-out-expo);
  }
  .trip-chip b { font-weight: 700; color: var(--color-ink); }
  .trip-chip:hover { background: color-mix(in srgb, var(--color-lime) 70%, var(--color-surface-accent)); }
  .trip-chip:active { transform: scale(0.97); }
  .trip-chip[aria-expanded="true"] { background: var(--color-lime); }
  .trip-pop {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(21rem, calc(100vw - 2rem));
    padding: 1.25rem 1.25rem 1rem;
    border-radius: var(--radius-tile);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    transform-origin: top right;
    z-index: 60;
    transition: opacity 180ms var(--ease-out-expo), transform 180ms var(--ease-out-expo);
    @starting-style {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }
  @keyframes pop-in {
    from { opacity: 0; transform: translateY(-4px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .mobile-sheet {
    position: fixed;
    inset: 4.75rem 0 0 0;
    overflow-y: auto;
    background: var(--color-bg);
    z-index: 45;
    animation: pop-in 220ms var(--ease-out-expo);
  }
  .mobile-sheet[hidden] { display: none; }

  /* Recherche */
  .search-dialog {
    width: min(42rem, calc(100vw - 1.5rem));
    max-height: min(40rem, calc(100dvh - 3rem));
    margin: 8vh auto auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    background: var(--color-surface-elevated);
    color: var(--color-text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  /* Ouverte au clavier des dizaines de fois : aucune animation, elle doit être instantanée */
  .search-dialog[open] { display: flex; flex-direction: column; }
  .search-dialog::backdrop { background: rgba(23, 32, 15, 0.35); backdrop-filter: blur(3px); }
  .search-head { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1rem 0.9rem 1.25rem; border-bottom: 1px solid var(--color-border); }
  .search-input { flex: 1; min-width: 0; background: transparent; outline: none; font-size: 17px; color: var(--color-text); }
  .search-input::placeholder { color: var(--color-text-faint); }
  .search-input::-webkit-search-cancel-button { display: none; }
  .search-body { flex: 1; overflow-y: auto; padding: 0.5rem; }
  .search-quick-link {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.75rem; border-radius: 14px; font-size: 15px; font-weight: 500;
  }
  .search-quick-link:hover, .search-quick-link:focus-visible { background: var(--color-bg-subtle); }
  .search-empty { padding: 1.25rem 0.75rem; font-size: 14px; color: var(--color-text-muted); }
  .search-foot {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem;
    padding: 0.65rem 1.25rem; border-top: 1px solid var(--color-border);
    font-size: 12px; color: var(--color-text-faint); background: var(--color-surface);
  }
  .search-foot span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .search-foot .rail-key { width: 12px; height: 6px; }
  @media (max-width: 639px) { .search-foot .ml-auto { display: none; } }
</style>

<style is:global>
  /* Résultats de recherche (construits en JS) */
  .search-hit {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0.75rem;
    border-radius: 14px;
    cursor: pointer;
  }
  .search-hit[aria-selected="true"] { background: var(--color-bg-subtle); }
  .search-hit-img { height: 2.6rem; display: flex; align-items: flex-end; justify-content: center; }
  .search-hit-img img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .search-hit-name { display: block; font-weight: 600; font-size: 15px; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .search-hit-brand { color: var(--color-text-faint); font-weight: 400; }
  .search-hit .rail { margin-top: 0.45rem; --rail-surface: var(--color-surface-elevated); }
  .search-hit[aria-selected="true"] .rail { --rail-surface: var(--color-bg-subtle); }
  .search-hit-meta { text-align: right; font-size: 13px; color: var(--color-text-muted); white-space: nowrap; }
  .search-hit-meta b { display: block; font-family: var(--font-display); font-size: 18px; font-weight: 800; letter-spacing: -0.03em; color: var(--color-text); }
  .search-hit-days { font-size: 12px; color: var(--color-accent); }
  .search-hit-days[data-fit="0"] { color: var(--color-danger); }

  /* Réglage du trajet (navigation, accueil, fiches) */
  .trip-range {
    width: 100%;
    height: 8px;
    appearance: none;
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-accent) var(--fill, 16%), color-mix(in srgb, var(--color-accent) 16%, transparent) var(--fill, 16%));
    cursor: pointer;
  }
  .trip-range:active { cursor: grabbing; }
  .trip-range::-webkit-slider-thumb {
    appearance: none;
    cursor: grab;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-surface-elevated);
    border: 5px solid var(--color-accent);
    box-shadow: 0 4px 10px -2px rgba(23, 32, 15, 0.35);
    transition: transform 160ms var(--ease-out-expo);
  }
  .trip-range:active::-webkit-slider-thumb { transform: scale(1.12); }
  .trip-range::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--color-surface-elevated); border: 5px solid var(--color-accent); }
  .trip-toggle { display: flex; align-items: center; gap: 0.65rem; cursor: pointer; }
  .trip-week-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    background: var(--color-surface-accent);
    color: var(--color-accent-dim);
    font-size: 13.5px;
    font-weight: 600;
    transition: background-color 200ms var(--ease-out-expo);
  }
  .trip-week-link:hover { background: var(--color-lime); }
  .trip-toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .trip-toggle-ui {
    position: relative; flex-shrink: 0; width: 2.5rem; height: 1.5rem; border-radius: 999px;
    background: var(--color-border-strong); transition: background-color 200ms var(--ease-out-expo);
  }
  .trip-toggle-ui::after {
    content: ""; position: absolute; top: 3px; left: 3px; width: 1.125rem; height: 1.125rem; border-radius: 999px;
    background: var(--color-surface-elevated); box-shadow: 0 1px 3px rgba(23, 32, 15, 0.3);
    transform-origin: left center;
    transition: transform 220ms var(--ease-out-expo), scale 160ms var(--ease-out-expo);
  }
  /* Appui : la pastille s'étire vers sa destination, comme un interrupteur iOS */
  .trip-toggle:active .trip-toggle-ui::after { scale: 1.2 1; }
  .trip-toggle input:checked + .trip-toggle-ui::after { transform-origin: right center; }
  .trip-toggle input:checked + .trip-toggle-ui { background: var(--color-accent); }
  .trip-toggle input:checked + .trip-toggle-ui::after { transform: translateX(1rem); }
  .trip-toggle input:focus-visible + .trip-toggle-ui { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>

<script>
  import { readTrip, writeTrip, onTripChange, paintRails, daysOf, fitsTrip, type Trip } from "@/lib/trip";
  import { pulse } from "@/lib/tween";

  // ── Menus déroulants : état annoncé, Échap referme et rend le focus ──
  function setupNavDropdowns() {
    document.querySelectorAll<HTMLElement>(".nav-dropdown-group").forEach((group) => {
      const button = group.querySelector<HTMLButtonElement>("button");
      if (!button || group.dataset.a11yReady) return;
      group.dataset.a11yReady = "true";
      const sync = () => {
        const open = group.matches(":hover") || group.contains(document.activeElement);
        button.setAttribute("aria-expanded", String(open && !group.classList.contains("is-dismissed")));
      };
      group.addEventListener("mouseenter", () => { group.classList.remove("is-dismissed"); sync(); });
      group.addEventListener("mouseleave", sync);
      group.addEventListener("focusin", (e) => { if (e.target !== button) group.classList.remove("is-dismissed"); sync(); });
      group.addEventListener("focusout", () => requestAnimationFrame(() => { group.classList.remove("is-dismissed"); sync(); }));
      group.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        group.classList.add("is-dismissed");
        button.focus();
        sync();
      });
    });
  }

  // ── Menu plein écran ──
  function setupMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const sheet = document.getElementById("mobile-menu");
    if (!toggle || !sheet || toggle.dataset.ready) return;
    toggle.dataset.ready = "true";
    const set = (open: boolean) => {
      sheet.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
      document.documentElement.style.overflow = open ? "hidden" : "";
    };
    toggle.addEventListener("click", () => set(sheet.hidden));
    sheet.addEventListener("keydown", (e) => { if (e.key === "Escape") { set(false); toggle.focus(); } });
  }

  // ── Mon trajet ──
  const fill = (input: HTMLInputElement) => {
    const pct = ((+input.value - +input.min) / (+input.max - +input.min)) * 100;
    input.style.setProperty("--fill", `${pct}%`);
  };

  function renderTrip(t: Trip) {
    document.querySelectorAll<HTMLElement>("[data-trip-label]").forEach((el) => { el.textContent = `${t.dailyKm} km/j`; });
    document.querySelectorAll<HTMLElement>("[data-trip-out]").forEach((el) => { el.textContent = `${t.dailyKm} km`; });
    document.querySelectorAll<HTMLInputElement>("[data-trip-range]").forEach((el) => {
      if (document.activeElement !== el) el.value = String(t.dailyKm);
      fill(el);
    });
    document.querySelectorAll<HTMLInputElement>("[data-trip-home]").forEach((el) => { el.checked = t.homeCharging; });
    paintRails(t);
  }

  function setupTripControl() {
    const root = document.querySelector<HTMLElement>("[data-trip-control]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const toggle = root.querySelector<HTMLButtonElement>("[data-trip-toggle]")!;
    const pop = root.querySelector<HTMLElement>(".trip-pop")!;
    const open = (on: boolean) => {
      pop.hidden = !on;
      toggle.setAttribute("aria-expanded", String(on));
      if (on) pop.querySelector<HTMLInputElement>("[data-trip-range]")?.focus();
    };
    toggle.addEventListener("click", () => open(pop.hidden));
    document.addEventListener("click", (e) => { if (!pop.hidden && !root.contains(e.target as Node)) open(false); });
    root.addEventListener("keydown", (e) => { if (e.key === "Escape" && !pop.hidden) { open(false); toggle.focus(); } });
  }

  // Réglages partout sur la page (navigation, accueil, fiches) : délégation d'événements
  let tripListenersReady = false;
  function setupTripInputs() {
    if (tripListenersReady) return;
    tripListenersReady = true;
    document.addEventListener("input", (e) => {
      const el = e.target as HTMLElement;
      if (el instanceof HTMLInputElement && el.matches("[data-trip-range]")) writeTrip({ dailyKm: Number(el.value) });
    });
    document.addEventListener("change", (e) => {
      const el = e.target as HTMLElement;
      if (!(el instanceof HTMLInputElement)) return;
      if (el.matches("[data-trip-home]")) writeTrip({ homeCharging: el.checked });
      // Réglé depuis la page (accueil, fiche, catalogue) : la pastille confirme qu'elle a retenu le trajet
      if (el.matches("[data-trip-range], [data-trip-home]") && !el.closest("[data-trip-control]")) {
        pulse(document.querySelector("[data-trip-toggle]"));
      }
    });
    onTripChange(renderTrip);
  }

  // ── Recherche instantanée ──
  type Row = { s: string; b: string; m: string; u: number; p: number | null; r: number; w: number; h: number; c: number; i: string | null };
  let index: Row[] | null = null;
  let loading: Promise<Row[]> | null = null;
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
  const nf = new Intl.NumberFormat("fr-FR");
  const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
  const price = (p: number | null) => (p === null ? "Prix NC" : `dès ${nf.format(p).replace(/ /g, " ")} €`);

  function loadIndex(dialog: HTMLDialogElement): Promise<Row[]> {
    if (index) return Promise.resolve(index);
    loading ??= fetch(dialog.dataset.index!).then((r) => r.json()).then((rows: Row[]) => (index = rows));
    return loading;
  }

  function railHTML(v: Row) {
    const scale = 900;
    const promise = Math.max(v.w, v.r);
    return `<div class="rail" data-size="sm" data-winter="${v.h}" data-real="${v.r}" data-wltp="${promise}" style="--scale:${scale};--winter:${Math.min(v.h, v.r)};--real:${v.r};--wltp:${promise}"><div class="rail-bar" aria-hidden="true"><span class="rail-seg rail-winter"></span><span class="rail-seg rail-real"></span>${promise > v.r ? '<span class="rail-seg rail-promise"></span>' : ""}<span class="rail-need"></span></div></div>`;
  }

  function setupSearch() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = "true";
    const input = dialog.querySelector<HTMLInputElement>("[data-search-input]")!;
    const list = dialog.querySelector<HTMLUListElement>("[data-search-results]")!;
    const quick = dialog.querySelector<HTMLElement>("[data-search-quick]")!;
    const empty = dialog.querySelector<HTMLElement>("[data-search-empty]")!;
    const base = dialog.dataset.base!;
    let selected = 0;

    const items = () => [...list.querySelectorAll<HTMLAnchorElement>(".search-hit")];
    const select = (i: number) => {
      const all = items();
      if (!all.length) return;
      selected = (i + all.length) % all.length;
      all.forEach((el, k) => el.setAttribute("aria-selected", String(k === selected)));
      all[selected]!.scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      const q = norm(input.value);
      quick.hidden = q.length > 0;
      if (!q || !index) { list.replaceChildren(); empty.hidden = true; return; }
      const terms = q.split(" ");
      const trip = readTrip();
      const hits = index
        .filter((v) => { const hay = norm(`${v.b} ${v.m} ${v.u ? "utilitaire" : ""}`); return terms.every((t) => hay.includes(t)); })
        .slice(0, 8);
      empty.hidden = hits.length > 0;
      list.innerHTML = hits.map((v, k) => {
        const days = daysOf(v.h, trip);
        const fit = fitsTrip(v.h, trip);
        return `<li role="none"><a role="option" class="search-hit" href="${base}${v.s}/" aria-selected="${k === 0}">
          <span class="search-hit-img">${v.i ? `<img src="${v.i}" alt="" loading="lazy" />` : ""}</span>
          <span class="min-w-0"><span class="search-hit-name"><span class="search-hit-brand">${esc(v.b)}</span> ${esc(v.m)}</span>${railHTML(v)}</span>
          <span class="search-hit-meta"><b>${v.r} km</b>${price(v.p)}<span class="search-hit-days" data-fit="${fit ? 1 : 0}"> · ${days} j en hiver</span></span>
        </a></li>`;
      }).join("");
      paintRails(trip, list);
      selected = 0;
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.value = "";
      render();
      input.focus();
      loadIndex(dialog).then(render);
    };
    document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((b) => b.addEventListener("click", open));
    dialog.querySelector("[data-search-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); select(selected + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); select(selected - 1); }
      else if (e.key === "Enter") {
        const hit = items()[selected];
        if (hit) { e.preventDefault(); window.location.href = hit.href; }
      }
    });
    list.addEventListener("mousemove", (e) => {
      const hit = (e.target as HTMLElement).closest<HTMLAnchorElement>(".search-hit");
      const i = hit ? items().indexOf(hit) : -1;
      if (i >= 0 && i !== selected) select(i);
    });
  }

  // Raccourcis globaux : « / » ou Ctrl/Cmd + K
  let shortcutReady = false;
  function setupShortcut() {
    if (shortcutReady) return;
    shortcutReady = true;
    document.addEventListener("keydown", (e) => {
      const el = e.target as HTMLElement;
      const typing = el.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(el.tagName);
      if ((e.key === "/" && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) {
        e.preventDefault();
        document.querySelector<HTMLElement>("[data-search-open]")?.click();
      }
    });
  }

  function init() {
    setupNavDropdowns();
    setupMobileMenu();
    setupTripControl();
    setupTripInputs();
    setupSearch();
    setupShortcut();
    renderTrip(readTrip());
  }
  init();
  document.addEventListener("astro:page-load", () => {
    document.documentElement.style.overflow = "";
    init();
  });
</script>
