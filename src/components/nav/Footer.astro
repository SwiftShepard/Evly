---
import { url } from "@/lib/url";
import { getAllVehicles } from "@/lib/vehicles";
import { getCategory } from "@/data/categories";
import { LEGAL_PAGES } from "@/data/legal";
import { formatDate } from "@/lib/format";

const year = new Date().getFullYear();

// Sélections et marques les plus recherchées, liées depuis toutes les pages
const FOOTER_SELECTIONS = ["pas-cheres", "suv", "citadines", "familiales", "7-places", "grande-autonomie", "fabriquees-en-france", "eligibles-prime-cee"];
const FOOTER_BRANDS: [string, string][] = [
  ["Renault", "renault"],
  ["Peugeot", "peugeot"],
  ["Tesla", "tesla"],
  ["Volkswagen", "volkswagen"],
  ["Kia", "kia"],
  ["Hyundai", "hyundai"],
  ["BYD", "byd"],
  ["MG", "mg"],
];
const vehicles = getAllVehicles();
const totalVehicles = vehicles.length;
// Date de la fiche la plus récemment mise à jour : reflète l'état réel des données
const lastDataUpdate = vehicles.reduce((latest, v) => (v.lastUpdated > latest ? v.lastUpdated : latest), "");

const cols = [
  {
    title: "Véhicules",
    links: [
      { href: url("/vehicules/"), label: "Particuliers" },
      { href: url("/pro/vehicules/"), label: "Utilitaires (Pro)" },
      { href: url("/leasing-social/"), label: "Leasing Social" },
      { href: url("/bons-plans/"), label: "Bons plans" },
    ],
  },
  {
    title: "Outils",
    links: [
      { href: url("/comparer/"), label: "Comparateur" },
      { href: url("/simulateur/"), label: "Calculateur TCO" },
      { href: url("/pro/"), label: "Simulateur Pro" },
      { href: url("/recommandation/"), label: "Recommandation guidée" },
    ],
  },
  {
    title: "Sélections",
    links: [
      ...FOOTER_SELECTIONS.map((slug) => ({ href: url(`/voitures-electriques/${slug}/`), label: getCategory(slug)!.label })),
      { href: url("/voitures-electriques/"), label: "Toutes les sélections" },
    ],
  },
  {
    title: "Marques",
    links: [
      ...FOOTER_BRANDS.map(([name, slug]) => ({ href: url(`/marques/${slug}/`), label: `${name} électrique` })),
      { href: url("/marques/"), label: "Toutes les marques" },
    ],
  },
  {
    title: "Méthodologie",
    links: [
      { href: url("/methodologie/"), label: "Notre approche" },
      { href: url("/methodologie/") + "#protocoles", label: "Protocoles de test" },
      { href: url("/methodologie/") + "#sources", label: "Nos sources" },
      { href: url("/methodologie/") + "#limites", label: "Limites & honnêteté" },
      { href: url("/glossaire/"), label: "Glossaire" },
    ],
  },
];
---

<footer class="mt-24 md:mt-32">
  <div class="container-edit">
   <div class="footer-panel">
    <div class="grid grid-cols-2 md:grid-cols-5 lg:grid-cols-[minmax(0,4fr)_repeat(5,minmax(0,1.6fr))] gap-x-6 gap-y-10">
      <div class="col-span-2 md:col-span-5 lg:col-span-1 flex flex-col gap-5 lg:pr-10">
        <p class="font-display text-[26px] md:text-[30px] font-extrabold tracking-[-0.035em] leading-[1.02] text-[var(--color-text)] max-w-xs">
          L'électrique mesuré, sans publicité ni commission.
        </p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-sm">
          Autonomies et recharges mesurées par Bjørn Nyland, EVKX, ArenaEV et la presse VE française, croisées avec
          les fiches constructeur. Aucun lien affilié, aucun cookie : seule une mesure d'audience anonyme est utilisée.
        </p>
        <p class="text-sm text-[var(--color-text-faint)]">
          {totalVehicles} modèles suivis, données mises à jour le {formatDate(lastDataUpdate)}.
        </p>
      </div>

      {
        cols.map((col) => (
          <div class="col-span-1 flex flex-col gap-3">
            <p class="font-display text-[15px] font-bold tracking-[-0.01em] text-[var(--color-text)]">{col.title}</p>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="footer-mark" aria-hidden="true">ev<span>·</span>ly</p>
    <div class="pt-6 border-t border-[var(--color-border)] flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <span class="text-[13px] text-[var(--color-text-faint)]">© {year} Evly</span>
      <nav aria-label="Informations légales">
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {LEGAL_PAGES.map((p) => (
            <li>
              <a href={url(p.path)} class="footer-link inline-block py-1 text-[13px] text-[var(--color-text-faint)] hover:text-[var(--color-text)]">
                {p.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
   </div>
  </div>
</footer>

<style>
  .footer-panel {
    padding: 2.5rem 1.5rem 1.5rem;
    border-radius: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .footer-panel { padding: 3.5rem 3rem 2rem; }
  }
  /* Signature : le mot-symbole en très grand, coupé par le bas du panneau */
  .footer-mark {
    margin: 3rem 0 -0.12em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5.5rem, 22vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.065em;
    color: var(--color-accent);
    user-select: none;
  }
  .footer-mark span { color: var(--color-lime); }
</style>
