---
import Wordmark from "@/components/ui/Wordmark.astro";
import { url } from "@/lib/url";
import { getAllVehicles } from "@/lib/vehicles";
import { getCategory } from "@/data/categories";

const year = new Date().getFullYear();

// Sélections et marques les plus recherchées, liées depuis toutes les pages
const FOOTER_SELECTIONS = ["pas-cheres", "suv", "citadines", "familiales", "7-places", "grande-autonomie", "fabriquees-en-france", "eligibles-prime-cee"];
const FOOTER_BRANDS: [string, string][] = [
  ["Renault", "renault"],
  ["Peugeot", "peugeot"],
  ["Tesla", "tesla"],
  ["Volkswagen", "volkswagen"],
  ["Kia", "kia"],
  ["Hyundai", "hyundai"],
  ["BYD", "byd"],
  ["MG", "mg"],
];
const totalVehicles = getAllVehicles().length;
const version = "v1.2.0";

const cols = [
  {
    title: "Véhicules",
    links: [
      { href: url("/vehicules"), label: "Particuliers" },
      { href: url("/pro/vehicules"), label: "Utilitaires (Pro)" },
      { href: url("/leasing-social"), label: "Leasing Social" },
    ],
  },
  {
    title: "Outils",
    links: [
      { href: url("/comparer"), label: "Comparateur" },
      { href: url("/simulateur"), label: "Calculateur TCO" },
      { href: url("/pro"), label: "Simulateur Pro" },
      { href: url("/recommandation"), label: "Recommandation guidée" },
    ],
  },
  {
    title: "Sélections",
    links: [
      ...FOOTER_SELECTIONS.map((slug) => ({ href: url(`/voitures-electriques/${slug}/`), label: getCategory(slug)!.label })),
      { href: url("/voitures-electriques/"), label: "Toutes les sélections" },
    ],
  },
  {
    title: "Marques",
    links: [
      ...FOOTER_BRANDS.map(([name, slug]) => ({ href: url(`/marques/${slug}/`), label: `${name} électrique` })),
      { href: url("/marques/"), label: "Toutes les marques" },
    ],
  },
  {
    title: "Méthodologie",
    links: [
      { href: url("/methodologie"), label: "Notre approche" },
      { href: url("/methodologie") + "#protocoles", label: "Protocoles de test" },
      { href: url("/methodologie") + "#sources", label: "Nos sources" },
      { href: url("/methodologie") + "#limites", label: "Limites & honnêteté" },
      { href: url("/glossaire"), label: "Glossaire" },
    ],
  },
];
---

<footer class="border-t border-[var(--color-border)] mt-32 reveal">
  <div class="container-edit py-16">
    <div class="grid grid-cols-2 md:grid-cols-5 lg:grid-cols-8 gap-x-6 gap-y-10">
      <div class="col-span-2 md:col-span-5 lg:col-span-3 flex flex-col gap-6 lg:pr-6">
        <div class="flex items-baseline gap-3">
          <Wordmark size="lg" />
        </div>
        <p class="font-mono text-sm text-[var(--color-accent)] tracking-tight">
          L'électrique mesuré.
        </p>
        <p class="text-[var(--color-text-muted)] text-sm leading-relaxed max-w-md">
          Evly agrège les données d'autonomie réelle et de recharge mesurées par Bjørn Nyland, EVKX, ArenaEV,
          la presse VE française et les fiches constructeur officielles. Aucune publicité, aucun lien affilié, aucun tracking.
        </p>
        <div class="flex flex-col gap-1">
          <span class="label-eyebrow">État du projet</span>
          <span class="text-sm text-[var(--color-text-muted)] font-mono">
            {version} · {totalVehicles} modèles · mise à jour {year}
          </span>
        </div>
      </div>

      {
        cols.map((col) => (
          <div class="col-span-1 flex flex-col gap-4">
            <span class="label-eyebrow">{col.title}</span>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="footer-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 pt-8 border-t border-[var(--color-border)] flex flex-col md:flex-row md:items-center md:justify-between gap-4"
    >
      <span class="label-eyebrow">© {year} Evly. L'électrique mesuré.</span>
      <span class="font-mono text-xs text-[var(--color-text-faint)]">
        Astro · Tailwind · TypeScript · Cloudflare Pages
      </span>
    </div>
  </div>
</footer>
