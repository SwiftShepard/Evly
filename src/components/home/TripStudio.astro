---
/**
 * Studio du trajet (accueil) : le visiteur règle son trajet quotidien, voit combien de modèles
 * tiennent une semaine sans recharger et le lit sur la règle d'autonomie d'un modèle connu.
 * Une seule règle se transforme d'un modèle à l'autre (segments, étiquettes et chiffres glissent).
 * Valeurs initiales calculées au build pour le trajet par défaut ; mises à jour par lib/trip.
 * Les onglets sont synchronisés avec le carrousel du hero (HeroCars).
 */
import RangeRail from "@/components/ui/RangeRail.astro";
import { getVehicleBySlug } from "@/lib/vehicles";
import { getMeasuredGap, type MeasuredGap } from "@/lib/rangeGap";
import { getVehicleIndex } from "@/lib/vehicleIndex";
import { countFitting } from "@/lib/tripFit";
import { url } from "@/lib/url";
import { STUDIO_MODELS } from "./studioModels";
import { ArrowRight } from "lucide-react";

const DEFAULT_DAILY = 40;
const DAYS = 5;

const specs = STUDIO_MODELS.map(([slug, label]) => {
  const v = getVehicleBySlug(slug);
  const gap = v ? getMeasuredGap(v) : null;
  return gap ? { ...gap, label } : null;
}).filter((s): s is MeasuredGap & { label: string } => s !== null);

const SCALE = Math.ceil(Math.max(...specs.map((s) => s.wltpKm)) / 100) * 100 + 100;
const models = specs.map((s) => ({
  name: `${s.vehicle.brand} ${s.vehicle.model}`,
  version: s.config.label.replace(s.vehicle.model, "").replace(/^[\s·]+/, "").trim() || s.config.label,
  real: s.realKm,
  wltp: s.wltpKm,
  winter: s.config.realRange?.winter_minus5_km ?? s.vehicle.realRange.winter_minus5_km,
  href: url(`/vehicules/${s.vehicle.slug}/`),
}));
const first = models[0]!;
const index = await getVehicleIndex();
const initial = countFitting(index, DEFAULT_DAILY * DAYS);
const days = (km: number) => Math.floor(km / DEFAULT_DAILY);
---

<section class="trip-studio no-glossary" data-trip-studio data-index={url("/recherche.json")}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
    <div class="lg:col-span-5">
      <h2 class="display-2 max-w-[15ch]">Combien de kilomètres faites-vous par jour&nbsp;?</h2>

      <label for="trip-km-home" class="mt-8 flex items-baseline justify-between gap-4">
        <span class="text-[15px] text-[var(--color-text-muted)]">Trajet quotidien, aller et retour</span>
        <output for="trip-km-home" class="font-display text-[34px] font-extrabold tracking-[-0.035em] text-[var(--color-accent)] tabular-nums whitespace-nowrap" data-trip-out>{DEFAULT_DAILY} km</output>
      </label>
      <input id="trip-km-home" type="range" min="10" max="200" step="5" value={DEFAULT_DAILY} class="trip-range mt-3" data-trip-range />
      <div class="mt-2 flex justify-between font-mono text-[11px] text-[var(--color-text-faint)]"><span>10 km</span><span>200 km</span></div>
      <label class="trip-toggle mt-5">
        <input type="checkbox" data-trip-home checked />
        <span class="trip-toggle-ui" aria-hidden="true"></span>
        <span class="text-[15px]">Je peux recharger chez moi</span>
      </label>

      <div class="trip-result" aria-live="polite">
        <p class="font-display text-[clamp(3.5rem,7vw,5.5rem)] font-extrabold tracking-[-0.05em] leading-[0.85] tabular-nums" data-fit-count>{initial.fit}</p>
        <p class="mt-3 text-[16px] leading-snug max-w-[34ch]">
          modèles, sur <span data-fit-total>{initial.total}</span>, tiennent une semaine de ce trajet sans recharger, même par -5&nbsp;°C.
        </p>
        <a href={url("/vehicules/") + "?options=trajet"} class="btn btn-primary mt-6" data-fit-link>
          Voir ces modèles <ArrowRight size={17} strokeWidth={2} className="btn-arrow" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="lg:col-span-7 instrument-card" data-studio-models={JSON.stringify(models)}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="font-display text-[19px] font-bold tracking-[-0.02em]">Lu sur la règle</p>
        {/* Pastille active : copie de la rangée en état actif, découpée sur l'onglet choisi */}
        <div class="chip-track">
          <div class="chip-row" role="tablist" aria-label="Choisir un modèle">
            {specs.map((s, i) => (
              <button type="button" role="tab" id={`studio-tab-${i}`} aria-controls="studio-panel" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="model-chip" data-studio-tab={i}>
                {s.label}
              </button>
            ))}
          </div>
          <div class="chip-row chip-row-active" aria-hidden="true" data-chip-active>
            {specs.map((s) => <span class="model-chip">{s.label}</span>)}
          </div>
        </div>
      </div>

      <div id="studio-panel" class="mt-6" role="tabpanel" aria-labelledby="studio-tab-0" data-studio-panel>
        <RangeRail real={first.real} wltp={first.wltp} winter={first.winter} scale={SCALE} size="lg" annotate animate surface="var(--color-surface-elevated)" class="studio-rail" />
        <p class="mt-6 text-[17px] leading-relaxed max-w-[52ch]" data-studio-sentence>
          <span data-s-name>{first.name}</span> (<span data-s-version>{first.version}</span>) :
          <strong><span class="tabular-nums" data-days-winter>{days(first.winter)}</span> <span data-days-winter-u>{days(first.winter) > 1 ? "jours" : "jour"}</span></strong> de votre trajet en hiver,
          <strong><span class="tabular-nums" data-days-real>{days(first.real)}</span> <span data-days-real-u>{days(first.real) > 1 ? "jours" : "jour"}</span></strong> le reste de l'année.
        </p>
        <a href={first.href} class="mt-3 inline-flex items-center gap-1.5 text-[14.5px] font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-dim)]" data-s-link>
          Voir la fiche <ArrowRight size={15} strokeWidth={2.25} className="arrow-animate" aria-hidden="true" />
        </a>
      </div>

      <div class="rail-legend mt-7 pt-5 border-t border-[var(--color-border)]">
        <span><i class="rail-key rail-key-winter"></i>Même en hiver (-5&nbsp;°C)</span>
        <span><i class="rail-key rail-key-real"></i>Autonomie réelle, mesurée sur route</span>
        <span><i class="rail-key rail-key-promise"></i>Promis par le WLTP, jamais parcouru</span>
        <span><i class="rail-key rail-key-need"></i>Votre semaine de trajet</span>
      </div>
    </div>
  </div>
</section>

<style>
  .trip-studio {
    padding: 2rem 1.5rem;
    border-radius: 32px;
    background: var(--color-surface-accent);
  }
  @media (min-width: 1024px) {
    .trip-studio { padding: 3rem 3rem 3rem 3.5rem; }
  }
  .trip-result {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .instrument-card {
    padding: 1.5rem;
    border-radius: var(--radius-tile);
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-md);
  }
  @media (min-width: 768px) {
    .instrument-card { padding: 2rem 2.25rem; }
  }

  /* Onglets des modèles : la pastille olive glisse d'un modèle à l'autre (clip-path, recette « tab indicator ») */
  .chip-track { position: relative; }
  .chip-row { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .model-chip {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: border-color 200ms ease, color 200ms ease, transform 160ms var(--ease-out-expo);
  }
  .model-chip:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .model-chip:hover { border-color: var(--color-border-strong); color: var(--color-text); }
  }
  .chip-row-active {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: inset(0 100% 0 0 round 999px);
    transition: clip-path 280ms var(--ease-in-out);
  }
  .chip-row-active .model-chip {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-on);
  }
  .studio-rail :global(.rail-seg) { transition-duration: 450ms; }
</style>

<script>
  import { readTrip, onTripChange, weekNeed, paintRails, type Trip } from "@/lib/trip";
  import { countFitting, type IndexRow } from "@/lib/tripFit";
  import { tweenNumber } from "@/lib/tween";
  import { STUDIO_EVENT, type StudioModelDetail } from "./studioModels";

  type Model = { name: string; version: string; real: number; wltp: number; winter: number; href: string };
  let rows: IndexRow[] | null = null;

  function setupStudio() {
    const root = document.querySelector<HTMLElement>("[data-trip-studio]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const card = root.querySelector<HTMLElement>("[data-studio-models]")!;
    const models = JSON.parse(card.dataset.studioModels || "[]") as Model[];
    const panel = root.querySelector<HTMLElement>("[data-studio-panel]")!;
    const rail = panel.querySelector<HTMLElement>(".rail")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-studio-tab]")];
    const activeRow = root.querySelector<HTMLElement>("[data-chip-active]")!;
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    let current = 0;

    // Découpe la copie active sur l'onglet choisi (suit aussi le retour à la ligne des pastilles)
    const placeIndicator = (instant = false) => {
      const tab = tabs[current]!;
      const row = tab.parentElement!;
      const top = tab.offsetTop;
      const left = tab.offsetLeft;
      const right = row.offsetWidth - left - tab.offsetWidth;
      const bottom = row.offsetHeight - top - tab.offsetHeight;
      if (instant) activeRow.style.transition = "none";
      activeRow.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px round 999px)`;
      if (instant) { void activeRow.offsetWidth; activeRow.style.transition = ""; }
    };

    const daysText = (t: Trip) => {
      const m = models[current]!;
      const w = Math.floor(m.winter / t.dailyKm);
      const r = Math.floor(m.real / t.dailyKm);
      tweenNumber(q("[data-days-winter]"), w);
      tweenNumber(q("[data-days-real]"), r);
      q("[data-days-winter-u]").textContent = w > 1 ? "jours" : "jour";
      q("[data-days-real-u]").textContent = r > 1 ? "jours" : "jour";
    };

    // La même règle se transforme vers le modèle choisi : segments (clip-path), étiquettes (translate), chiffres
    const select = (i: number, focus = false) => {
      current = i;
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panel.setAttribute("aria-labelledby", tabs[i]!.id);
      placeIndicator();
      const m = models[i]!;
      const scale = Number(getComputedStyle(rail).getPropertyValue("--scale"));
      rail.removeAttribute("data-animate");
      rail.style.setProperty("--winter", String(Math.min(m.winter, m.real)));
      rail.style.setProperty("--real", String(m.real));
      rail.style.setProperty("--wltp", String(m.wltp));
      rail.dataset.winter = String(m.winter);
      rail.dataset.real = String(m.real);
      rail.dataset.wltp = String(m.wltp);
      rail.toggleAttribute("data-flip", m.wltp / scale > 0.78);
      tweenNumber(q("[data-rail-real]"), m.real, { duration: 420 });
      tweenNumber(q("[data-rail-wltp]"), m.wltp, { duration: 420 });
      const winterLabel = rail.querySelector<HTMLElement>("[data-rail-winter]");
      if (winterLabel) tweenNumber(winterLabel, m.winter, { duration: 420 });
      q("[data-s-name]").textContent = m.name;
      q("[data-s-version]").textContent = m.version;
      q<HTMLAnchorElement>("[data-s-link]").href = m.href;
      const t = readTrip();
      daysText(t);
      paintRails(t, panel);
      if (focus) tabs[i]!.focus();
    };

    // Choix à la main : le carrousel du hero suit
    const pick = (i: number, focus = false) => {
      select(i, focus);
      document.dispatchEvent(new CustomEvent<StudioModelDetail>(STUDIO_EVENT, { detail: { index: i, source: "studio" } }));
    };
    const onHero = (e: Event) => {
      const { index, source } = (e as CustomEvent<StudioModelDetail>).detail;
      if (source === "hero" && index !== current) select(index);
    };
    document.addEventListener(STUDIO_EVENT, onHero);
    document.addEventListener("astro:before-swap", () => document.removeEventListener(STUDIO_EVENT, onHero), { once: true });

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => pick(i));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const next = e.key === "ArrowRight" ? (i + 1) % n : e.key === "ArrowLeft" ? (i - 1 + n) % n : e.key === "Home" ? 0 : e.key === "End" ? n - 1 : -1;
        if (next < 0) return;
        e.preventDefault();
        pick(next, true);
      });
    });
    placeIndicator(true);
    new ResizeObserver(() => placeIndicator(true)).observe(tabs[0]!.parentElement!);

    const update = (t: Trip) => {
      daysText(t);
      if (!rows) return;
      const { fit, total } = countFitting(rows, weekNeed(t));
      tweenNumber(q("[data-fit-count]"), fit);
      q("[data-fit-total]").textContent = String(total);
    };

    update(readTrip());
    const stop = onTripChange(update);
    document.addEventListener("astro:before-swap", stop, { once: true });
    fetch(root.dataset.index!)
      .then((r) => r.json())
      .then((data: IndexRow[]) => { rows = data; update(readTrip()); })
      .catch(() => { /* compteur initial conservé */ });
  }
  setupStudio();
  document.addEventListener("astro:page-load", setupStudio);
</script>
