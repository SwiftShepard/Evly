---
/**
 * Fiche express de l'accueil : pour quelques modèles connus, l'autonomie mesurée
 * sur route face à l'annonce WLTP, le prix et le temps de recharge de la version testée.
 * Données réelles uniquement (configurations testées), onglets pilotés au clavier.
 */
import VehicleImage from "@/components/ui/VehicleImage.astro";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import { getVehicleBySlug } from "@/lib/vehicles";
import { getMeasuredGap, type MeasuredGap } from "@/lib/rangeGap";
import { formatPrice, formatNumber } from "@/lib/format";
import { url } from "@/lib/url";
import { ArrowRight } from "lucide-react";

const SLUGS = ["renault-5", "tesla-model-y", "kia-ev3", "citroen-e-c3"];

const specimens = SLUGS.map((slug) => getVehicleBySlug(slug))
  .filter((v) => v !== undefined)
  .map((v) => getMeasuredGap(v))
  .filter((g): g is MeasuredGap => g !== null);

// Échelle commune : la longueur des barres reste comparable d'un modèle à l'autre
const scaleMax = Math.ceil(Math.max(...specimens.map((s) => s.wltpKm)) / 100) * 100;

const SOURCE_LABEL: Record<string, string> = {
  bjorn_nyland: "Essai Bjørn Nyland",
  tested: "Essai presse",
};
---

<div class="specimen no-glossary" data-specimen>
  <div class="specimen-tabs" role="tablist" aria-label="Choisir un modèle">
    {specimens.map((s, i) => (
      <button
        type="button"
        role="tab"
        id={`specimen-tab-${s.vehicle.slug}`}
        aria-controls={`specimen-panel-${s.vehicle.slug}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="specimen-tab"
      >
        {s.vehicle.brand} {s.vehicle.model.replace(/ & .*$/, "")}
      </button>
    ))}
  </div>

  <div class="specimen-stack">
    {specimens.map((s, i) => {
      const v = s.vehicle;
      const realPct = (s.realKm / scaleMax) * 100;
      const wltpPct = (s.wltpKm / scaleMax) * 100;
      const missingKm = s.wltpKm - s.realKm;
      const charge = s.config.chargingDC_10_80_min ?? v.chargingDC.time_10_80_min;
      return (
        <div
          role="tabpanel"
          id={`specimen-panel-${v.slug}`}
          aria-labelledby={`specimen-tab-${v.slug}`}
          class="specimen-panel"
          data-active={i === 0 ? "" : undefined}
        >
          <div class="specimen-photo">
            <VehicleImage
              slug={v.slug}
              alt={`${v.brand} ${v.model}`}
              widths={[560, 1120]}
              sizes="(min-width: 1024px) 560px, 92vw"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              class="w-[86%] h-full"
            />
          </div>

          <div class="px-5 pb-5 md:px-7 md:pb-7">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2 min-w-0">
                <BrandLogo brand={v.brand} class="w-4 h-4 shrink-0 text-[var(--color-text-muted)]" />
                <p class="text-[15px] font-semibold tracking-[-0.015em] truncate">{v.brand} {v.model}</p>
              </div>
              <p class="text-[13px] text-[var(--color-text-faint)] truncate">{s.config.label}</p>
            </div>

            {/* Règle d'autonomie : mesurée (pleine) + kilomètres annoncés en trop (clair) */}
            <div class="mt-5">
              <div class="flex items-end justify-between gap-4">
                <p class="flex items-baseline gap-1.5 shrink-0">
                  <span class="text-[44px] md:text-[52px] font-semibold tracking-[-0.045em] leading-none">{formatNumber(s.realKm)}</span>
                  <span class="text-[15px] text-[var(--color-text-muted)] whitespace-nowrap">km mesurés</span>
                </p>
                <p class="text-right text-[13px] leading-snug text-[var(--color-text-faint)] pb-1">
                  {formatNumber(s.wltpKm)} km annoncés
                  <span class="block font-medium text-[var(--color-text)]">{formatNumber(Math.round(s.gapPct))} % de moins sur route</span>
                </p>
              </div>
              <div class="ruler mt-4" aria-hidden="true">
                <span class="ruler-real" style={`width: ${realPct}%`}></span>
                <span class="ruler-missing" style={`left: calc(${realPct}% + 2px); width: calc(${wltpPct - realPct}% - 2px)`}>
                </span>
              </div>
              <p class="sr-only">
                {v.brand} {v.model}, version {s.config.label} : {s.realKm} km mesurés sur route contre {s.wltpKm} km annoncés, soit {missingKm} km de moins.
              </p>
            </div>

            <dl class="mt-6 grid grid-cols-3 gap-4 pt-5 border-t border-[var(--color-border)]">
              <div>
                <dt class="text-[12.5px] text-[var(--color-text-faint)]">Prix de cette version</dt>
                <dd class="mt-1 text-[17px] font-semibold tracking-[-0.02em]">{s.config.price_EUR !== null ? formatPrice(s.config.price_EUR) : "Non communiqué"}</dd>
              </div>
              <div>
                <dt class="text-[12.5px] text-[var(--color-text-faint)]">Recharge 10 à 80 %</dt>
                <dd class="mt-1 text-[17px] font-semibold tracking-[-0.02em]">{charge} min</dd>
              </div>
              <div>
                <dt class="text-[12.5px] text-[var(--color-text-faint)]">Source</dt>
                <dd class="mt-1 text-[14px] font-medium leading-tight">{SOURCE_LABEL[s.config.realRange?.confidence ?? ""] ?? "Essai"}</dd>
              </div>
            </dl>

            <a href={url(`/vehicules/${v.slug}/`)} class="specimen-link group">
              Voir la fiche complète
              <ArrowRight size={16} strokeWidth={2} className="arrow-animate" aria-hidden="true" />
            </a>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .specimen {
    position: relative;
    border-radius: var(--radius-tile);
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .specimen-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--color-border);
  }
  .specimen-tabs::-webkit-scrollbar { display: none; }

  .specimen-tab {
    flex: 0 0 auto;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    transition: background-color 200ms var(--ease-out-expo), color 200ms var(--ease-out-expo), transform 160ms var(--ease-out-expo);
  }
  .specimen-tab:active { transform: scale(0.97); }
  @media (hover: hover) {
    .specimen-tab:hover { background: var(--color-bg-subtle); color: var(--color-text); }
  }
  .specimen-tab[aria-selected="true"] {
    background: var(--color-text);
    color: var(--color-bg-elevated);
  }

  /* Panneaux superposés dans la même cellule : pas de saut de mise en page au changement */
  .specimen-stack {
    display: grid;
  }
  .specimen-panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms var(--ease-out-expo), visibility 0s linear 320ms;
  }
  .specimen-panel[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 320ms var(--ease-out-expo);
  }

  .specimen-photo {
    height: clamp(170px, 20vw, 250px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-top: 1rem;
    margin-bottom: 1.25rem;
    background:
      radial-gradient(ellipse 46% 14% at 50% 92%, rgba(28, 36, 18, 0.16), transparent 70%),
      linear-gradient(to bottom, var(--color-bg-subtle), color-mix(in srgb, var(--color-bg-subtle) 40%, var(--color-surface-elevated)));
  }
  .specimen-panel[data-active] .specimen-photo :global(img) {
    animation: specimen-car 600ms var(--ease-out-expo) both;
  }

  .ruler {
    position: relative;
    height: 12px;
  }
  .ruler-real,
  .ruler-missing {
    position: absolute;
    top: 0;
    bottom: 0;
    transform-origin: left center;
  }
  .ruler-real {
    left: 0;
    background: var(--color-accent);
    border-radius: 2px;
  }
  .ruler-missing {
    background: var(--color-accent-soft);
    border-radius: 0 4px 4px 0;
  }
  .specimen-panel[data-active] .ruler-real {
    animation: ruler-grow 700ms var(--ease-out-expo) both;
  }
  .specimen-panel[data-active] .ruler-missing {
    animation: ruler-grow 500ms var(--ease-out-expo) 250ms both;
  }

  .specimen-link {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--color-accent);
  }
  @media (hover: hover) {
    .specimen-link:hover { color: var(--color-accent-dim); }
  }

  @keyframes ruler-grow {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @keyframes specimen-car {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  // Onglets accessibles : flèches gauche/droite, Début/Fin, activation au focus
  function setupSpecimens() {
    document.querySelectorAll<HTMLElement>("[data-specimen]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`);
          if (panel) panel.toggleAttribute("data-active", on);
        });
        if (focus) tab.focus();
        tab.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const next =
            e.key === "ArrowRight" ? tabs[(i + 1) % tabs.length] :
            e.key === "ArrowLeft" ? tabs[(i - 1 + tabs.length) % tabs.length] :
            e.key === "Home" ? tabs[0] :
            e.key === "End" ? tabs[tabs.length - 1] : undefined;
          if (!next) return;
          e.preventDefault();
          select(next, true);
        });
      });
    });
  }
  setupSpecimens();
  document.addEventListener("astro:page-load", setupSpecimens);
</script>
