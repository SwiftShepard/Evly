---
type Tone = "neutral" | "accent" | "danger" | "warning" | "outline";

interface Props {
  tone?: Tone;
  mono?: boolean;
  class?: string;
}

// `mono` est conservé pour compatibilité : les étiquettes sont désormais en casse normale, police du texte
const { tone = "neutral", class: className = "" } = Astro.props;

const toneClasses: Record<Tone, string> = {
  neutral:
    "bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)] border border-[var(--color-border)]",
  accent:
    "bg-[var(--color-surface-accent)] text-[var(--color-accent)] border border-[color-mix(in_srgb,var(--color-accent)_25%,transparent)]",
  danger:
    "bg-transparent text-[var(--color-danger)] border border-[color-mix(in_srgb,var(--color-danger)_45%,var(--color-border-strong))]",
  warning:
    "bg-transparent text-[var(--color-warning)] border border-[color-mix(in_srgb,var(--color-warning)_45%,var(--color-border-strong))]",
  outline:
    "bg-transparent text-[var(--color-text-muted)] border border-[var(--color-border-strong)]",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 px-2.5 py-[5px] text-[12px] font-medium tracking-[-0.005em] leading-none whitespace-nowrap rounded-full",
    toneClasses[tone],
    className,
  ]}
>
  <slot />
</span>
