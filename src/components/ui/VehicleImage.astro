---
/**
 * VehicleImage, affiche l'image du véhicule si disponible dans src/assets/vehicles/.
 * Nommage : {slug}.{jpeg|jpg|png|webp|avif}
 * L'image est servie en WebP redimensionné (srcset), jamais l'original.
 * Fallback : icône EV générique (outline voiture + câble de charge).
 */
import { getVehicleImage } from "@/lib/vehicleImageAsset";

export interface Props {
  slug: string;
  alt: string;
  class?: string;
  /** Largeurs générées (px) ; par défaut adaptées aux vignettes de cartes */
  widths?: number[];
  /** Largeur d'affichage pour le choix dans le srcset */
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  slug,
  alt,
  class: className = "",
  widths = [240, 480],
  sizes = "200px",
  loading = "lazy",
  fetchpriority,
} = Astro.props;

const image = await getVehicleImage(slug, widths);
---

{image ? (
  <img
    src={image.src}
    srcset={image.srcset || undefined}
    sizes={image.srcset ? sizes : undefined}
    width={image.width}
    height={image.height}
    alt={alt}
    class={`vehicle-photo ${className}`}
    style="object-fit: contain; object-position: center bottom;"
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
) : (
  <svg
    class={`${className} opacity-50`}
    viewBox="0 0 290 115"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Cable -->
    <path
      d="M24 34 C30 78 50 82 68 82"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="round"
    />
    <!-- Plug body -->
    <rect x="8" y="22" width="16" height="24" rx="3" fill="currentColor" />
    <!-- Lightning bolt -->
    <path d="M21 23 L17 32 H21 L12 45 L16 36 H12 Z" fill="white" stroke="none" />

    <!--
      Car body (facing right, rear=left):
      - rear pillar → roof → windscreen → hood → front corner → front bumper
      - return along bottom with concave fender arches at each wheel position
    -->
    <path
      d="
        M 68 82
        L 68 55
        C 72 26 90 8 112 4
        L 190 4
        C 214 4 236 22 248 44
        L 258 44
        C 264 44 268 54 268 64
        L 268 82
        C 254 82 240 66 214 66
        C 188 66 174 82 160 82
        L 144 82
        C 130 82 116 66 94 66
        C 72 66 68 82 68 82
        Z
      "
      stroke="currentColor"
      stroke-width="6"
      stroke-linejoin="round"
      stroke-linecap="round"
    />

    <!-- Rear wheel -->
    <circle cx="94"  cy="97" r="17" stroke="currentColor" stroke-width="6" />
    <!-- Front wheel -->
    <circle cx="214" cy="97" r="17" stroke="currentColor" stroke-width="6" />
  </svg>
)}
