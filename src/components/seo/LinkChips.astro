---
/**
 * Groupes de liens en pastilles (« Autres Renault électriques », « Voir aussi »).
 * Sert le maillage interne : chaque lien porte le nom exact de la page visée.
 */
interface ChipLink {
  label: string;
  href: string;
  /** Lien « tout voir », mis en avant */
  accent?: boolean;
}

interface Props {
  groups: { title: string; links: ChipLink[] }[];
  class?: string;
}

const { groups, class: className = "" } = Astro.props;
const visible = groups.filter((g) => g.links.length > 0);
---

{visible.length > 0 && (
  <div class:list={["chips", className]}>
    {visible.map((g) => (
      <div class="chips-group">
        <span class="label-eyebrow">{g.title}</span>
        <ul>
          {g.links.map((l) => (
            <li><a href={l.href} class:list={[l.accent && "chips-accent"]}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

<style>
  .chips {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .chips {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
  }
  .chips-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .chips-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chips-group a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    border: 0.5px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .chips-group a:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
  .chips-group a.chips-accent {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border-strong));
  }
</style>
