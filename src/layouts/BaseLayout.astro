---
import "@/styles/global.css";
import Navigation from "@/components/nav/Navigation.astro";
import Footer from "@/components/nav/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import { url } from "@/lib/url";
import { GLOSSARY } from "@/data/glossary";

interface Props {
  title: string;
  description: string;
  /** Carte de partage 1200 × 630 (chemin du site), cf. src/pages/og/ */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Date ISO de dernière mise à jour du contenu (fiches véhicules) */
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Page outil plein écran (carte « Ma semaine ») : sur ordinateur, ni défilement ni pied de page */
  app?: boolean;
}

const {
  title,
  description,
  ogImage = "/og/pages/accueil.jpg",
  ogImageAlt,
  ogType = "website",
  modifiedTime,
  jsonLd,
  noindex = false,
  app = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Le nom du site n'est ajouté que s'il tient dans la largeur affichée par Google (~65 caractères)
const fullTitle = /evly/i.test(title) || `${title} | Evly`.length > 65 ? title : `${title} | Evly`;
const ogImageUrl = new URL(url(ogImage), Astro.site).toString();

// Organization + WebSite : présents sur toutes les pages pour ancrer l'entité
// Evly dans le Knowledge Graph, indépendamment du jsonLd propre à chaque page.
const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${Astro.site}#organization`,
    name: "Evly",
    url: Astro.site?.toString(),
    logo: new URL("/favicon.svg", Astro.site).toString(),
    description:
      "Comparateur indépendant de voitures électriques : autonomies réelles mesurées, coût total de possession et verdicts sans publicité ni commission.",
    slogan: "L'électrique mesuré",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${Astro.site}#website`,
    name: "Evly",
    alternateName: ["ev·ly", "ev-ly.com"],
    url: Astro.site?.toString(),
    inLanguage: "fr-FR",
    publisher: { "@id": `${Astro.site}#organization` },
  },
];

const combinedJsonLd = jsonLd
  ? [...siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : siteJsonLd;
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#eef1e7" />
    <!-- Apparitions au défilement : contenu visible par défaut. La page ne cache un bloc avant son
         animation que si le navigateur sait l'animer et que le visiteur n'a pas demandé moins de
         mouvement ; l'observateur tourne ici, sans attendre les scripts de la page (K9). -->
    <script is:inline>
      (function () {
        if (window.__evlyReveal) return;
        window.__evlyReveal = true;
        var root = document.documentElement;
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var sel = ".reveal, .reveal-fade, .reveal-scale, .reveal-slide-left";
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add("revealed");
            io.unobserve(e.target);
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -40px 0px" });
        var ran = false;
        function run() {
          ran = true;
          root.classList.add("reveal-on");
          document.querySelectorAll(sel).forEach(function (el) {
            if (!el.classList.contains("revealed")) io.observe(el);
          });
        }
        root.classList.add("reveal-on");
        // Filet : si l'observateur n'a pas démarré, tout reste visible plutôt que vide
        setTimeout(function () { if (!ran) root.classList.remove("reveal-on"); }, 2500);
        // Dès la fin de l'analyse du HTML, avant les scripts de la page (que DOMContentLoaded attendrait)
        if (document.readyState === "loading") {
          document.addEventListener("readystatechange", function once() {
            if (document.readyState === "loading") return;
            document.removeEventListener("readystatechange", once);
            run();
          });
        } else run();
        // Navigation par transition : la nouvelle page remplace les attributs de <html>
        document.addEventListener("astro:after-swap", function () { root.classList.add("reveal-on"); });
        document.addEventListener("astro:page-load", run);
      })();
    </script>

    <ViewTransitions />

    <!-- Mesure d'audience Plausible : sans cookie, refusable sur /cookies/ (clé plausible_ignore) -->
    <script async src="https://plausible.io/js/pa-hRCCTbmL-wrKQizAOMhSW.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({
        transformRequest: function (payload) {
          // Signal Global Privacy Control : aucun envoi
          if (navigator.globalPrivacyControl === true) return null;
          // Minimisation : l'URL part sans ancre ni paramètres (réglages de simulateurs, filtres), hors utm_*
          try {
            var u = new URL(payload.u);
            var kept = new URLSearchParams();
            u.searchParams.forEach(function (v, k) { if (/^utm_/.test(k)) kept.append(k, v); });
            u.search = kept.toString();
            u.hash = "";
            payload.u = u.toString();
          } catch (e) {}
          return payload;
        }
      })
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="alternate" type="text/plain" href={url("/llms.txt")} title="Résumé du site pour les assistants IA" />

    <!-- Sans JavaScript, l'apparition du haut de page (fade-rise) reste visible -->
    <noscript>
      <style>
        .fade-rise { opacity: 1 !important; transform: none !important; animation: none !important; }
      </style>
    </noscript>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Evly" />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(combinedJsonLd)}
    />
  </head>
  <body class="min-h-dvh flex flex-col" data-app={app ? "" : undefined}>
    {/* Reading progress bar */}
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-accent)] focus:text-[var(--color-accent-on)] focus:px-4 focus:py-2"
    >
      Aller au contenu
    </a>
    <Navigation />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      import { GLOSSARY } from "@/data/glossary";

      // Reduced motion check
      const isReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Apparitions au défilement : script en ligne dans <head> (contenu visible par défaut, K9)

      // Barre de progression et ombre de la navigation : pilotées en CSS par le défilement (global.css)

      // ------ Stat counter animation ------
      function setupCounters() {
        const stats = document.querySelectorAll('[data-count]');
        if (!stats.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const target = parseInt(el.getAttribute('data-count') || "", 10);
              if (isNaN(target)) return;

              const duration = 800;
              const start = performance.now();
              const startVal = 0;

              function update(now: number) {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                // Ease out expo
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = String(Math.round(startVal + (target - startVal) * eased));
                if (progress < 1) requestAnimationFrame(update);
              }
              requestAnimationFrame(update);
              observer.unobserve(el);
            }
          });
        }, { threshold: 0.3 });

        stats.forEach((el) => observer.observe(el));
      }

      // ------ Glossary Highlights ------
      const IGNORED_TAGS = new Set([
        'SCRIPT', 'STYLE', 'A', 'BUTTON', 'TEXTAREA', 'INPUT', 'SELECT', 'OPTION', 
        'CODE', 'PRE', 'NOSCRIPT', 'HEAD', 'TITLE', 'IFRAME', 'SVG', 
        'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'NAV', 'HEADER', 'FOOTER'
      ]);

      function escapeRegExp(string: string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function makeAccentInsensitivePattern(str: string) {
        return str
          .replace(/[eéeèêë]/gi, '[eéeèêë]')
          .replace(/[aàâä]/gi, '[aàâä]')
          .replace(/[iîï]/gi, '[iîï]')
          .replace(/[oôö]/gi, '[oôö]')
          .replace(/[uûüù]/gi, '[uûüù]')
          .replace(/[cç]/gi, '[cç]');
      }

      // Compile regexes
      const terms = [...GLOSSARY].sort((a, b) => {
        const lenA = Math.max(a.term.length, (a.abbr || "").length);
        const lenB = Math.max(b.term.length, (b.abbr || "").length);
        return lenB - lenA;
      });

      const regexPatterns = terms.map(entry => {
        const matchPatterns = [escapeRegExp(entry.term)];
        if (entry.abbr) {
          if (entry.abbr.includes('/')) {
            entry.abbr.split('/').forEach(a => matchPatterns.push(escapeRegExp(a.trim())));
          } else {
            matchPatterns.push(escapeRegExp(entry.abbr));
          }
        }

        const combinedPattern = matchPatterns
          .map(p => `\\b${makeAccentInsensitivePattern(p)}\\b`)
          .join('|');

        return {
          entry,
          regex: new RegExp(combinedPattern, 'i')
        };
      });

      function processTextNode(node: Text, highlightCounts: Map<string, number>) {
        if (!node.parentNode) return;
        const text = node.nodeValue || "";
        
        for (const { entry, regex } of regexPatterns) {
          const count = highlightCounts.get(entry.term) || 0;
          if (count >= 2) continue; // limit to 2 highlights per term per page

          const match = regex.exec(text);
          if (match) {
            const index = match.index;
            const matchedText = match[0];
            const before = text.slice(0, index);
            const after = text.slice(index + matchedText.length);

            const parent = node.parentNode;
            highlightCounts.set(entry.term, count + 1);

            const beforeNode = document.createTextNode(before);
            
            const highlightSpan = document.createElement('span');
            highlightSpan.className = 'glossary-highlight';
            highlightSpan.textContent = matchedText;
            highlightSpan.dataset.term = entry.term;
            highlightSpan.dataset.definition = entry.definition;
            
            const slug = entry.term.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
            highlightSpan.dataset.slug = slug;

            const afterNode = document.createTextNode(after);

            parent.insertBefore(beforeNode, node);
            parent.insertBefore(highlightSpan, node);
            parent.insertBefore(afterNode, node);
            parent.removeChild(node);

            processTextNode(afterNode, highlightCounts);
            return;
          }
        }
      }

      function setupHighlights() {
        const contentArea = document.getElementById('contenu');
        if (!contentArea) return;
        const highlightCounts = new Map<string, number>();
        const walker = document.createTreeWalker(
          contentArea,
          NodeFilter.SHOW_TEXT,
          {
            acceptNode(node) {
              let parent = node.parentNode as HTMLElement | null;
              while (parent && parent !== contentArea) {
                if (
                  IGNORED_TAGS.has(parent.tagName) || 
                  parent.classList?.contains('glossary-highlight') ||
                  parent.classList?.contains('no-glossary')
                ) {
                  return NodeFilter.FILTER_REJECT;
                }
                parent = parent.parentNode as HTMLElement | null;
              }
              return NodeFilter.FILTER_ACCEPT;
            }
          }
        );

        const nodes: Text[] = [];
        let currentNode: Text | null;
        while (currentNode = walker.nextNode() as Text | null) {
          nodes.push(currentNode);
        }

        for (const node of nodes) {
          processTextNode(node, highlightCounts);
        }
      }

      // Tooltip logic
      let tooltipEl: HTMLElement | null = null;
      let activeHighlight: HTMLElement | null = null;
      let hideTimeout: number | undefined;

      function createTooltip() {
        if (tooltipEl && document.getElementById('glossary-tooltip')) return tooltipEl;

        // Remove old tooltip if detached
        const oldTooltip = document.getElementById('glossary-tooltip');
        if (oldTooltip) oldTooltip.remove();

        tooltipEl = document.createElement('div');
        tooltipEl.id = 'glossary-tooltip';
        tooltipEl.innerHTML = `
          <div id="glossary-tooltip-term" style="font-weight: 600; color: var(--color-accent); font-size: 13px; margin-bottom: 4px; font-family: var(--font-sans);"></div>
          <div id="glossary-tooltip-definition" style="color: var(--color-text-muted); font-size: 11.5px; line-height: 1.4; font-family: var(--font-sans);"></div>
          <div style="margin-top: 10px; padding-top: 8px; border-top: 0.5px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; font-family: var(--font-sans);">
            <span style="font-family: var(--font-mono); font-size: 9px; color: var(--color-text-faint); text-transform: uppercase; letter-spacing: 0.08em;">Lexique Evly</span>
            <a id="glossary-tooltip-link" href="/glossaire" style="font-size: 10px; font-weight: 600; color: var(--color-accent); text-decoration: none; display: flex; align-items: center; gap: 4px; transition: color 0.2s;">
              Comprendre les termes
              <span style="transition: transform 0.2s ease; display: inline-block;">→</span>
            </a>
          </div>
        `;

        document.body.appendChild(tooltipEl);

        tooltipEl.addEventListener('mouseenter', () => {
          if (hideTimeout) clearTimeout(hideTimeout);
        });

        tooltipEl.addEventListener('mouseleave', () => {
          hideTooltip();
        });

        const link = tooltipEl.querySelector('#glossary-tooltip-link') as HTMLAnchorElement;
        const arrow = link.querySelector('span') as HTMLSpanElement;
        link.addEventListener('mouseenter', () => {
          arrow.style.transform = 'translateX(2px)';
        });
        link.addEventListener('mouseleave', () => {
          arrow.style.transform = 'translateX(0)';
        });

        return tooltipEl;
      }

      function showTooltip(target: HTMLElement, term: string, definition: string, slug?: string) {
        if (hideTimeout) clearTimeout(hideTimeout);

        const tooltip = createTooltip();
        const termEl = tooltip.querySelector('#glossary-tooltip-term');
        const defEl = tooltip.querySelector('#glossary-tooltip-definition');
        const linkEl = tooltip.querySelector('#glossary-tooltip-link') as HTMLAnchorElement;

        if (termEl) termEl.textContent = term;
        if (defEl) defEl.textContent = definition;
        if (linkEl) linkEl.href = slug ? `/glossaire#${slug}` : '/glossaire';

        tooltip.style.display = 'block';

        const rect = target.getBoundingClientRect();
        const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        const tooltipWidth = tooltip.offsetWidth;
        const tooltipHeight = tooltip.offsetHeight;

        let left = rect.left + rect.width / 2 - tooltipWidth / 2 + scrollLeft;
        let top = rect.top - tooltipHeight - 8 + scrollTop;

        if (left < 10) left = 10;
        if (left + tooltipWidth > window.innerWidth - 10) {
          left = window.innerWidth - tooltipWidth - 10;
        }
        
        if (rect.top - tooltipHeight - 8 < 10) {
          top = rect.bottom + 8 + scrollTop;
          tooltip.style.transform = 'translateY(-4px)';
        } else {
          tooltip.style.transform = 'translateY(4px)';
        }

        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';

        requestAnimationFrame(() => {
          tooltip.classList.add('visible');
          if (rect.top - tooltipHeight - 8 >= 10) {
            tooltip.style.transform = 'translateY(0)';
          }
        });
      }

      function hideTooltip() {
        if (hideTimeout) clearTimeout(hideTimeout);
        hideTimeout = setTimeout(() => {
          if (tooltipEl) {
            tooltipEl.classList.remove('visible');
            setTimeout(() => {
              if (tooltipEl && !tooltipEl.classList.contains('visible')) {
                tooltipEl.style.display = 'none';
              }
            }, 200);
          }
        }, 200) as unknown as number;
      }

      // Defer execution using requestIdleCallback to optimize TBT and Speed Index
      const runOnIdle = (cb: () => void) => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(cb);
        } else {
          setTimeout(cb, 50);
        }
      };

      function initGlossary() {
        if (window.location.pathname.endsWith('/glossaire') || window.location.pathname.endsWith('/glossaire/')) {
          const oldTooltip = document.getElementById('glossary-tooltip');
          if (oldTooltip) oldTooltip.style.display = 'none';
          return;
        }

        runOnIdle(() => {
          setupHighlights();
        });
      }

      // ------ Feuilles de style périmées après un déploiement ------
      // Un onglet ouvert (ou une page préchargée) avant une mise en ligne peut référencer
      // des fichiers CSS qui n'existent plus : la page s'afficherait sans sa mise en forme.
      // On recharge alors une fois pour obtenir le HTML à jour.
      // Feuille absente ou vide (en échec, Chrome attache une feuille sans règle) ; nos fichiers CSS ne sont jamais vides
      const isUnstyled = (l: HTMLLinkElement) => {
        try {
          return !l.sheet || l.sheet.cssRules.length === 0;
        } catch {
          return false;
        }
      };
      const unstyledLinks = () =>
        [...document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"][href*="/_astro/"]')].filter(isUnstyled);
      // Chargement complet : au moment de « load », toutes les feuilles ont fini de charger
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (nav?.type !== 'reload') {
        const checkInitial = () => { if (unstyledLinks().length) location.reload(); };
        if (document.readyState === 'complete') checkInitial();
        else window.addEventListener('load', checkInitial, { once: true });
      }
      // Navigation par transition : la feuille peut s'appliquer un instant après l'échange
      document.addEventListener('astro:after-swap', () => {
        const pending = unstyledLinks();
        if (!pending.length) return;
        let reloading = false;
        const reload = () => { if (!reloading) { reloading = true; location.reload(); } };
        pending.forEach((l) => l.addEventListener('error', reload, { once: true }));
        setTimeout(() => { if (pending.some((l) => l.isConnected && isUnstyled(l))) reload(); }, 1500);
      });

      // Init all
      function runAll() {
        if (!isReducedMotion()) {
          setupCounters();
        }
        initGlossary();
      }

      // Run on initial load
      runAll();

      // Re-init after Astro View Transitions navigate
      document.addEventListener('astro:page-load', () => {
        tooltipEl = null; // reset tooltip reference for new page body
        runAll();
      });

      // Global event delegation for tooltips
      document.body.addEventListener('mouseover', (e) => {
        const target = e.target as HTMLElement | null;
        const highlight = target?.closest('.glossary-highlight') as HTMLElement | null;
        if (highlight) {
          if (activeHighlight === highlight) return;
          activeHighlight = highlight;
          showTooltip(
            highlight,
            highlight.dataset.term || "",
            highlight.dataset.definition || "",
            highlight.dataset.slug
          );
        }
      });

      // Échap masque la définition affichée au survol (WCAG 1.4.13)
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && tooltipEl?.classList.contains('visible')) {
          activeHighlight = null;
          hideTooltip();
        }
      });

      document.body.addEventListener('mouseout', (e) => {
        const target = e.target as HTMLElement | null;
        const highlight = target?.closest('.glossary-highlight') as HTMLElement | null;
        if (highlight) {
          const relatedTarget = e.relatedTarget as HTMLElement | null;
          if (relatedTarget && (relatedTarget.closest('#glossary-tooltip') || relatedTarget.closest('.glossary-highlight') === highlight)) {
            return;
          }
          activeHighlight = null;
          hideTooltip();
        }
      });
    </script>
  </body>
</html>
