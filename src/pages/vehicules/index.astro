---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BentoGrid from "@/components/ui/BentoGrid.astro";
import Tile from "@/components/ui/Tile.astro";
import Tag from "@/components/ui/Tag.astro";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import VehicleImage from "@/components/ui/VehicleImage.astro";
import { getAllVehicles } from "@/lib/vehicles";
import { formatPrice } from "@/lib/format";
import { getVehicleCardSummary } from "@/lib/vehicleCard";
import { url } from "@/lib/url";
import FavoriteButton from "@/components/ui/FavoriteButton";
import type { Vehicle } from "@/data/schemas";

// Véhicules utilitaires stricts (fourgons et versions cargo uniquement) exclus du showroom particuliers
const STRICT_UTILITY_SLUGS = new Set([
  "citroen-e-jumper",
  "citroen-e-jumpy",
  "citroen-e-spacetourer",
  "fiat-e-ducato",
  "fiat-e-scudo",
  "ford-e-transit",
  "kia-pv5-cargo",
  "maxus-edeliver-3",
  "maxus-edeliver-5",
  "maxus-edeliver-7",
  "maxus-edeliver-9",
  "opel-movano-e",
  "opel-vivaro-e-life",
  "peugeot-e-boxer",
  "peugeot-e-expert-combi",
  "peugeot-e-partner",
  "peugeot-e-traveller",
  "renault-master-e-tech",
  "renault-trafic-e-tech",
  "toyota-proace-max-electric",
]);

// Les 10 véhicules mixtes (ludospaces, navettes VIP) présents dans les deux showrooms
const HYBRID_SLUGS = new Set([
  "citroen-e-berlingo",
  "hyundai-staria",
  "kia-pv5-passenger",
  "mercedes-eqv",
  "opel-combo-e-life",
  "peugeot-e-rifter",
  "renault-grand-kangoo",
  "renault-kangoo",
  "toyota-proace-city",
  "toyota-proace-electric",
]);

const vehicles = getAllVehicles().filter((v) => !STRICT_UTILITY_SLUGS.has(v.slug));

// Cartes rendues visibles au chargement ; le reste via « Voir plus »
const PAGE_SIZE = 24;

function getCategory(v: Vehicle) {
  const body = v.bodyType.toLowerCase();
  const segment = v.segment.toLowerCase();

  if (
    body.includes("monospace") ||
    body.includes("ludospace") ||
    body.includes("van") ||
    v.variant.toLowerCase().includes("monospace") ||
    HYBRID_SLUGS.has(v.slug)
  ) {
    return "Monospace";
  }
  if (body.includes("quadricycle") || v.segment.includes("quadricycle")) return "Quadricycle";
  if (segment.includes("a") || (segment.includes("b") && (body.includes("suv") || body.includes("crossover"))) || body.includes("urbain")) return "Mini-SUV";
  if (body.includes("suv") || body.includes("crossover")) return "SUV";
  if (segment.includes("b") || body.includes("citadine")) return "Citadine";
  if (segment.includes("c") || body.includes("compacte")) return "Berline compacte";
  if (body.includes("berline") || body.includes("hatchback") || segment.includes("d")) return "Berline";

  return "SUV";
}

function isLeasing(v: Vehicle) {
  return v.leasingSocialEligible;
}

function isFamiliale(v: Vehicle) {
  const s = v.segment.toLowerCase();
  return s.includes("d") || s.includes("e") || v.bodyType.toLowerCase().includes("familial") || v.bodyType.toLowerCase().includes("monospace") || v.trunkCapacity_L > 450;
}

function isDaily(v: Vehicle) {
  const s = v.segment.toLowerCase();
  return s.includes("a") || s.includes("b") || s.includes("c");
}

const categories = ["Mini-SUV", "SUV", "Berline compacte", "Berline", "Citadine", "Monospace", "Quadricycle"];
const brands = [...new Set(vehicles.map((v) => v.brand))].sort((a, b) =>
  a.localeCompare(b, "fr", { sensitivity: "base" }),
);

const BRAND_ORIGINS: { label: string; set: Set<string> }[] = [
  { label: "Français", set: new Set(["Alpine", "Citroën", "Peugeot", "Renault"]) },
  { label: "Roumain", set: new Set(["Dacia"]) },
  { label: "Allemand", set: new Set(["Audi", "BMW", "Mercedes", "Opel", "Porsche", "Smart", "Volkswagen"]) },
  { label: "Italien", set: new Set(["Alfa Romeo", "Fiat", "Lancia"]) },
  { label: "Coréen", set: new Set(["Hyundai", "Kia"]) },
  { label: "Japonais", set: new Set(["Mazda", "Nissan", "Toyota"]) },
  { label: "Américain", set: new Set(["Cadillac", "Ford", "Jeep", "Tesla"]) },
  { label: "Scandinave", set: new Set(["Polestar", "Volvo"]) },
  { label: "Britannique", set: new Set(["Mini"]) },
  { label: "Chinois", set: new Set(["BYD", "Geely", "Leapmotor", "Maxus", "MG", "Nio", "Xiaomi", "Xpeng", "Zeekr"]) },
];
const assignedBrands = new Set(BRAND_ORIGINS.flatMap((g) => [...g.set]));
const brandGroups = [
  ...BRAND_ORIGINS.map((g) => ({ label: g.label, items: brands.filter((b) => g.set.has(b)) })),
  { label: "Autres", items: brands.filter((b) => !assignedBrands.has(b)) },
].filter((g) => g.items.length > 0);

const budgetFilters = [
  { label: "< 25 k€", value: "25000" },
  { label: "< 35 k€", value: "35000" },
  { label: "< 50 k€", value: "50000" },
  { label: "< 70 k€", value: "70000" },
  { label: "< 100 k€", value: "100000" },
];
const specificFilters = [
  { label: "Favoris", value: "favorites" },
  { label: "Leasing social", value: "leasing" },
  { label: "Coup de pouce CEE", value: "cee" },
  { label: "Recharge rapide", value: "fast-charge" },
  { label: "Made in Europe", value: "eu" },
  { label: "Familiale", value: "familiale" },
];

const europeanCountries = ["France", "Allemagne", "Slovaquie", "Rép. Tchèque", "Pologne", "Espagne", "Italie", "Belgique", "Suède", "Slovénie", "Hongrie", "Autriche", "Portugal"];
function isEU(v: Vehicle) { return europeanCountries.includes(v.productionCountry); }
function hasCEE(v: Vehicle) { return v.availableAids?.some(a => /coup\s*de\s*pouce|prime\s*cee|cee|surbonus|aide/i.test(a.label)) ?? false; }
---

<BaseLayout
  title="Catalogue Voitures Électriques : Autonomies & Vrais Prix | Evly"
  description={`⚡ Trouvez la meilleure voiture électrique ! Filtrez ${vehicles.length} modèles par budget réel, autonomie mesurée sur autoroute, vitesse de charge et éligibilité aux aides d'État.`}
>
  <div class="py-6 md:py-10">
    <div class="container-edit">
      <div class="relative w-full flex flex-col xl:flex-row gap-8">
        
        {/* Barre latérale (Filtres) (Desktop) */}
        <aside class="hidden xl:block w-[275px] shrink-0 z-10">
          <div class="sticky top-24 flex flex-col gap-0 fade-rise sidebar-sticky">
            {/* Recherche textuelle (Desktop) */}
            <div class="pb-4 mb-4 border-b border-[var(--color-border)]">
              <label class="relative flex items-center w-full">
                <span class="absolute left-3 text-[var(--color-text-faint)] flex items-center pointer-events-none">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </span>
                <input
                  type="text"
                  id="catalog-search"
                  placeholder="Rechercher un modèle..."
                  aria-label="Rechercher un véhicule électrique"
                  class="w-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-full py-2 pl-9 pr-3 text-sm text-[var(--color-text)] placeholder-[var(--color-text-faint)] focus:outline-none focus:border-[var(--color-accent)] focus:bg-[var(--color-bg)] transition-all duration-200"
                />
              </label>
            </div>

            <details class="filter-section">
              <summary class="filter-section-toggle">Autonomie <span class="filter-chevron" /></summary>
              <div class="filter-section-body flex flex-col gap-4 mt-2">
                <div class="range-toggle-group self-start flex-wrap">
                  <button type="button" id="range-type-mixed" class="range-toggle-btn" data-active="true">Mixte</button>
                  <button type="button" id="range-type-highway" class="range-toggle-btn" data-active="false">Autoroute (130)</button>
                  <button type="button" id="range-type-wltp" class="range-toggle-btn" data-active="false">WLTP</button>
                </div>
                <div class="flex flex-col gap-1.5 w-full">
                  <div class="flex justify-between items-baseline">
                    <span class="text-[10px] text-[var(--color-text-muted)]">Minimum</span>
                    <span class="font-mono text-xs font-semibold text-[var(--color-accent)]"><span id="range-value-display">0</span> km</span>
                  </div>
                  <input
                    type="range"
                    id="range-slider"
                    min="0"
                    max="700"
                    step="20"
                    value="0"
                    class="w-full cursor-pointer"
                  />
                </div>
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Recharge (10 → 80 %) <span class="filter-chevron" /></summary>
              <div class="filter-section-body flex flex-col gap-3 mt-2">
                <div class="flex flex-col gap-1.5">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-faint)]">Profil de trajet</span>
                  <div class="range-toggle-group self-start flex-wrap">
                    <button type="button" id="charge-profile-highway" class="range-toggle-btn" data-active="true">Autoroute</button>
                    <button type="button" id="charge-profile-mixed" class="range-toggle-btn" data-active="false">Mixte</button>
                    <button type="button" id="charge-profile-urban" class="range-toggle-btn" data-active="false">Ville</button>
                  </div>
                </div>
                <div class="flex flex-col gap-1.5 w-full">
                  <div class="flex justify-between items-baseline">
                    <span class="text-[10px] text-[var(--color-text-muted)]">Km récupérés (10-80%) min.</span>
                    <span class="font-mono text-xs font-semibold text-[var(--color-accent)]">+<span id="charge-value-display">0</span> km</span>
                  </div>
                  <input
                    type="range"
                    id="charge-slider"
                    min="0"
                    max="450"
                    step="10"
                    value="0"
                    class="w-full cursor-pointer"
                  />
                  <span class="font-mono text-[9px] text-[var(--color-text-faint)] leading-tight">
                    (durée de la pause 10-80% spécifique à chaque modèle, ex: 18 à 30 min)
                  </span>
                </div>
                <label class="flex items-center gap-2 cursor-pointer text-[11px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors pt-2 border-t border-[var(--color-border)] mt-1">
                  <input type="checkbox" id="toggle-charge-filter" class="w-3.5 h-3.5 accent-[var(--color-accent)] cursor-pointer" />
                  <span>Afficher la recharge sur les cartes</span>
                </label>
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Coffre <span class="filter-chevron" /></summary>
              <div class="filter-section-body flex flex-col gap-4 mt-2">
                <div class="flex flex-col gap-1.5 w-full">
                  <div class="flex justify-between items-baseline">
                    <span class="text-[10px] text-[var(--color-text-muted)]">Minimum</span>
                    <span class="font-mono text-xs font-semibold text-[var(--color-accent)]"><span id="trunk-value-display">0</span> L</span>
                  </div>
                  <input
                    type="range"
                    id="trunk-slider"
                    min="0"
                    max="800"
                    step="50"
                    value="0"
                    class="w-full cursor-pointer"
                  />
                </div>
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Marques <span class="filter-chevron" /></summary>
              <div class="filter-section-body">
                {brandGroups.map((group) => (
                  <div>
                    <p class="filter-subgroup-label">{group.label}</p>
                    <div class="flex flex-wrap gap-1.5">
                      {group.items.map((b) => (
                        <button class="filter-chip" data-filter="brand" data-value={b} aria-pressed="false">
                          <BrandLogo brand={b} class="h-[15px] w-auto max-w-[40px] flex-shrink-0" />
                          <span>{b}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Carrosserie <span class="filter-chevron" /></summary>
              <div class="filter-section-body">
                <div class="flex flex-wrap gap-1.5">
                  {categories.map((c) => (
                    <button class="filter-chip" data-filter="cat" data-value={c} aria-pressed="false">{c}</button>
                  ))}
                </div>
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Budget max <span class="filter-chevron" /></summary>
              <div class="filter-section-body">
                <div class="flex flex-wrap gap-1.5">
                  {budgetFilters.map(({ label, value }) => (
                    <button class="filter-chip" data-filter="budget" data-value={value} aria-pressed="false">{label}</button>
                  ))}
                </div>
              </div>
            </details>

            <details class="filter-section">
              <summary class="filter-section-toggle">Spécifique <span class="filter-chevron" /></summary>
              <div class="filter-section-body">
                <div class="flex flex-wrap gap-1.5">
                  {specificFilters.map(({ label, value }) => (
                    <button class="filter-chip" data-filter="specific" data-value={value} aria-pressed="false">{label}</button>
                  ))}
                </div>
              </div>
            </details>

            <button id="reset-filters" class="reset-btn" style="display:none">Tout effacer</button>

          </div>
        </aside>

        {/* Filtres mobile / tablette : recherche + bouton qui ouvre le panneau de filtres */}
        <div class="xl:hidden w-full flex flex-col gap-3 fade-rise">
          <div class="flex items-center gap-2">
            <label class="relative flex items-center flex-1 min-w-0">
              <span class="absolute left-3 text-[var(--color-text-faint)] flex items-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input
                type="text"
                id="catalog-search-mobile"
                placeholder="Rechercher un modèle..."
                aria-label="Rechercher un véhicule électrique"
                class="w-full bg-[var(--color-bg-subtle)] border border-[var(--color-border)] rounded-full py-2.5 pl-9 pr-3 text-sm text-[var(--color-text)] placeholder-[var(--color-text-faint)] focus:outline-none focus:border-[var(--color-accent)] focus:bg-[var(--color-bg)] transition-all duration-200"
              />
            </label>
            <button type="button" id="open-filters" class="filters-open-btn" aria-haspopup="dialog" aria-controls="filters-sheet">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" />
                <circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" />
              </svg>
              Filtres
              <span id="filters-badge" class="filters-badge" style="display:none">0</span>
            </button>
          </div>
          <div id="active-filters" class="active-filters" aria-label="Filtres actifs" style="display:none"></div>
        </div>

        {/* Panneau de filtres (mobile / tablette) */}
        <dialog id="filters-sheet" class="filters-sheet" aria-labelledby="filters-sheet-title">
          <div class="filters-sheet-panel">
            <div class="filters-sheet-head" data-sheet-drag>
              <span class="filters-sheet-handle" aria-hidden="true"></span>
              <div class="flex items-center justify-between w-full">
                <h2 id="filters-sheet-title" class="font-display text-lg font-semibold tracking-[-0.015em]">Filtres</h2>
                <button type="button" class="filters-sheet-close" data-close-sheet aria-label="Fermer les filtres">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="filters-sheet-body">
              <section class="sheet-section">
                <h3 class="sheet-section-title">Budget max</h3>
                <div class="flex flex-wrap gap-2">
                  {budgetFilters.map(({ label, value }) => (
                    <button type="button" class="filter-chip" data-filter="budget" data-value={value} aria-pressed="false">{label}</button>
                  ))}
                </div>
              </section>

              <section class="sheet-section">
                <h3 class="sheet-section-title">Carrosserie</h3>
                <div class="flex flex-wrap gap-2">
                  {categories.map((c) => (
                    <button type="button" class="filter-chip" data-filter="cat" data-value={c} aria-pressed="false">{c}</button>
                  ))}
                </div>
              </section>

              <section class="sheet-section">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <h3 class="sheet-section-title">Autonomie minimale</h3>
                  <div class="range-toggle-group">
                    <button type="button" id="range-type-mixed-mobile" class="range-toggle-btn" data-active="true">Mixte</button>
                    <button type="button" id="range-type-highway-mobile" class="range-toggle-btn" data-active="false">Autoroute</button>
                    <button type="button" id="range-type-wltp-mobile" class="range-toggle-btn" data-active="false">WLTP</button>
                  </div>
                </div>
                <div class="flex items-center gap-3 mt-3">
                  <input type="range" id="range-slider-mobile" min="0" max="700" step="20" value="0" class="flex-1 cursor-pointer" aria-label="Autonomie minimale" />
                  <span class="font-mono text-sm font-semibold text-[var(--color-accent)] min-w-[64px] text-right"><span id="range-value-display-mobile">0</span> km</span>
                </div>
              </section>

              <section class="sheet-section">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                  <h3 class="sheet-section-title">Recharge 10 → 80 %</h3>
                  <div class="range-toggle-group">
                    <button type="button" id="charge-profile-highway-mobile" class="range-toggle-btn" data-active="true">Autoroute</button>
                    <button type="button" id="charge-profile-mixed-mobile" class="range-toggle-btn" data-active="false">Mixte</button>
                    <button type="button" id="charge-profile-urban-mobile" class="range-toggle-btn" data-active="false">Ville</button>
                  </div>
                </div>
                <div class="flex items-center gap-3 mt-3">
                  <input type="range" id="charge-slider-mobile" min="0" max="450" step="10" value="0" class="flex-1 cursor-pointer" aria-label="Kilomètres récupérés minimum" />
                  <span class="font-mono text-sm font-semibold text-[var(--color-accent)] min-w-[72px] text-right">+<span id="charge-value-display-mobile">0</span> km</span>
                </div>
                <label class="flex items-center gap-2 cursor-pointer text-xs text-[var(--color-text-muted)] mt-3">
                  <input type="checkbox" id="toggle-charge-filter-mobile" class="w-4 h-4 accent-[var(--color-accent)] cursor-pointer" />
                  <span>Afficher la recharge sur les cartes</span>
                </label>
              </section>

              <section class="sheet-section">
                <h3 class="sheet-section-title">Coffre minimal</h3>
                <div class="flex items-center gap-3 mt-3">
                  <input type="range" id="trunk-slider-mobile" min="0" max="800" step="50" value="0" class="flex-1 cursor-pointer" aria-label="Volume de coffre minimal" />
                  <span class="font-mono text-sm font-semibold text-[var(--color-accent)] min-w-[64px] text-right"><span id="trunk-value-display-mobile">0</span> L</span>
                </div>
              </section>

              <section class="sheet-section">
                <h3 class="sheet-section-title">Spécifique</h3>
                <div class="flex flex-wrap gap-2">
                  {specificFilters.map(({ label, value }) => (
                    <button type="button" class="filter-chip" data-filter="specific" data-value={value} aria-pressed="false">{label}</button>
                  ))}
                </div>
              </section>

              <section class="sheet-section">
                <h3 class="sheet-section-title">Marques</h3>
                <div class="flex flex-col gap-3">
                  {brandGroups.map((group) => (
                    <div>
                      <p class="filter-subgroup-label">{group.label}</p>
                      <div class="flex flex-wrap gap-2">
                        {group.items.map((b) => (
                          <button type="button" class="filter-chip" data-filter="brand" data-value={b} aria-pressed="false">
                            <BrandLogo brand={b} class="h-3.5 w-auto max-w-[32px] flex-shrink-0" />
                            <span>{b}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            </div>

            <div class="filters-sheet-foot">
              <button type="button" id="reset-filters-mobile" class="reset-btn" style="display:none">Tout effacer</button>
              <button type="button" class="filters-sheet-apply" data-close-sheet>
                Voir <span id="sheet-results-count">{vehicles.length}</span> modèles
              </button>
            </div>
          </div>
        </dialog>

        {/* Contenu principal aligné avec container-edit */}
        <div class="catalog-grid flex-1 min-w-0">
          <BentoGrid>
            <Tile size="full" variant="elevated">
              <h1 class="display-1 max-w-3xl fade-rise fade-rise-delay-2">
                Tous les véhicules
                <span class="text-[var(--color-accent)]">· mis à jour {new Date().getFullYear()}.</span>
              </h1>
              <p class="mt-4 text-[var(--color-text-muted)] text-sm md:text-base max-w-2xl fade-rise fade-rise-delay-3">
                Filtrez par budget, autonomie réelle ou vitesse de charge : pas besoin de connaître les marques pour trouver la bonne voiture.
              </p>
              <div class="mt-6 pt-5 border-t border-[var(--color-border)] flex flex-wrap xl:flex-nowrap items-center gap-2 fade-rise fade-rise-delay-3">
                <span id="results-count" class="results-count" aria-live="polite">{vehicles.length} modèles</span>
                <span class="w-px h-4 bg-[var(--color-border)] mx-1" aria-hidden="true"></span>
                <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)] mr-1">Trier</span>
                <button class="sort-btn" data-sort="default" data-active="true">Défaut</button>
                <button class="sort-btn" data-sort="price-asc">Prix ↑</button>
                <button class="sort-btn" data-sort="price-desc">Prix ↓</button>
                <button class="sort-btn" data-sort="range-desc">Autonomie réelle</button>
                <button class="sort-btn" data-sort="dc-desc">Recharge DC</button>
                <button class="sort-btn" data-sort="ratio-desc">Rapport km/€ ★</button>
                <span class="flex-1"></span>
                <div
                  id="price-mode-toggle"
                  class="price-toggle-group"
                  title="* Montants maximaux (ménage précaire + majoration batterie européenne). Coup de pouce CEE 2026, sous conditions de revenus et d'éligibilité ADEME."
                >
                  <button class="price-toggle-btn" data-mode="gross" data-active="true">Brut</button>
                  <button class="price-toggle-btn" data-mode="aided">Après aides max.*</button>
                </div>
              </div>
            </Tile>

        {vehicles.map((v, i) => {
          const s = getVehicleCardSummary(v);
          const category = getCategory(v);

          const familial = isFamiliale(v) ? "Familiale" : "";
          const daily = isDaily(v) ? "Daily" : "";
          const leasing = isLeasing(v) ? "Leasing social" : "";
          const usageTags = [familial, daily, leasing].filter(Boolean).join(",");

          return (
            <div
              data-slug={v.slug}
              data-category={category}
              data-brand={v.brand}
              data-model={v.model}
              data-variant={v.variant}
              data-usage={usageTags}
              data-price={s.cheapestPrice ?? ""}
              data-price-aided={s.priceAided ?? ""}
              data-range={v.realRange.mixed_km}
              data-range-highway={v.realRange.highway_130_km}
              data-wltp={v.wltp_max_km}
              data-dc={v.chargingDC.peakPower_kW}
              data-ratio={s.cheapestPrice ? Math.round(v.realRange.mixed_km / s.cheapestPrice * 10000) : 0}
              data-origin={isEU(v) ? "eu" : "other"}
              data-cee={hasCEE(v) ? "1" : "0"}
              data-trunk={v.trunkCapacity_L}
              data-charge-highway={Math.round(v.realRange.highway_130_km * 0.70)}
              data-charge-mixed={Math.round(v.realRange.mixed_km * 0.70)}
              data-charge-urban={Math.round(v.realRange.urban_km * 0.70)}
              data-match="1"
              class="vehicle-card contents"
              style={i >= PAGE_SIZE ? "display: none" : undefined}
            >
              <Tile size="2x1" variant="default" href={url(`/vehicules/${v.slug}`)} ariaLabel={`Fiche ${v.brand} ${v.model}`} class="reveal">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <div class="flex items-center gap-2 text-[var(--color-text-muted)] min-w-0">
                    <BrandLogo brand={v.brand} class="w-4 h-4" />
                    <span class="label-eyebrow !text-[var(--color-text-faint)] truncate">{v.brand} · {category}</span>
                  </div>
                  <div class="flex items-center gap-2 flex-wrap justify-end relative z-10">
                    {isLeasing(v) && <Tag tone="accent" mono>Leasing social</Tag>}
                    <FavoriteButton client:visible slug={v.slug} size={15} />
                  </div>
                </div>
                <div class="flex items-end gap-3 mb-6">
                  <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-[-0.015em] leading-[1.05]">
                    {v.model}
                    <span class="block text-[var(--color-text-muted)] font-mono text-[11px] md:text-xs mt-1 font-normal tracking-normal leading-tight">{s.subtitle}</span>
                  </h2>
                  <div class="flex-1 h-14 relative min-w-[120px]">
                    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-44 h-22 flex items-end justify-center">
                      <VehicleImage
                        slug={v.slug}
                        alt={`${v.brand} ${v.model}`}
                        class="w-full h-full"
                      />
                    </div>
                  </div>
                </div>
                <div class="card-footer-grid grid grid-cols-2 gap-2 md:gap-4 mt-auto pt-5 border-t border-[var(--color-border)]">
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)] whitespace-nowrap">
                      <span class="range-mode-mixed">Autonomie réelle</span>
                      <span class="range-mode-highway">Autoroute 130</span>
                      <span class="range-mode-wltp">WLTP annoncée</span>
                    </span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-xl sm:text-2xl md:text-3xl text-[var(--color-accent)]">
                        <span class="range-mode-mixed">{v.realRange.mixed_km}</span>
                        <span class="range-mode-highway">{v.realRange.highway_130_km}</span>
                        <span class="range-mode-wltp">{v.wltp_max_km}</span>
                      </span>
                      <span class="font-mono text-[11px] text-[var(--color-text-faint)]">km</span>
                    </div>
                    <span class="card-confidence" data-level={s.rangeConfidence}>
                      <span class="range-mode-mixed">{s.rangeConfidenceLabel}</span>
                      <span class="range-mode-highway">{s.rangeConfidenceLabel}</span>
                      <span class="range-mode-wltp">cycle d'homologation</span>
                    </span>
                  </div>

                  <div class="card-charge-col hidden flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)] whitespace-nowrap">
                      Recharge 10 → 80 %
                    </span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-xl sm:text-2xl md:text-3xl text-[var(--color-accent)]">
                        +{Math.round(v.realRange.highway_130_km * 0.70)}
                      </span>
                      <span class="font-mono text-[11px] text-[var(--color-text-faint)]">km</span>
                    </div>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)] leading-none">
                      en {v.chargingDC.time_10_80_min} min (autoroute)
                    </span>
                  </div>

                  <div class="flex flex-col gap-1 text-right items-end">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">
                      {s.cheapestPrice !== null ? (
                        <>
                          <span class="price-mode-gross">Dès</span>
                          <span class="price-mode-aided">Après aides*</span>
                        </>
                      ) : "Prix"}
                    </span>
                    {s.cheapestPrice !== null ? (
                      <>
                        <div class="price-mode-gross flex items-baseline justify-end gap-1">
                          <span data-numeric class="display-stat text-xl sm:text-2xl md:text-3xl">{formatPrice(s.cheapestPrice)}</span>
                        </div>
                        <div class="price-mode-aided flex flex-col items-end gap-0.5">
                          <span data-numeric class="display-stat text-xl sm:text-2xl md:text-3xl" style="color:var(--color-accent)">{formatPrice(s.priceAided!)}</span>
                          {s.totalAids > 0
                            ? <span class="font-mono text-[11px] text-[var(--color-text-faint)] line-through">{formatPrice(s.cheapestPrice)}</span>
                            : <span class="font-mono text-[11px] text-[var(--color-text-faint)]">aucune aide</span>}
                        </div>
                      </>
                    ) : (
                      <span class="font-display text-sm md:text-base font-medium text-[var(--color-text-faint)] leading-tight mt-1">Prix non<br />communiqué</span>
                    )}
                  </div>
                </div>
              </Tile>
            </div>
          );
        })}
      </BentoGrid>

      <!-- Pagination : 24 modèles à la fois -->
      <div class="catalog-footer">
        <div id="catalog-empty" class="catalog-empty" style="display:none">
          <p class="font-display text-lg font-semibold">Aucun modèle ne correspond.</p>
          <p class="text-sm text-[var(--color-text-muted)]">Élargissez un filtre ou repartez de zéro.</p>
          <button type="button" class="catalog-empty-reset reset-btn" data-reset-filters>Tout effacer</button>
        </div>
        <button
          type="button"
          id="load-more"
          class="load-more-btn"
          style={vehicles.length > PAGE_SIZE ? undefined : "display:none"}
        >
          Voir plus de modèles
          <span id="load-more-count" class="load-more-count">{Math.max(0, vehicles.length - PAGE_SIZE)} restants</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═════════ SECTION SEO / DÉCOUVERTE ═════════ -->
  <section class="mt-16 pt-16 border-t border-[var(--color-border)]">
    <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-[-0.015em] mb-6">
      Trois réflexes pour ne pas se faire avoir, même sans être un expert
    </h2>
    <div class="grid md:grid-cols-3 gap-6 text-xs md:text-sm text-[var(--color-text-muted)] leading-relaxed">
      <div class="flex flex-col gap-3">
        <h3 class="font-display text-base font-semibold text-[var(--color-text)]">1. Regardez l'autonomie réelle, pas le chiffre en gros sur l'affiche</h3>
        <p>
          Le chiffre "WLTP" mis en avant par les constructeurs est un chiffre de laboratoire, presque toujours plus optimiste que ce que vous obtiendrez sur la route. On affiche à la place l'<strong>autonomie réelle</strong>, mesurée lors de vrais essais (usage mixte et autoroute à 130 km/h). Ajustez le curseur d'autonomie pour ne garder que les modèles qui tiendront vraiment vos trajets.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="font-display text-base font-semibold text-[var(--color-text)]">2. Comparez le prix après aides, pas le prix catalogue</h3>
        <p>
          Selon vos revenus, les aides de l'État peuvent faire baisser le prix de plusieurs milliers d'euros. Basculez l'affichage sur "Après aides" pour voir ce que chaque voiture électrique vous coûterait vraiment, primes et bonus déduits, plutôt que le prix affiché en concession.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <h3 class="font-display text-base font-semibold text-[var(--color-text)]">3. Regardez le temps de recharge, pas juste la puissance annoncée</h3>
        <p>
          Une grosse puissance de recharge en kW ne veut rien dire seule. Ce qui compte, c'est combien de minutes vous passez réellement à la borne pour récupérer 10 à 80 % de batterie : c'est ce chiffre qui fera la différence sur un long trajet en famille ou en déplacement professionnel.
        </p>
      </div>
    </div>
  </section>

  <script>
    const PAGE_SIZE = 24;

    type FilterKey = 'brand' | 'cat' | 'budget' | 'specific';
    type RangeType = 'mixed' | 'highway' | 'wltp';
    type ChargeProfile = 'highway' | 'mixed' | 'urban';
    type PriceMode = 'gross' | 'aided';
    type ActiveFilter = { label: string; clear: () => void };

    const SORT_KEYS = ['default', 'price-asc', 'price-desc', 'range-desc', 'dc-desc', 'ratio-desc'] as const;
    type SortKey = (typeof SORT_KEYS)[number];
    const isSortKey = (v: string | null | undefined): v is SortKey => SORT_KEYS.includes(v as SortKey);
    const isFilterKey = (v: string | undefined): v is FilterKey => ['brand', 'cat', 'budget', 'specific'].includes(v ?? '');

    document.addEventListener('astro:page-load', () => {
      const grid = document.querySelector<HTMLElement>('.catalog-grid .bento-grid');
      if (!grid) return;

      const chips     = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
      const cards     = document.querySelectorAll<HTMLElement>('.vehicle-card');
      const sortBtns  = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
      const resetBtns = document.querySelectorAll<HTMLButtonElement>('#reset-filters, #reset-filters-mobile, [data-reset-filters]');
      const originalOrder = Array.from(cards);

      const searchInputs = [
        document.querySelector<HTMLInputElement>('#catalog-search'),
        document.querySelector<HTMLInputElement>('#catalog-search-mobile'),
      ].filter((el): el is HTMLInputElement => el !== null);

      const resultsCount      = document.querySelector<HTMLElement>('#results-count');
      const sheetResultsCount = document.querySelector<HTMLElement>('#sheet-results-count');
      const loadMoreBtn       = document.querySelector<HTMLButtonElement>('#load-more');
      const loadMoreCount     = document.querySelector<HTMLElement>('#load-more-count');
      const emptyState        = document.querySelector<HTMLElement>('#catalog-empty');
      const filtersBadge      = document.querySelector<HTMLElement>('#filters-badge');
      const activeFiltersRow  = document.querySelector<HTMLElement>('#active-filters');

      // ── État ────────────────────────────────────────────────
      let priceMode: PriceMode = 'gross';
      let currentSort: SortKey = 'default';
      let currentSearch = '';
      let rangeType: RangeType = 'mixed';
      let minRange = 0;
      let minTrunk = 0;
      let chargeFilterEnabled = false;
      let chargeProfile: ChargeProfile = 'highway';
      let minChargeRange = 0;
      let pageLimit = PAGE_SIZE;

      // Chips partagés entre la sidebar desktop et le panneau mobile
      const active: Record<FilterKey, Set<string>> = {
        brand: new Set(), cat: new Set(), budget: new Set(), specific: new Set(),
      };

      // ── Contrôles présents en double (sidebar desktop + panneau mobile) ──
      function both<T extends HTMLElement>(id: string): T[] {
        return [document.getElementById(id), document.getElementById(`${id}-mobile`)]
          .filter((el): el is T => el !== null);
      }

      const rangeSliders   = both<HTMLInputElement>('range-slider');
      const rangeDisplays  = both<HTMLElement>('range-value-display');
      const trunkSliders   = both<HTMLInputElement>('trunk-slider');
      const trunkDisplays  = both<HTMLElement>('trunk-value-display');
      const chargeSliders  = both<HTMLInputElement>('charge-slider');
      const chargeDisplays = both<HTMLElement>('charge-value-display');
      const chargeToggles  = both<HTMLInputElement>('toggle-charge-filter');
      const rangeTypeBtns: Record<RangeType, HTMLElement[]> = {
        mixed: both('range-type-mixed'), highway: both('range-type-highway'), wltp: both('range-type-wltp'),
      };
      const profileBtns: Record<ChargeProfile, HTMLElement[]> = {
        highway: both('charge-profile-highway'), mixed: both('charge-profile-mixed'), urban: both('charge-profile-urban'),
      };

      function updateSliderBackground(slider: HTMLInputElement) {
        const min = +slider.min || 0;
        const max = +slider.max || 100;
        const pct = ((+slider.value - min) / (max - min)) * 100;
        slider.style.background = `linear-gradient(to right, var(--color-accent) 0%, var(--color-accent) ${pct}%, var(--color-border) ${pct}%, var(--color-border) 100%)`;
      }

      function setActiveAttr<K extends string>(groups: Record<K, HTMLElement[]>, current: K) {
        (Object.keys(groups) as K[]).forEach((key) =>
          groups[key].forEach((b) => b.setAttribute('data-active', key === current ? 'true' : 'false')));
      }

      function updateRangeUI() {
        rangeSliders.forEach((s) => { s.value = String(minRange); updateSliderBackground(s); });
        rangeDisplays.forEach((d) => { d.textContent = String(minRange); });
        document.body.dataset.rangeMode = rangeType;
        setActiveAttr(rangeTypeBtns, rangeType);
      }

      function updateTrunkUI() {
        trunkSliders.forEach((s) => { s.value = String(minTrunk); updateSliderBackground(s); });
        trunkDisplays.forEach((d) => { d.textContent = String(minTrunk); });
      }

      function updateChargeUI() {
        chargeSliders.forEach((s) => { s.value = String(minChargeRange); updateSliderBackground(s); });
        chargeDisplays.forEach((d) => { d.textContent = String(minChargeRange); });
        chargeToggles.forEach((t) => { t.checked = chargeFilterEnabled; });
        document.body.dataset.showCharge = chargeFilterEnabled ? 'true' : 'false';
        setActiveAttr(profileBtns, chargeProfile);
      }

      function syncAllChips() {
        chips.forEach((c) => {
          const f = c.dataset.filter;
          const pressed = isFilterKey(f) && active[f].has(c.dataset.value ?? '');
          c.setAttribute('aria-pressed', pressed ? 'true' : 'false');
        });
      }

      // ── Filtrage ────────────────────────────────────────────
      function getCardPrice(card: HTMLElement): number {
        const raw = priceMode === 'aided' ? (card.dataset.priceAided || card.dataset.price) : card.dataset.price;
        const value = Number(raw);
        return raw && !Number.isNaN(value) ? value : Infinity;
      }

      function getFavorites(): string[] {
        try {
          const raw = localStorage.getItem('evly-favorites');
          return raw ? JSON.parse(raw) : [];
        } catch { return []; }
      }

      function cardMatches(card: HTMLElement, favSlugs: Set<string>, query: string): boolean {
        const d = card.dataset;
        const usages = (d.usage || '').split(',').filter(Boolean);
        const range = rangeType === 'wltp' ? +(d.wltp ?? 0) : rangeType === 'highway' ? +(d.rangeHighway ?? 0) : +(d.range ?? 0);

        if (active.brand.size && !active.brand.has(d.brand ?? '')) return false;
        if (active.cat.size && !active.cat.has(d.category ?? '')) return false;
        if (active.budget.size && getCardPrice(card) > Math.max(...[...active.budget].map(Number))) return false;
        if (range < minRange) return false;
        if (+(d.trunk ?? 0) < minTrunk) return false;

        if (chargeFilterEnabled && minChargeRange > 0) {
          const chargeKm = chargeProfile === 'highway' ? d.chargeHighway : chargeProfile === 'mixed' ? d.chargeMixed : d.chargeUrban;
          if (+(chargeKm ?? 0) < minChargeRange) return false;
        }

        for (const s of active.specific) {
          if (s === 'favorites'   && !favSlugs.has(d.slug ?? '')) return false;
          if (s === 'fast-charge' && +(d.dc ?? 0) < 100) return false;
          if (s === 'eu'          && d.origin !== 'eu') return false;
          if (s === 'cee'         && d.cee !== '1') return false;
          if (s === 'leasing'     && !usages.includes('Leasing social')) return false;
          if (s === 'familiale'   && !usages.includes('Familiale')) return false;
        }

        if (query) {
          const hay = `${d.model} ${d.brand} ${d.variant}`.toLowerCase();
          if (!hay.includes(query)) return false;
        }
        return true;
      }

      function updateFilters(resetPage: boolean) {
        const favSlugs = new Set(active.specific.has('favorites') ? getFavorites() : []);
        const query = currentSearch.toLowerCase().trim();
        cards.forEach((card) => {
          card.dataset.match = cardMatches(card, favSlugs, query) ? '1' : '0';
        });
        if (resetPage) pageLimit = PAGE_SIZE;
        applyPagination();
      }

      // ── Pagination : n'affiche que les `pageLimit` premiers résultats ──
      function applyPagination() {
        let matched = 0;
        let shown = 0;
        grid!.querySelectorAll<HTMLElement>('.vehicle-card').forEach((card) => {
          const isMatch = card.dataset.match !== '0';
          if (isMatch) matched++;
          const show = isMatch && shown < pageLimit;
          if (show) shown++;
          card.style.display = show ? 'contents' : 'none';
        });
        const remaining = matched - shown;
        if (resultsCount) resultsCount.textContent = `${matched} modèle${matched > 1 ? 's' : ''}`;
        if (sheetResultsCount) sheetResultsCount.textContent = String(matched);
        if (loadMoreBtn) loadMoreBtn.style.display = remaining > 0 ? '' : 'none';
        if (loadMoreCount) loadMoreCount.textContent = `${remaining} restant${remaining > 1 ? 's' : ''}`;
        if (emptyState) emptyState.style.display = matched === 0 ? '' : 'none';
      }

      loadMoreBtn?.addEventListener('click', () => {
        pageLimit += PAGE_SIZE;
        applyPagination();
      });

      // ── Filtres actifs : reset, badge, pastilles, URL ───────
      const chipLabels: Record<string, string> = {};
      chips.forEach((c) => { chipLabels[`${c.dataset.filter}:${c.dataset.value}`] = c.textContent?.trim() ?? ''; });
      const chipLabel = (filter: FilterKey, value: string) => chipLabels[`${filter}:${value}`] || value;

      function getActiveFilterList(): ActiveFilter[] {
        const list: ActiveFilter[] = [];
        const search = currentSearch.trim();
        if (search) list.push({ label: `« ${search} »`, clear: () => setSearch('') });
        active.budget.forEach((v) => list.push({ label: chipLabel('budget', v), clear: () => toggleChip('budget', v) }));
        active.cat.forEach((v) => list.push({ label: v, clear: () => toggleChip('cat', v) }));
        if (minRange > 0) {
          const kind = rangeType === 'wltp' ? 'WLTP' : rangeType === 'highway' ? 'Autoroute' : 'Autonomie';
          list.push({ label: `${kind} ≥ ${minRange} km`, clear: () => { minRange = 0; updateRangeUI(); onStateChange(); } });
        }
        if (chargeFilterEnabled && minChargeRange > 0) {
          list.push({
            label: `Recharge +${minChargeRange} km`,
            clear: () => { minChargeRange = 0; chargeFilterEnabled = false; updateChargeUI(); onStateChange(); },
          });
        }
        if (minTrunk > 0) list.push({ label: `Coffre ≥ ${minTrunk} L`, clear: () => { minTrunk = 0; updateTrunkUI(); onStateChange(); } });
        active.specific.forEach((v) => list.push({ label: chipLabel('specific', v), clear: () => toggleChip('specific', v) }));
        active.brand.forEach((v) => list.push({ label: v, clear: () => toggleChip('brand', v) }));
        return list;
      }

      function renderActiveFilters(list: ActiveFilter[]) {
        if (!activeFiltersRow) return;
        activeFiltersRow.replaceChildren(...list.map((f) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'active-filter-pill';
          btn.setAttribute('aria-label', `Retirer le filtre ${f.label}`);
          const text = document.createElement('span');
          text.textContent = f.label;
          btn.append(text);
          btn.insertAdjacentHTML('beforeend', '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>');
          btn.addEventListener('click', f.clear);
          return btn;
        }));
        activeFiltersRow.style.display = list.length ? '' : 'none';
      }

      function syncURL() {
        const params = new URLSearchParams(window.location.search);
        const set = (key: string, value: string) => (value ? params.set(key, value) : params.delete(key));
        set('q', currentSearch.trim());
        set('marques', [...active.brand].join(','));
        set('types', [...active.cat].join(','));
        set('budget', [...active.budget].join(','));
        set('options', [...active.specific].join(','));
        set('autonomie', minRange > 0 ? String(minRange) : '');
        set('mode', rangeType !== 'mixed' ? rangeType : '');
        set('coffre', minTrunk > 0 ? String(minTrunk) : '');
        set('recharge', chargeFilterEnabled ? String(minChargeRange) : '');
        set('profil', chargeFilterEnabled && chargeProfile !== 'highway' ? chargeProfile : '');
        set('tri', currentSort !== 'default' ? currentSort : '');
        set('prix', priceMode === 'aided' ? 'aides' : '');
        const qs = params.toString();
        window.history.replaceState(window.history.state, '', `${window.location.pathname}${qs ? `?${qs}` : ''}`);
      }

      function readURL() {
        const params = new URLSearchParams(window.location.search);
        const list = (key: string) => (params.get(key) || '').split(',').map((s) => s.trim()).filter(Boolean);
        const num = (key: string) => Math.max(0, Number(params.get(key)) || 0);
        currentSearch = params.get('q') || '';
        list('marques').forEach((v) => active.brand.add(v));
        list('types').forEach((v) => active.cat.add(v));
        list('budget').forEach((v) => active.budget.add(v));
        list('options').forEach((v) => active.specific.add(v));
        minRange = num('autonomie');
        const mode = params.get('mode');
        if (mode === 'highway' || mode === 'wltp') rangeType = mode;
        minTrunk = num('coffre');
        if (params.has('recharge')) {
          chargeFilterEnabled = true;
          minChargeRange = num('recharge');
        }
        const profil = params.get('profil');
        if (profil === 'mixed' || profil === 'urban') chargeProfile = profil;
        if (params.get('prix') === 'aides') priceMode = 'aided';
        const tri = params.get('tri');
        currentSort = isSortKey(tri) ? tri : 'default';
      }

      function onStateChange(resetPage = true) {
        updateFilters(resetPage);
        const list = getActiveFilterList();
        const hasAny = list.length > 0 || rangeType !== 'mixed' || chargeFilterEnabled;
        resetBtns.forEach((b) => { b.style.display = hasAny ? '' : 'none'; });
        if (filtersBadge) {
          filtersBadge.textContent = String(list.length);
          filtersBadge.style.display = list.length ? '' : 'none';
        }
        renderActiveFilters(list);
        syncURL();
      }

      // ── Interactions ────────────────────────────────────────
      function toggleChip(filter: FilterKey, value: string) {
        if (active[filter].has(value)) active[filter].delete(value);
        else active[filter].add(value);
        syncAllChips();
        onStateChange();
      }
      chips.forEach((chip) => chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        if (isFilterKey(f) && chip.dataset.value) toggleChip(f, chip.dataset.value);
      }));

      function setSearch(value: string) {
        currentSearch = value;
        searchInputs.forEach((input) => { input.value = value; });
        onStateChange();
      }
      searchInputs.forEach((input) => input.addEventListener('input', () => setSearch(input.value)));

      (Object.keys(rangeTypeBtns) as RangeType[]).forEach((type) => rangeTypeBtns[type].forEach((b) => b.addEventListener('click', () => {
        rangeType = type;
        updateRangeUI();
        onStateChange();
      })));
      rangeSliders.forEach((s) => s.addEventListener('input', () => {
        minRange = +s.value;
        updateRangeUI();
        onStateChange();
      }));
      trunkSliders.forEach((s) => s.addEventListener('input', () => {
        minTrunk = +s.value;
        updateTrunkUI();
        onStateChange();
      }));
      chargeToggles.forEach((t) => t.addEventListener('change', () => {
        chargeFilterEnabled = t.checked;
        updateChargeUI();
        onStateChange();
      }));
      (Object.keys(profileBtns) as ChargeProfile[]).forEach((p) => profileBtns[p].forEach((b) => b.addEventListener('click', () => {
        chargeProfile = p;
        chargeFilterEnabled = true;
        updateChargeUI();
        onStateChange();
      })));
      chargeSliders.forEach((s) => s.addEventListener('input', () => {
        minChargeRange = +s.value;
        if (minChargeRange > 0) chargeFilterEnabled = true;
        updateChargeUI();
        onStateChange();
      }));

      resetBtns.forEach((btn) => btn.addEventListener('click', () => {
        Object.values(active).forEach((s) => s.clear());
        syncAllChips();
        currentSearch = '';
        searchInputs.forEach((input) => { input.value = ''; });
        rangeType = 'mixed';
        minRange = 0;
        minTrunk = 0;
        minChargeRange = 0;
        chargeProfile = 'highway';
        chargeFilterEnabled = false;
        updateRangeUI();
        updateTrunkUI();
        updateChargeUI();
        onStateChange();
      }));

      const handleFavoritesChange = () => { if (active.specific.has('favorites')) onStateChange(false); };
      window.addEventListener('favorites-changed', handleFavoritesChange);
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('favorites-changed', handleFavoritesChange);
      }, { once: true });

      // ── Tri ─────────────────────────────────────────────────
      function sortCards(sortKey: SortKey) {
        const num = (card: HTMLElement, key: 'range' | 'dc' | 'ratio') => Number(card.dataset[key] ?? 0);
        const byPrice = (dir: 1 | -1) => (a: HTMLElement, b: HTMLElement) => {
          const pa = getCardPrice(a);
          const pb = getCardPrice(b);
          if (pa === pb) return 0;
          if (pa === Infinity) return 1;
          if (pb === Infinity) return -1;
          return dir * (pa - pb);
        };
        const comparators: Record<Exclude<SortKey, 'default'>, (a: HTMLElement, b: HTMLElement) => number> = {
          'price-asc': byPrice(1),
          'price-desc': byPrice(-1),
          'range-desc': (a, b) => num(b, 'range') - num(a, 'range'),
          'dc-desc': (a, b) => num(b, 'dc') - num(a, 'dc'),
          'ratio-desc': (a, b) => num(b, 'ratio') - num(a, 'ratio'),
        };
        const sorted = sortKey === 'default' ? [...originalOrder] : [...originalOrder].sort(comparators[sortKey]);
        sorted.forEach((card) => grid!.appendChild(card));
      }

      function applySort(sortKey: SortKey) {
        currentSort = sortKey;
        sortBtns.forEach((btn) => {
          if (btn.dataset.sort === currentSort) btn.setAttribute('data-active', 'true');
          else delete btn.dataset.active;
        });
        sortCards(currentSort);
      }
      sortBtns.forEach((btn) => btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        if (!isSortKey(key)) return;
        applySort(key);
        onStateChange(false);
      }));

      // ── Prix brut / après aides ─────────────────────────────
      const priceBtns = document.querySelectorAll<HTMLButtonElement>('.price-toggle-btn');
      function applyPriceMode(mode: PriceMode) {
        priceMode = mode;
        priceBtns.forEach((b) => {
          if (b.dataset.mode === mode) b.setAttribute('data-active', 'true');
          else delete b.dataset.active;
        });
        document.body.dataset.priceMode = mode;
      }
      priceBtns.forEach((btn) => btn.addEventListener('click', () => {
        applyPriceMode(btn.dataset.mode === 'aided' ? 'aided' : 'gross');
        applySort(currentSort);
        onStateChange(false);
      }));

      // ── Panneau de filtres mobile (dialog natif) ────────────
      const sheet = document.querySelector<HTMLDialogElement>('#filters-sheet');
      const panel = sheet?.querySelector<HTMLElement>('.filters-sheet-panel');
      const openBtn = document.querySelector<HTMLButtonElement>('#open-filters');
      if (sheet && panel && openBtn) {
        const closeSheet = () => {
          if (!sheet.open) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { sheet.close(); return; }
          const from = panel.style.transform || 'translateY(0)';
          panel.animate([{ transform: from }, { transform: 'translateY(100%)' }], {
            duration: 220,
            easing: 'cubic-bezier(0.4, 0, 1, 1)',
          }).finished.then(() => {
            panel.style.transform = '';
            sheet.close();
          });
        };
        openBtn.addEventListener('click', () => sheet.showModal());
        sheet.querySelectorAll<HTMLElement>('[data-close-sheet]').forEach((b) => b.addEventListener('click', closeSheet));
        // Clic sur le fond grisé, touche Échap
        sheet.addEventListener('click', (e) => { if (e.target === sheet) closeSheet(); });
        sheet.addEventListener('cancel', (e) => { e.preventDefault(); closeSheet(); });

        // Glisser la poignée vers le bas pour fermer
        const dragZone = sheet.querySelector<HTMLElement>('[data-sheet-drag]');
        let startY: number | null = null;
        dragZone?.addEventListener('pointerdown', (e) => {
          if ((e.target as HTMLElement).closest('button')) return;
          startY = e.clientY;
          dragZone.setPointerCapture(e.pointerId);
          panel.style.transition = 'none';
        });
        dragZone?.addEventListener('pointermove', (e) => {
          if (startY === null) return;
          panel.style.transform = `translateY(${Math.max(0, e.clientY - startY)}px)`;
        });
        const endDrag = (e: PointerEvent) => {
          if (startY === null) return;
          const dy = Math.max(0, e.clientY - startY);
          startY = null;
          panel.style.transition = '';
          if (dy > 90) closeSheet();
          else panel.style.transform = '';
        };
        dragZone?.addEventListener('pointerup', endDrag);
        dragZone?.addEventListener('pointercancel', endDrag);
      }

      // ── Initialisation depuis l'URL ─────────────────────────
      readURL();
      searchInputs.forEach((input) => { input.value = currentSearch; });
      syncAllChips();
      updateRangeUI();
      updateTrunkUI();
      updateChargeUI();
      applyPriceMode(priceMode);
      applySort(currentSort);
      onStateChange();
    });
  </script>

