        </header>
        <BentoGrid class="mini-grid">
          {alternatives.map((alt) => <VehicleMiniCard vehicle={alt} />)}
        </BentoGrid>
        <LinkChips
          groups={[
            {
              title: `Autres ${vehicle.brand} électriques`,
              links: otherBrandModels.length > 0
                ? [
                    ...otherBrandModels.map((v) => ({ label: getVehicleName(v), href: url(`/vehicules/${v.slug}/`) })),
                    { label: `Toute la gamme ${vehicle.brand} →`, href: url(brandPath), accent: true },
