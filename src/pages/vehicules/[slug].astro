      <!-- ═══ 8. Questions fréquentes ═══ -->
      <section id="faq" class="vehicle-section" aria-labelledby="faq-title">
        <header class="vehicle-section-head">
          <h2 id="faq-title" class="vehicle-section-title">{vehicle.brand} {vehicle.model}, en clair</h2>
          <p class="vehicle-section-sub">Les questions qu'on se pose avant d'acheter.</p>
