      <!-- ═══ 7. Tests & sources ═══ -->
      <section id="sources" class="vehicle-section" aria-labelledby="sources-title">
        <header class="vehicle-section-head">
          <h2 id="sources-title" class="vehicle-section-title">Tests & sources</h2>
          <p class="vehicle-section-sub">D'où vient chaque chiffre, et son niveau de confiance.</p>
        </header>
        <BentoGrid>
          {configViews.map((cv, index) => (
            <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
              {cv.rangeTests.length > 0 && (
                <Tile size="full" label="Tests terrain agrégés" class="reveal">
                  <div class="flex items-center justify-between gap-3 -mt-2 mb-4">
