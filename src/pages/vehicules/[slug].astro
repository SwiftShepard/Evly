    </div>

    <!-- Sticky sidebar (xl+ only) -->
    <aside class="vehicle-sidebar">
      {vehicle.configurations.length > 1 && (
        <div class="sidebar-block">
          <span class="sidebar-label">Configuration</span>
          <VehicleConfigSelector client:idle vehicle={vehicle} />
        </div>
      )}

      {configurations.map((config, index) => {
        const wheelPenalty = getWheelRangePenalty(config, vehicle.configurations);
        return (
          <div data-config-id={config.id} class="sidebar-config" style={index === 0 ? "" : "display:none"}>
            <div class="sidebar-block">
              <span class="sidebar-label">Prix brut</span>
              {config.price_EUR != null ? (
                <span data-numeric class="sidebar-price">{formatPrice(config.price_EUR)}</span>
              ) : (
                <span class="sidebar-price-nc">Prix NC</span>
              )}
              <span class="sidebar-hint">
                {config.label} · hors options
              </span>
              {wheelPenalty && (
                <span class="text-[var(--color-danger)] block mt-1 font-mono text-[9px] uppercase tracking-wider">
                  ⚠️ Impact jantes : -{wheelPenalty.pct}% d'autonomie
                </span>
              )}
              {config.leasingSocialEligible && config.monthlyLease_EUR && (
                <div class="sidebar-leasing">
                  <Tag tone="accent" mono>Leasing social</Tag>
                  <span class="sidebar-leasing-price">{config.monthlyLease_EUR} €/mois</span>
                </div>
              )}
            </div>
          </div>
        );
      })}

      {vehicle.availableAids.length > 0 && (
        <div class="sidebar-block">
          <CeeSimulator client:load vehicle={vehicle} />
        </div>
      )}

      <div class="sidebar-block">
        <SohSlider client:idle />
      </div>

      <div class="sidebar-block">
        <TemperatureSlider client:idle chemistry={vehicle.chemistry} heatPump={vehicle.heatPump} />
      </div>

      <div class="sidebar-block sidebar-actions">
        <FavoriteButton client:idle slug={vehicle.slug} size={16} className="sidebar-fav-btn" />
        <a
          href={url(`/comparer/?v=${vehicle.slug}:${configurations[0]?.id}`)}
          class="sidebar-cta"
          id="compare-link"
        >
          Comparer ce modèle
        </a>
      </div>

      <div class="sidebar-block">
        <a
          href={url(`/simulateur/?v=${vehicle.slug}`)}
          class="sidebar-tco-btn"
          id="tco-simulator-link"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Simuler le coût de détention (TCO)
        </a>
      </div>

    </aside>
  </div>

  <script define:vars={{ vehicleSlug: vehicle.slug, initialConfigId: configurations[0]?.id || "default", compareBaseUrl: url("/comparer/"), simulateurBaseUrl: url("/simulateur/") }}>
    let currentConfigId = initialConfigId;

    // « Retour à la liste » : visible seulement si cette fiche a été ouverte
    // depuis une carte du catalogue (mémorisé par le catalogue en sessionStorage)
    try {
      const RETURN_KEY = "evly-catalog-return";
      const entry = JSON.parse(sessionStorage.getItem(RETURN_KEY) || "null");
      const backLink = document.getElementById("catalog-back-link");
      const isFresh = entry && Date.now() - entry.ts < 6 * 60 * 60 * 1000;
      if (backLink && isFresh && entry.slug === vehicleSlug && typeof entry.url === "string") {
        backLink.href = entry.url;
        backLink.hidden = false;
        backLink.addEventListener("click", () => {
          sessionStorage.setItem(RETURN_KEY, JSON.stringify({ ...entry, restore: true }));
        });
      }
    } catch (e) {
      // sessionStorage indisponible (navigation privée stricte) : le bouton reste masqué
    }
    let currentSoh = 100;
    let currentTempMultiplier = 1.0;

    function updateCompareLink() {
      const link = document.getElementById("compare-link");
      if (link) {
        link.href = `${compareBaseUrl}?v=${vehicleSlug}:${currentConfigId}:${currentSoh}`;
      }
      const mobileLink = document.getElementById("compare-link-mobile");
      if (mobileLink) {
        mobileLink.href = `${compareBaseUrl}?v=${vehicleSlug}:${currentConfigId}:${currentSoh}`;
      }
    }

    function updateTcoLink() {
      const link = document.getElementById("tco-simulator-link");
      if (link) {
        link.href = `${simulateurBaseUrl}?v=${vehicleSlug}&config=${currentConfigId}`;
      }
      const mobileLink = document.getElementById("tco-simulator-link-mobile");
      if (mobileLink) {
        mobileLink.href = `${simulateurBaseUrl}?v=${vehicleSlug}&config=${currentConfigId}`;
      }
    }

    function toggleConfigs(id) {
      document.querySelectorAll(".config-wrapper").forEach((el) => {
        el.style.display = el.getAttribute("data-config-id") === id ? "contents" : "none";
      });
      document.querySelectorAll(".sidebar-config").forEach((el) => {
        el.style.display = el.getAttribute("data-config-id") === id ? "block" : "none";
      });
    }

    // Handle interactive toggle
    window.addEventListener("config-changed", (e) => {
      const id = e.detail.configId;
      currentConfigId = id;
      toggleConfigs(id);
      const url = new URL(window.location.href);
      url.searchParams.set("config", id);
      window.history.replaceState(null, "", url.toString());
      updateCompareLink();
      updateTcoLink();
    });

    function updateRanges() {
      // Update range numbers based on currentSoh and currentTempMultiplier
      document.querySelectorAll(".soh-update-range").forEach((el) => {
        const base = parseFloat(el.getAttribute("data-base-range"));
        if (!isNaN(base)) {
          el.textContent = Math.round(base * (currentSoh / 100) * currentTempMultiplier);
        }
      });
    }

    // Init URL sync
    const urlParams = new URLSearchParams(window.location.search);
    const configParam = urlParams.get("config");
    if (configParam) {
      currentConfigId = configParam;
      toggleConfigs(configParam);
    }
    const sohParam = urlParams.get("soh");
    if (sohParam) {
      const parsedSoh = parseInt(sohParam, 10);
      if (!isNaN(parsedSoh) && parsedSoh >= 70 && parsedSoh <= 100) {
        currentSoh = parsedSoh;
      }
    }
    updateCompareLink();
    updateTcoLink();

    // Handle SoH slider change
    window.addEventListener("soh-changed", (e) => {
      const soh = e.detail.soh;
      currentSoh = soh;
      updateCompareLink();

      // Sync SoH to URL search parameters
      const urlVal = new URL(window.location.href);
      if (soh === 100) {
        urlVal.searchParams.delete("soh");
      } else {
        urlVal.searchParams.set("soh", soh.toString());
      }
      window.history.replaceState(null, "", urlVal.toString());

      // 1. Update range numbers
      updateRanges();

      // 2. Update battery capacity numbers
      document.querySelectorAll(".soh-update-capacity").forEach((el) => {
        const base = parseFloat(el.getAttribute("data-base-capacity"));
        if (!isNaN(base)) {
          const statEl = el.querySelector(".display-stat");
          if (statEl) {
            const newVal = (base * soh / 100).toFixed(1).replace(".", ",");
            statEl.textContent = newVal.endsWith(",0") ? newVal.slice(0, -2) : newVal;
          }
        }
      });

      // 3. Update inline capacity texts
      document.querySelectorAll(".soh-update-text-capacity").forEach((el) => {
        const base = parseFloat(el.getAttribute("data-base-capacity"));
        if (!isNaN(base)) {
          const newVal = (base * soh / 100).toFixed(1).replace(".", ",");
          el.textContent = newVal.endsWith(",0") ? newVal.slice(0, -2) : newVal;
        }
      });

      // 4. Update inline WLTP texts
      document.querySelectorAll(".soh-update-text-wltp").forEach((el) => {
        const base = parseFloat(el.getAttribute("data-base-wltp"));
        if (!isNaN(base)) {
          el.textContent = Math.round(base * soh / 100);
        }
      });
    });

    // Handle Temperature slider change
    window.addEventListener("temperature-changed", (e) => {
      currentTempMultiplier = e.detail.tempMultiplier;
      updateCompareLink();
      updateRanges();
    });

    // Chiffres clés : au survol, la case s'élargit et son détail se déplie dans le flux ;
    // les autres cases glissent vers leur nouvelle place (animation FLIP).
    // Tap sur écran tactile, focus clavier, Échap pour refermer.
    const HINT_EASE = "cubic-bezier(0.2, 0.8, 0.2, 1)";
    const HINT_DURATION = 380;
    const hintReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hintWideLayout = window.matchMedia("(min-width: 640px)");

    function setHintOpen(group, cell) {
      const isGrid = group.classList.contains("stat-hints");
      const items = isGrid ? [...group.children].filter((el) => el.offsetParent !== null) : [];
      const first = new Map(items.map((el) => [el, el.getBoundingClientRect()]));
      const heightBefore = group.getBoundingClientRect().height;

      group.querySelectorAll(".stat-hint.is-open").forEach((el) => {
        el.classList.remove("is-open");
        el.style.order = "";
      });
      if (cell) {
        if (isGrid && hintWideLayout.matches) {
          // Case de la première ligne : elle s'ouvre en haut, sinon en bas.
          // Elle reste ainsi sous le curseur pendant la réorganisation.
          const topRow = Math.min(...items.map((el) => first.get(el).top));
          cell.style.order = first.get(cell).top - topRow < 4 ? "-1" : "99";
        }
        cell.classList.add("is-open");
      }
      group.classList.toggle("has-open", Boolean(cell));

      if (hintReducedMotion || !isGrid) return;
      items.forEach((el) => {
        const before = first.get(el);
        const after = el.getBoundingClientRect();
        const dx = before.left - after.left;
        const dy = before.top - after.top;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;
        el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }],
          { duration: HINT_DURATION, easing: HINT_EASE }
        );
      });
      const heightAfter = group.getBoundingClientRect().height;
      if (Math.abs(heightAfter - heightBefore) > 1) {
        group.animate(
          [{ height: `${heightBefore}px` }, { height: `${heightAfter}px` }],
          { duration: HINT_DURATION, easing: HINT_EASE }
        );
      }
    }

    document.querySelectorAll("[data-hint-group]").forEach((group) => {
      let current = null;
      let openTimer = null;
      let closeTimer = null;
      let lockedUntil = 0;

      const open = (cell) => {
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
        if (cell === current) return;
        current = cell;
        setHintOpen(group, cell);
        // Pendant l'animation les cases bougent sous le curseur : on ignore la souris
        lockedUntil = performance.now() + HINT_DURATION + 40;
      };
      const close = () => open(null);
      group.__closeHint = close;

      group.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        clearTimeout(closeTimer);
        const cell = e.target.closest(".stat-hint");
        if (!cell || cell === current) {
          clearTimeout(openTimer);
          return;
        }
        if (performance.now() < lockedUntil) return;
        clearTimeout(openTimer);
        openTimer = setTimeout(() => open(cell), current ? 140 : 90);
      });
      group.addEventListener("pointerleave", (e) => {
        if (e.pointerType !== "mouse") return;
        clearTimeout(openTimer);
        closeTimer = setTimeout(close, 220);
      });
      group.addEventListener("click", (e) => {
        if (e.pointerType === "mouse" || e.target.closest("a, button")) return;
        const cell = e.target.closest(".stat-hint");
        if (cell) open(cell === current ? null : cell);
      });
      group.addEventListener("focusin", (e) => {
        const cell = e.target.closest(".stat-hint");
        if (cell && e.target === cell) open(cell);
      });
      group.addEventListener("focusout", (e) => {
        if (!group.contains(e.relatedTarget)) close();
      });
      group.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    });

    if (!window.__evlyStatHintOutside) {
      window.__evlyStatHintOutside = true;
      document.addEventListener("click", (e) => {
        if (e.pointerType === "mouse" || e.target.closest("[data-hint-group]")) return;
        document.querySelectorAll("[data-hint-group].has-open, [data-hint-group]:has(.is-open)").forEach((group) => {
          group.__closeHint?.();
        });
      });
    }

    // Sommaire collant : surligne la section en cours de lecture
    const tocLinks = document.querySelectorAll("[data-toc-link]");
    const tocSections = [...tocLinks]
      .map((link) => document.getElementById(link.getAttribute("data-toc-link")))
      .filter(Boolean);
    if (tocSections.length > 0) {
      const setActive = (id) => {
        tocLinks.forEach((link) => {
          const isActive = link.getAttribute("data-toc-link") === id;
          if (isActive) {
            link.setAttribute("aria-current", "true");
            link.scrollIntoView({ block: "nearest", inline: "nearest" });
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };
      const tocObserver = new IntersectionObserver((entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) setActive(visible[0].target.id);
      }, { rootMargin: "-130px 0px -60% 0px" });
      tocSections.forEach((section) => tocObserver.observe(section));
    }
  </script>

<style>
  /* ── Vehicle page layout ── */
  .vehicle-page {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 768px) {
    .vehicle-page { padding-inline: 2rem; }
  }
  @media (min-width: 1280px) {
