import { isVehicleEligibleCEE, europeStatus, primeFor, grosRouleurOpen, CEE_PRICE_CAP_EUR, CEE_GRID_LABEL, PRIME_GRID, HOUSEHOLD_LABELS, HOUSEHOLD_CONDITIONS } from "@/lib/cee";
import FavoriteButton from "@/components/ui/FavoriteButton";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
