import {
  agree,
  brandSlug,
  getAlternatives,
  getBodyInfo,
  getMarketStatus,
  getVehicleAliases,
  getVehicleDescription,
  getVehicleLead,
  getVehicleName,
  getVehicleSeoFacts,
  getVehicleTitle,
  inCountry,
  isMasculine,
  withArticle,
  withDe,
} from "@/lib/seo";

export function getStaticPaths() {
  return getAllVehicles().map((vehicle) => ({
    params: { slug: vehicle.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("Slug manquant");

const vehicle = getVehicleBySlug(slug);
if (!vehicle) {
  return Astro.redirect("/404");
}

// Photo héros en WebP 560 / 1120 px (l'original peut peser plusieurs Mo)
const heroImage = await getVehicleImage(slug, [560, 1120]);

const logoSlug = vehicle.brand.toLowerCase().replace('ë', 'e');
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*');
const logoPath = Object.keys(logos).find((path) => path.startsWith(`/src/assets/logos/${logoSlug}.`));
let BrandLogo;
if (logoPath) {
  BrandLogo = (await logos[logoPath]()).default;
}

const sources = getSources(vehicle.sources);
const sourceLabels: Record<string, string> = {};
for (const id of vehicle.sources) {
  const s = getSource(id);
  if (s) sourceLabels[id] = s.name;
}
for (const test of vehicle.rangeTests) {
  if (!sourceLabels[test.sourceId]) {
    const s = getSource(test.sourceId);
    if (s) sourceLabels[test.sourceId] = s.name;
  }
}

const categoryLabels: Record<string, string> = {
  securite: "Sécurité",
  technologie: "Technologie",
  confort: "Confort",
  design: "Design",
};
const featuresByCategory = vehicle.keyFeatures.reduce<Record<string, string[]>>((acc, f) => {
  if (!acc[f.category]) acc[f.category] = [];
  acc[f.category]!.push(f.label);
  return acc;
}, {});

const trustLabels: Record<TrustLevel, string> = {
  high: "Confiance haute",
  medium: "Confiance modérée",
  low: "Confiance basse",
};
const trustTone: Record<TrustLevel, "accent" | "warning" | "danger"> = {
  high: "accent",
  medium: "warning",
  low: "danger",
};

const confidenceLabel: Record<string, string> = {
  tested: "Mesurée",
  bjorn_nyland: "Mesurée (Nyland)",
  manufacturer: "Constructeur",
  estimated: "Estimée",
  pending: "En attente",
};

const tkc = vehicle.thousandKmChallenge;
const tkcHasData = tkc !== null && (tkc.totalTime_minutes !== null || tkc.averageSpeed_kmh !== null || tkc.averageConsumption_Wh_km !== null || tkc.chargingStops !== null);

// 1000 km challenge : situe ce modèle parmi tous les modèles mesurés.
// Nuage de points par tranche de 10 min, un point par modèle, empilés dans leur tranche.
const tkcField = (() => {
  const mine = tkc?.totalTime_minutes;
  const times = getAllVehicles()
    .map((v) => v.thousandKmChallenge?.totalTime_minutes)
    .filter((m): m is number => typeof m === "number")
    .sort((a, b) => a - b);
  if (mine == null || times.length < 10) return null;
  const BIN = 10;
  const first = Math.round(times[0]! / BIN);
  const span = Math.max(1, Math.round(times[times.length - 1]! / BIN) - first);
  const stacks = new Map<number, number>();
  let mineTaken = false;
  const dots = times.map((m) => {
    const bin = Math.round(m / BIN) - first;
    const level = stacks.get(bin) ?? 0;
    stacks.set(bin, level + 1);
    const isMine = !mineTaken && m === mine;
    if (isMine) mineTaken = true;
    return { x: bin / span, y: level, bin, isMine };
  });
  const rank = times.filter((m) => m < mine).length + 1;
  return {
    dots,
    rows: Math.max(...stacks.values()),
    n: times.length,
    rankLabel: rank === 1 ? "1er" : `${rank}e`,
    fastest: formatHours(times[0]! / 60),
    slowest: formatHours(times[times.length - 1]! / 60),
  };
})();
// Prime CEE sans profil fiscal : celle de tout ménage ; le plafond du barème sert aux « jusqu'à »
// (même barème partout : src/lib/cee.ts)
const totalAids = vehicle.availableAids.length > 0 ? primeFor(vehicle, "autres") : 0;
const ceeMax = primeFor(vehicle, "precarite");
// Production européenne (voiture et batterie) : confirmée = grille Europe, possible = signalée sans être déduite
const ceeEurope = europeStatus(vehicle);
const ceeCategories = (["autres", ...(grosRouleurOpen() ? ["gros_rouleur"] : []), "modeste", "precarite"] as const) as readonly ("autres" | "gros_rouleur" | "modeste" | "precarite")[];

const cheapestTrim = vehicle.trims.reduce((a, b) => a.price_EUR < b.price_EUR ? a : b);

// Calculateur d'impact de taille de jantes sur l'autonomie (C3)
const getWheelRangePenalty = (currentConfig: any, allConfigs: any[]) => {
  const sameBatteryTrim = allConfigs.filter(
    (c) => c.battery === currentConfig.battery && c.trim === currentConfig.trim
  );
  if (sameBatteryTrim.length <= 1) return null;
  
  const baseConfig = sameBatteryTrim.reduce((min, c) => 
    c.wheelSize_inches < min.wheelSize_inches ? c : min
  , sameBatteryTrim[0]);
  
  if (currentConfig.wheelSize_inches <= baseConfig.wheelSize_inches) return null;
  if (!currentConfig.wltp_km || !baseConfig.wltp_km) return null;
  
  const diff = baseConfig.wltp_km - currentConfig.wltp_km;
  if (diff <= 0) return null;
  
  const pct = Math.round((diff / baseConfig.wltp_km) * 100);
  return {
    pct,
    baseSize: baseConfig.wheelSize_inches,
    currentSize: currentConfig.wheelSize_inches
  };
};


// ═══ SEO : noms, textes et données structurées (cf. src/lib/seo.ts) ═══
const allVehicles = getAllVehicles();
const seoFacts = getVehicleSeoFacts(vehicle);
const vehicleName = getVehicleName(vehicle);
const marketStatus = getMarketStatus(vehicle);
const pageTitle = getVehicleTitle(vehicle);
const description = getVehicleDescription(vehicle);
const lead = getVehicleLead(vehicle);
const laVehicle = withArticle(vehicle);
const LaVehicle = withArticle(vehicle, true);
const deVehicle = withDe(vehicle);
const pronoun = isMasculine(vehicle) ? "il" : "elle";
const brand = getBrandByName(vehicle.brand);
const brandPath = `/marques/${brandSlug(vehicle.brand)}/`;
const alternatives = getAlternatives(vehicle, allVehicles, 4);
const otherBrandModels = (brand?.vehicles ?? []).filter((v) => v.slug !== vehicle.slug);
const relatedSelections = getCategoriesFor(vehicle, allVehicles);
const pageUrl = new URL(url(`/vehicules/${vehicle.slug}/`), Astro.site).toString();
const schemaImage = await getVehicleImageAbsolute(vehicle.slug, Astro.site);

const driveWheel: Record<string, string> = {
  FWD: "https://schema.org/FrontWheelDriveConfiguration",
  RWD: "https://schema.org/RearWheelDriveConfiguration",
  AWD: "https://schema.org/AllWheelDriveConfiguration",
};
const availabilityUrl: Record<string, string> = {
  available: "https://schema.org/InStock",
  preorder: "https://schema.org/PreOrder",
  upcoming: "https://schema.org/PreSale",
  discontinued: "https://schema.org/Discontinued",
};
const pricedVersions = [...vehicle.configurations.map((c) => c.price_EUR), ...vehicle.trims.map((t) => t.price_EUR)].filter(
  (p): p is number => p != null,
);
const qv = (value: number, unitCode: string) => ({ "@type": "QuantitativeValue", value, unitCode });
const notes = (items: string[]) => ({
  "@type": "ItemList",
  itemListElement: items.map((name, i) => ({ "@type": "ListItem", position: i + 1, name })),
});

// Car (sous-type de Product) : prix agrégés de la gamme + avis éditorial Evly (forces / faiblesses)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Car",
  "@id": `${pageUrl}#vehicule`,
  name: vehicleName,
  alternateName: getVehicleAliases(vehicle),
  url: pageUrl,
  ...(schemaImage ? { image: schemaImage } : {}),
  description: lead,
  brand: { "@type": "Brand", name: vehicle.brand },
  manufacturer: { "@type": "Organization", name: vehicle.brand },
  model: vehicle.model,
  vehicleConfiguration: vehicle.variant,
  bodyType: getBodyInfo(vehicle).noun,
  vehicleModelDate: vehicle.releaseYear.toString(),
  countryOfAssembly: vehicle.productionCountry,
  fuelType: "Electric",
  emissionsCO2: 0,
  vehicleTransmission: "Automatique (rapport unique)",
  driveWheelConfiguration: driveWheel[vehicle.drivetrain],
  vehicleEngine: {
    "@type": "EngineSpecification",
    engineType: "Moteur électrique",
    enginePower: qv(vehicle.power_kW, "KWT"),
    ...(vehicle.torque_Nm !== null ? { torque: qv(vehicle.torque_Nm, "NU") } : {}),
  },
  accelerationTime: qv(vehicle.acceleration_0_100_s, "SEC"),
  speed: { "@type": "QuantitativeValue", maxValue: vehicle.topSpeed_kmh, unitCode: "KMH" },
  cargoVolume: qv(vehicle.trunkCapacity_L, "LTR"),
  ...(vehicle.mass_kg ? { weightTotal: qv(vehicle.mass_kg, "KGM") } : {}),
  wheelbase: qv(vehicle.wheelbase_mm, "MMT"),
  fuelConsumption: { "@type": "QuantitativeValue", value: vehicle.consumption_mixed_kWh_per_100km, unitText: "kWh/100 km" },
  additionalProperty: [
    { "@type": "PropertyValue", name: `Autonomie réelle mixte (${seoFacts.rangeBestMeasured ? "mesurée" : "estimée"})`, value: seoFacts.rangeBest, unitCode: "KMT" },
    { "@type": "PropertyValue", name: "Autonomie WLTP", value: seoFacts.wltpMax, unitCode: "KMT" },
    { "@type": "PropertyValue", name: "Batterie utile", value: seoFacts.batteryMax, unitText: "kWh" },
    ...(seoFacts.dcMin != null ? [{ "@type": "PropertyValue", name: "Recharge rapide 10 → 80 %", value: seoFacts.dcMin, unitCode: "MIN" }] : []),
    { "@type": "PropertyValue", name: "Puissance de recharge DC maximale", value: seoFacts.dcPeak, unitCode: "KWT" },
  ],
  ...(pricedVersions.length > 0
    ? {
        offers: {
          "@type": "AggregateOffer",
          priceCurrency: "EUR",
          lowPrice: Math.min(...pricedVersions),
          highPrice: Math.max(...pricedVersions),
          offerCount: seoFacts.versions,
          availability: availabilityUrl[marketStatus],
          url: pageUrl,
        },
      }
    : {}),
  review: {
    "@type": "Review",
    name: `Avis Evly sur ${laVehicle}`,
    author: { "@type": "Organization", name: "Evly", url: Astro.site?.toString() },
    publisher: { "@id": `${Astro.site}#organization` },
    dateModified: vehicle.lastUpdated,
    reviewBody: `${vehicle.verdict.idealUserProfile} ${vehicle.verdict.notIdealFor}`,
    positiveNotes: notes(vehicle.verdict.strengths),
    negativeNotes: notes(vehicle.verdict.weaknesses),
  },
};

// FAQ générée depuis les données véhicule, en langage simple, pour les
// lecteurs qui ne s'y connaissent pas et pour les extraits enrichis Google.
const faqEntries: { question: string; answer: string }[] = [
  {
    question: `Quelle est l'autonomie réelle ${deVehicle} ?`,
    answer: `Dans un usage mixte (ville et route), comptez environ ${vehicle.realRange.mixed_km} km avant de devoir recharger${seoFacts.rangeBest > vehicle.realRange.mixed_km ? `, et jusqu'à ${seoFacts.rangeBest} km avec la plus grande batterie` : ""}. Sur autoroute à vitesse soutenue, l'autonomie tombe plutôt autour de ${vehicle.realRange.highway_130_km} km, et l'hiver, par temps froid, aux alentours de ${vehicle.realRange.winter_minus5_km} km. Ces chiffres viennent de tests ou d'estimations documentés, pas seulement du chiffre WLTP (${seoFacts.wltpMax} km au mieux) affiché en concession, souvent optimiste.`,
  },
  {
    question: `Combien de temps faut-il pour recharger ${laVehicle} ?`,
    answer:
      seoFacts.dcMin != null
        ? `Sur une borne rapide (recharge DC), il faut environ ${seoFacts.dcMin} minutes pour remonter de 10 à 80 % de batterie, le temps d'une pause. À la maison ou au travail sur une borne murale (recharge AC de ${vehicle.chargingAC.onboardCharger_kW} kW), comptez plutôt ${formatHours(vehicle.chargingAC.time_0_100_h)} pour une charge complète.`
        : `${LaVehicle} n'accepte pas la recharge rapide sur borne DC. Sur une prise ou une borne murale (recharge AC de ${vehicle.chargingAC.onboardCharger_kW} kW), une charge complète prend environ ${formatHours(vehicle.chargingAC.time_0_100_h)}.`,
  },
  {
    question: `Quel est le prix ${deVehicle} avec les aides de l'État ?`,
    answer:
      seoFacts.priceMin != null && seoFacts.priceAfterAids != null
        ? `Le prix affiché part de ${formatPrice(seoFacts.priceMin)}. Avec le coup de pouce CEE, il passe à ${formatPrice(seoFacts.priceAfterAids)} pour tout ménage et peut descendre jusqu'à ${formatPrice(seoFacts.priceAfterAidsMax!)} pour un ménage en précarité (montants indicatifs, ${CEE_GRID_LABEL}).${ceeEurope === "possible" ? " Elle est plus élevée si la voiture et sa batterie sont produites en Europe, ce qui reste à confirmer pour ce modèle." : ""} La prime n'est pas automatique : il faut en faire la demande avant de signer le bon de commande.`
        : seoFacts.priceMin != null
          ? `Le prix affiché part de ${formatPrice(seoFacts.priceMin)}${seoFacts.priceMax && seoFacts.priceMax > seoFacts.priceMin ? ` et monte à ${formatPrice(seoFacts.priceMax)}` : ""}, hors options. ${LaVehicle} n'ouvre pas droit au coup de pouce CEE (score environnemental, prix ou masse hors plafond) : le prix catalogue est le prix réel.`
          : `Le tarif de ce modèle n'est pas encore communiqué par le constructeur en France.`,
  },
  ...(seoFacts.leasingMin != null
    ? [
        {
          question: `${LaVehicle} est-${pronoun} éligible au leasing social ?`,
          answer: `Oui, ${laVehicle} figure parmi les modèles du leasing social, à partir de ${seoFacts.leasingMin} € par mois au barème ${new Date().getFullYear()}, pour les ménages sous conditions de revenus. Les places sont limitées et le premier loyer est pris en charge.`,
        },
      ]
    : []),
  {
    question: `Où est ${agree(vehicle, "fabriqué")} ${laVehicle} ?`,
    answer: `${LaVehicle} est ${agree(vehicle, "fabriqué")} ${inCountry(vehicle.productionCountry)}${vehicle.productionCountry === "France" ? ", ce qui en fait l'un des modèles électriques produits sur le sol français" : ""}.`,
  },
  {
    question: `Quelle est la taille du coffre ${deVehicle} ?`,
    answer: `Le coffre ${deVehicle} offre ${vehicle.trunkCapacity_L} litres, et ${vehicle.trunkCapacityFolded_L} litres une fois la banquette rabattue${vehicle.frunkCapacity_L ? `. Un coffre avant de ${vehicle.frunkCapacity_L} litres permet de ranger les câbles de recharge` : ""}.`,
  },
  {
    question: `Quelle est la garantie de la batterie ${deVehicle} ?`,
    answer: `La batterie est garantie ${vehicle.warranty.battery_years} ans ou ${formatNumber(vehicle.warranty.battery_km)} km, avec au moins ${vehicle.warranty.battery_soh_minimum_percent} % de sa capacité d'origine. Le reste du véhicule est garanti ${vehicle.warranty.vehicle_years} ans ou ${formatNumber(vehicle.warranty.vehicle_km)} km${vehicle.warranty.vehicle_condition ? `, ${vehicle.warranty.vehicle_condition}` : ""}.`,
  },
  {
    question: `Pour qui est ${agree(vehicle, "fait")} ${laVehicle} ?`,
    answer: vehicle.verdict.idealUserProfile,
  },
];

if (vehicle.verdict.notIdealFor) {
  faqEntries.push({
    question: `Quand vaut-il mieux éviter ${laVehicle} ?`,
    answer: vehicle.verdict.notIdealFor,
  });
}

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqEntries.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const pageJsonLd = [jsonLd, faqJsonLd];

// Ensure we have at least one configuration to map over, fallback to a dummy one if empty to not break existing vehicles
const configurations = vehicle.configurations.length > 0 ? vehicle.configurations : [{
  id: "default",
  label: vehicle.variant,
  battery: "standard",
  trim: vehicle.trims[0]?.name ?? "Standard",
  wheelSize_inches: 18,
  tyreType: "summer",
  options: [],
  price_EUR: cheapestTrim.price_EUR,
  monthlyLease_EUR: vehicle.leasingSocial_EUR_per_month,
  leasingSocialEligible: vehicle.leasingSocialEligible,
  wltp_km: vehicle.wltp_max_km,
  wltp_consumption_kWh_100km: vehicle.consumption_mixed_kWh_per_100km,
  realRange: vehicle.realRange,
  rangeTests: vehicle.rangeTests,
  chargingDC_peak_kW: vehicle.chargingDC.peakPower_kW,
  chargingDC_10_80_min: vehicle.chargingDC.time_10_80_min,
  chargingDC_kWh_30min: vehicle.chargingDC.kWh_added_30min,
  chargingCurve: vehicle.chargingCurve,
  availability: "available",
  notes: null
} as any];


const drivetrainLabels: Record<string, string> = {
  FWD: "Traction",
  RWD: "Propulsion",
  AWD: "Intégrale",
};

const fmtKwh = (value: number) => `${formatNumber(value, Number.isInteger(value) ? 0 : 1)} kWh`;

// Valeurs dérivées par configuration, partagées par toutes les sections de la fiche
const configViews = configurations.map((config) => {
  const nyland90 = config.rangeTests.find((t: any) => t.protocol === "nyland" && t.speed_kmh === 90);
  const wheelPenalty = getWheelRangePenalty(config, vehicle.configurations);

  let batteryCapacity = config.usableCapacity_kWh;
  if (batteryCapacity == null) {
    const labelMatch = config.label?.match(/(\d+(?:\.\d+)?)\s*kWh/);
    if (labelMatch) {
      batteryCapacity = parseFloat(labelMatch[1]);
    } else {
      const trimMatch = config.trim?.match(/(\d+(?:\.\d+)?)\s*kWh/);
      if (trimMatch) {
        batteryCapacity = parseFloat(trimMatch[1]);
      } else {
        const parseKwh = (s: string) => {
          const m = s.match(/(\d+(?:[.,]\d+)?)/);
          return m ? Math.round(parseFloat(m[1].replace(",", "."))) : null;
        };
        const uniqueKwh = [
          ...new Set(
            vehicle.trims
              .map((t) => parseKwh(t.batteryUsed))
              .filter((v): v is number => v !== null)
          ),
        ].sort((a, b) => a - b);
        const maxKwh = uniqueKwh.length > 0 ? Math.max(...uniqueKwh) : vehicle.usableCapacity_kWh;
        const minKwh = uniqueKwh.length > 0 ? Math.min(...uniqueKwh) : vehicle.usableCapacity_kWh;
        batteryCapacity = config.battery === "long-range" ? maxKwh : minKwh;
      }
    }
  }

  const nyland120 = config.rangeTests.find((t: any) => t.protocol === "nyland" && t.speed_kmh === 120);
  const aidsEligible = totalAids > 0 && isVehicleEligibleCEE(vehicle, config.price_EUR);
  const priceAfterAids = config.price_EUR != null && aidsEligible ? Math.max(0, config.price_EUR - totalAids) : null;
  const priceAfterAidsMax = config.price_EUR != null && aidsEligible ? Math.max(0, config.price_EUR - ceeMax) : null;
  const realRange = config.realRange ?? vehicle.realRange;
  const rangeConfidence = realRange.confidence;
  const isRangeMeasured = rangeConfidence === "tested" || rangeConfidence === "bjorn_nyland";
  const heroRangeLabel = rangeConfidence === "bjorn_nyland"
    ? "Autonomie réelle mixte, mesurée par Bjørn Nyland"
    : isRangeMeasured
      ? "Autonomie réelle mixte mesurée"
      : rangeConfidence === "manufacturer"
        ? "Autonomie mixte, donnée constructeur"
        : "Autonomie réelle mixte estimée";
  const wltpKm = config.wltp_km ?? vehicle.wltp_max_km;
  const wltpGapPct = Math.round((1 - realRange.mixed_km / wltpKm) * 100);
  const winterLossPct = Math.round((1 - realRange.winter_minus5_km / realRange.mixed_km) * 100);
  const dcMin = config.chargingDC_10_80_min ?? vehicle.chargingDC.time_10_80_min;
  const dcPeak = config.chargingDC_peak_kW ?? vehicle.chargingDC.peakPower_kW;
  const dcKwh30 = config.chargingDC_kWh_30min ?? vehicle.chargingDC.kWh_added_30min;
  const dcConfidence = config.chargingDC_confidence ?? vehicle.chargingDC.confidence;
  const consoMixed = config.wltp_consumption_kWh_100km ?? vehicle.consumption_mixed_kWh_per_100km;
  const rangeTests = config.rangeTests.length > 0 ? config.rangeTests : vehicle.rangeTests;

  const specGroups: { title: string; rows: [string, string][] }[] = [
    {
      title: "Motorisation",
      rows: [
        ["Puissance", `${config.power_hp ?? vehicle.power_hp} ch (${config.power_kW ?? vehicle.power_kW} kW)`],
        ["Couple", formatNm(config.torque_Nm ?? vehicle.torque_Nm)],
        ["Transmission", `${drivetrainLabels[vehicle.drivetrain] ?? vehicle.drivetrain} · ${vehicle.motors} moteur${vehicle.motors > 1 ? "s" : ""}`],
        ["0 → 100 km/h", formatSeconds(config.acceleration_0_100_s ?? vehicle.acceleration_0_100_s)],
        ["Vitesse max", `${config.topSpeed_kmh ?? vehicle.topSpeed_kmh} km/h`],
      ],
    },
    {
      title: "Batterie & recharge",
      rows: [
        ["Capacité utile", fmtKwh(batteryCapacity)],
        ...(vehicle.grossCapacity_kWh ? [["Capacité brute", fmtKwh(vehicle.grossCapacity_kWh)] as [string, string]] : []),
        ["Chimie", vehicle.chemistry],
        ["Architecture", `${vehicle.architecture_V} V`],
        ["Pic DC", `${dcPeak} kW`],
        ["Chargeur AC", `${formatNumber(vehicle.chargingAC.onboardCharger_kW, Number.isInteger(vehicle.chargingAC.onboardCharger_kW) ? 0 : 1)} kW · ${vehicle.chargingAC.phases} phase${vehicle.chargingAC.phases > 1 ? "s" : ""}`],
      ],
    },
    {
      title: "Dimensions & poids",
      rows: [
        ["Longueur", formatMm(vehicle.length_mm)],
        ["Largeur", formatMm(vehicle.width_mm)],
        ["Hauteur", formatMm(vehicle.height_mm)],
        ["Empattement", formatMm(vehicle.wheelbase_mm)],
        ...(vehicle.mass_kg ? [["Poids", `${formatNumber(vehicle.mass_kg)} kg`] as [string, string]] : []),
        ["Cx aéro", formatNumber(vehicle.dragCoefficient_Cx, 2)],
      ],
    },
    {
      title: "Pratique & garantie",
      rows: [
        ["Coffre", formatLiters(vehicle.trunkCapacity_L)],
        ["Coffre rabattu", formatLiters(vehicle.trunkCapacityFolded_L)],
        ...(vehicle.frunkCapacity_L ? [["Coffre avant", formatLiters(vehicle.frunkCapacity_L)] as [string, string]] : []),
        ["Garantie véhicule", `${vehicle.warranty.vehicle_years} ans / ${formatNumber(vehicle.warranty.vehicle_km)} km${vehicle.warranty.vehicle_condition ? `, ${vehicle.warranty.vehicle_condition}` : ""}`],
        ["Garantie batterie", `${vehicle.warranty.battery_years} ans / ${formatNumber(vehicle.warranty.battery_km)} km · ${vehicle.warranty.battery_soh_minimum_percent} % SoH`],
        ["Production", `${vehicle.assemblyPlant}, ${vehicle.productionCountry}`],
        ["Disponibilité", `${vehicle.marketAvailability} (${vehicle.releaseYear})`],
      ],
    },
  ];

  return {
    config,
    nyland90,
    wheelPenalty,
    batteryCapacity,
    nyland120,
    priceAfterAids,
    priceAfterAidsMax,
    aidsEligible,
    realRange,
    rangeConfidence,
    isRangeMeasured,
    heroRangeLabel,
    wltpKm,
    wltpGapPct,
    winterLossPct,
    dcMin,
    dcPeak,
    dcKwh30,
    dcConfidence,
    consoMixed,
    rangeTests,
    specGroups,
  };
});

// Règle d'autonomie : échelle commune à toutes les versions de la fiche (place pour l'étiquette WLTP)
const railScale = Math.ceil((Math.max(...configViews.map((cv) => cv.wltpKm)) * 1.18) / 100) * 100;

// Panneau « Pour votre trajet » : données de chaque version, consommation réelle déduite de l'autonomie mesurée
const tripData = Object.fromEntries(
  configViews.map((cv) => [
    cv.config.id,
    {
      winter: cv.realRange.winter_minus5_km,
      real: cv.realRange.mixed_km,
      conso: Math.round((cv.batteryCapacity / cv.realRange.mixed_km) * 1000) / 10,
      dcMin: cv.dcMin,
    },
  ])
);
const tripRates = {
  home: TCO_DEFAULTS.elec_home_eur_kwh,
  fast: TCO_DEFAULTS.elec_fast_eur_kwh,
  fuel: TCO_DEFAULTS.essence_eur_l,
  fuelConso: TCO_DEFAULTS.ice_conso_l_100,
};

const hasVerdict = vehicle.verdict.strengths.length > 0 || vehicle.verdict.weaknesses.length > 0;

// Sommaire collant de la fiche (ordre = ordre de lecture)
const tocSections = [
  ...(hasVerdict ? [{ id: "verdict", label: "Verdict" }] : []),
  { id: "autonomie", label: "Autonomie" },
  { id: "recharge", label: "Recharge" },
  { id: "prix", label: "Prix & aides" },
  { id: "fiche-technique", label: "Fiche technique" },
  { id: "sources", label: "Tests & sources" },
  { id: "faq", label: "Questions" },
  { id: "alternatives", label: "Alternatives" },
];

// Un seul <h1> par page : celui de la configuration affichée par défaut
const headingFor = (index: number): { Tag: "h1" | "p"; attrs: Record<string, string | number> } =>
  index === 0 ? { Tag: "h1", attrs: {} } : { Tag: "p", attrs: { role: "heading", "aria-level": 1 } };

// Le libellé de configuration répète souvent le modèle (« 5 E-Tech Five · 36,5 kWh ») : on ne garde que la suite
const configSubtitle = (label: string) => {
  const rest = label.startsWith(vehicle.model) ? label.slice(vehicle.model.length).replace(/^[\s·,-]+/, "") : label;
  return rest || label;
};

---

<BaseLayout
  title={pageTitle}
  description={description}
  jsonLd={pageJsonLd}
  ogImage={`/og/vehicules/${vehicle.slug}.jpg`}
  ogImageAlt={`${vehicleName} : autonomie réelle, prix et recharge`}
  ogType="article"
  modifiedTime={vehicle.lastUpdated}
>
  <!-- Fil d'ariane -->
  <div class="container-edit pt-2 md:pt-3 fade-rise flex items-center gap-x-4 gap-y-1 flex-wrap">
    <!-- Affiché uniquement si l'on arrive depuis le catalogue (cf. script en bas de page) -->
    <a href={url("/vehicules/")} id="catalog-back-link" class="back-to-list" hidden>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Retour à la liste
    </a>
    <Breadcrumbs
      items={[
        { label: "Accueil", path: "/" },
        { label: "Véhicules", path: "/vehicules/" },
        { label: vehicle.brand, path: brandPath },
        { label: vehicleName },
      ]}
    />
  </div>

  <div class="vehicle-page pt-2 pb-8 md:pt-3 md:pb-12">
    <!-- Main content -->
    <div class="vehicle-main">
      {vehicle.configurations.length > 1 && (
        <div class="mb-3 fade-rise xl:hidden">
          <VehicleConfigSelector client:idle vehicle={vehicle} />
        </div>
      )}

      <!-- ═══ 1. Identité + l'essentiel en 10 secondes ═══ -->
      <BentoGrid>
        {configViews.map((cv, index) => (
          <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
            <Tile size="full" variant="elevated" class="md:!p-7 lg:!p-8 !overflow-visible">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
                <!-- Gauche : identité + autonomie -->
                <div class="lg:col-span-6 flex flex-col gap-4 min-w-0">
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 fade-rise">
                    <span class="label-eyebrow">{vehicle.segment}</span>
                    <span class="label-eyebrow">{vehicle.bodyType}</span>
                    <span class="label-eyebrow">{vehicle.drivetrain} · {vehicle.architecture_V} V</span>
                    {cv.config.leasingSocialEligible && <Tag tone="accent" mono>Leasing social</Tag>}
                  </div>

                  {/*
                    Un seul vrai <h1> (configuration affichée par défaut) : les autres configurations,
                    masquées, portent un titre ARIA. Le logo est dans le titre, son alt donne la marque :
                    le titre se lit « Renault 5 E-Tech ».
                  */}
                  {(() => {
                    const { Tag: Heading, attrs: headingAttrs } = headingFor(index);
                    return (
                      <Heading class="flex flex-col gap-2" {...headingAttrs}>
                        {BrandLogo ? (
                          <span class="h-5 md:h-6 fade-rise fade-rise-delay-1 flex items-start">
                            <img src={typeof BrandLogo === 'string' ? BrandLogo : BrandLogo.src} alt={vehicle.brand} class="h-full w-auto object-contain brand-logo" />
                          </span>
                        ) : (
                          <span class="font-mono text-xs md:text-sm text-[var(--color-text-muted)] fade-rise fade-rise-delay-1">{vehicle.brand}</span>
                        )}
                        <span class="display-1 block fade-rise fade-rise-delay-1">
                          {vehicle.model}
                          <span class="block text-[var(--color-text-muted)] mt-1 text-[0.5em] tracking-[-0.01em] font-medium">
                            {configSubtitle(cv.config.label)}
                          </span>
                        </span>
                      </Heading>
                    );
                  })()}

                  <div class="flex flex-col gap-1.5 mt-1" data-hint-group>
                    <div class="stat-hint" tabindex="0" aria-describedby={`hint-range-${cv.config.id}`}>
                      <div class="flex items-center gap-2">
                        <span class="label-eyebrow inline-flex items-center gap-1.5">{cv.heroRangeLabel}<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></span>
                        {cv.nyland90 && <SourceTooltip sourceId="nyland" date={cv.nyland90.testDate ?? undefined} />}
                      </div>
                      <div class="flex items-baseline gap-3 mt-1.5">
                        <span data-numeric class="display-stat text-[var(--color-accent)] text-[clamp(3.5rem,11vw,7rem)] leading-[0.85] soh-update-range" data-base-range={cv.realRange.mixed_km}>
                          {cv.realRange.mixed_km}
                        </span>
                        <span class="font-mono text-xl md:text-2xl text-[var(--color-text-faint)]">km</span>
                      </div>
                      <div class="stat-hint-detail" id={`hint-range-${cv.config.id}`}>
                        <span>
                        {cv.nyland90 && cv.nyland120 && cv.rangeConfidence === "bjorn_nyland" ? (
                          <span>
                            Moyenne des essais Nyland à 90 km/h ({cv.nyland90.range_km} km, {formatNumber(cv.nyland90.consumption_kWh_100km, 1)} kWh/100&nbsp;km) et 120 km/h ({cv.nyland120.range_km} km, {formatNumber(cv.nyland120.consumption_kWh_100km, 1)} kWh/100&nbsp;km){cv.nyland90.temperature_C !== null ? `, par ${cv.nyland90.temperature_C} °C` : ""}. WLTP annoncée <span class="soh-update-text-wltp font-semibold" data-base-wltp={cv.wltpKm}>{cv.wltpKm}</span> km.
                          </span>
                        ) : (
                          <span>
                            Conso mixte {formatNumber(cv.consoMixed, 1)} kWh/100&nbsp;km, WLTP annoncée <span class="soh-update-text-wltp font-semibold" data-base-wltp={cv.wltpKm}>{cv.wltpKm}</span> km
                          </span>
                        )}
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 mt-1 flex-wrap">
                      <Tag tone="warning" mono>{cv.wltpGapPct > 0 ? `-${cv.wltpGapPct} %` : cv.wltpGapPct < 0 ? `+${-cv.wltpGapPct} %` : "="} vs WLTP</Tag>
                      <Tag tone="danger" mono>-{cv.winterLossPct} % en hiver (-5 °C)</Tag>
                      {cv.wheelPenalty && (
                        <span class="font-mono text-[11px] text-[var(--color-text-faint)]">
                          (dont -{cv.wheelPenalty.pct} % jantes {cv.wheelPenalty.currentSize}")
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Droite : photo + chiffres clés -->
                <div class="lg:col-span-6 flex flex-col gap-5 min-w-0">
                  {heroImage && (
                    <div class="vehicle-hero-photo pointer-events-none">
                      <img
                        src={heroImage.src}
                        srcset={heroImage.srcset || undefined}
                        sizes="(min-width: 1024px) 560px, 100vw"
                        width={heroImage.width}
                        height={heroImage.height}
                        alt={`${vehicleName} électrique, ${configSubtitle(cv.config.label)}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : undefined}
                        decoding={index === 0 ? undefined : "async"}
                        class="w-full max-w-[560px] max-h-[260px] h-auto object-contain vehicle-hero-img"
                      />
                    </div>
                  )}

                  <!--
                    L'essentiel. Sur grand écran, prix et leasing sont déjà dans la sidebar :
                    on les remplace par puissance et garantie batterie pour éviter les doublons.
                  -->
                  <dl class="stat-hints pt-4 border-t border-[var(--color-border)]" data-hint-group>
                    <div class="flex flex-col gap-0.5 xl:hidden stat-hint" tabindex="0" aria-describedby={`hint-prix-${cv.config.id}`}>
                      <dt class="label-eyebrow inline-flex items-center gap-1.5">Prix<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                      <dd data-numeric class="display-stat text-2xl">
                        {cv.config.price_EUR != null ? formatPrice(cv.config.price_EUR) : "NC"}
                      </dd>
                      <dd class="stat-hint-detail" id={`hint-prix-${cv.config.id}`}><span>
                        {cv.priceAfterAids != null && cv.priceAfterAidsMax != null
                          ? `Hors options. ${formatPrice(cv.priceAfterAids)} avec la prime CEE de tout ménage, jusqu'à ${formatPrice(cv.priceAfterAidsMax)} selon vos revenus.`
                          : "Hors options, avant aides."}
                      </span></dd>
                    </div>
                    <div class="flex flex-col gap-0.5 stat-hint" tabindex="0" aria-describedby={`hint-recharge-${cv.config.id}`}>
                      <dt class="label-eyebrow inline-flex items-center gap-1.5">Recharge 10 → 80 %<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                      <dd data-numeric class="display-stat text-2xl">{cv.dcMin}<span class="font-mono text-sm text-[var(--color-text-faint)] ml-1">min</span></dd>
                      <dd class="stat-hint-detail" id={`hint-recharge-${cv.config.id}`}><span>Sur borne rapide, pic à {cv.dcPeak} kW. À domicile (wallbox {vehicle.chargingAC.onboardCharger_kW} kW), 0 → 100 % en {formatHours(vehicle.chargingAC.time_0_100_h)}.</span></dd>
                    </div>
                    <div class="flex flex-col gap-0.5 stat-hint" tabindex="0" aria-describedby={`hint-coffre-${cv.config.id}`}>
                      <dt class="label-eyebrow inline-flex items-center gap-1.5">Coffre<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                      <dd data-numeric class="display-stat text-2xl">{vehicle.trunkCapacity_L}<span class="font-mono text-sm text-[var(--color-text-faint)] ml-1">L</span></dd>
                      <dd class="stat-hint-detail" id={`hint-coffre-${cv.config.id}`}><span>
                        {vehicle.trunkCapacityFolded_L} L sièges rabattus{vehicle.frunkCapacity_L ? `, +${vehicle.frunkCapacity_L} L de coffre avant` : ""}.
                      </span></dd>
                    </div>
                    <div class="hidden xl:flex flex-col gap-0.5 stat-hint" tabindex="0" aria-describedby={`hint-puissance-${cv.config.id}`}>
                      <dt class="label-eyebrow inline-flex items-center gap-1.5">Puissance<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                      <dd data-numeric class="display-stat text-2xl">{cv.config.power_hp ?? vehicle.power_hp}<span class="font-mono text-sm text-[var(--color-text-faint)] ml-1">ch</span></dd>
                      <dd class="stat-hint-detail" id={`hint-puissance-${cv.config.id}`}><span>{cv.config.power_kW ?? vehicle.power_kW} kW, {formatNm(cv.config.torque_Nm ?? vehicle.torque_Nm)}. 0 → 100 km/h en {formatSeconds(cv.config.acceleration_0_100_s ?? vehicle.acceleration_0_100_s)}.</span></dd>
                    </div>
                    {cv.config.leasingSocialEligible && cv.config.monthlyLease_EUR && (
                      <div class="flex flex-col gap-0.5 xl:hidden stat-hint" tabindex="0" aria-describedby={`hint-leasing-${cv.config.id}`}>
                        <dt class="label-eyebrow inline-flex items-center gap-1.5">Leasing social<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                        <dd data-numeric class="display-stat text-2xl text-[var(--color-accent)]">{cv.config.monthlyLease_EUR}<span class="font-mono text-sm text-[var(--color-text-faint)] ml-1">€/mois</span></dd>
                        <dd class="stat-hint-detail" id={`hint-leasing-${cv.config.id}`}><span>Barème 2026, sous conditions de revenus. 1<sup>er</sup> loyer pris en charge.</span></dd>
                      </div>
                    )}
                    <div tabindex="0" aria-describedby={`hint-garantie-${cv.config.id}`} class:list={["stat-hint flex-col gap-0.5", cv.config.leasingSocialEligible && cv.config.monthlyLease_EUR ? "hidden xl:flex" : "flex"]}>
                      <dt class="label-eyebrow inline-flex items-center gap-1.5">Garantie batterie<svg class="stat-hint-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path stroke-linecap="round" d="M12 11v5M12 8h.01" /></svg></dt>
                      <dd data-numeric class="display-stat text-2xl">{vehicle.warranty.battery_years}<span class="font-mono text-sm text-[var(--color-text-faint)] ml-1">ans</span></dd>
                      <dd class="stat-hint-detail" id={`hint-garantie-${cv.config.id}`}><span>{vehicle.warranty.battery_years} ans ou {formatNumber(vehicle.warranty.battery_km)} km, avec au moins {vehicle.warranty.battery_soh_minimum_percent} % de capacité garantie.</span></dd>
                    </div>
                  </dl>
                </div>

                <!-- La règle d'autonomie : hiver, réelle, promesse WLTP, et la semaine du visiteur -->
                <div class="lg:col-span-12 pt-2">
                  <RangeRail real={cv.realRange.mixed_km} wltp={cv.wltpKm} winter={cv.realRange.winter_minus5_km} scale={railScale} size="lg" annotate animate={index === 0} surface="var(--color-surface-elevated)" class="hero-rail no-glossary" />
                </div>
              </div>
            </Tile>
          </div>
        ))}
      </BentoGrid>

      <!-- Pour votre trajet : jours sans recharger, recharges, énergie (lib/trip, recalculé à chaque réglage) -->
      <section class="trip-panel no-glossary" aria-labelledby="trip-panel-title" data-trip-panel data-configs={JSON.stringify(tripData)} data-config={configurations[0]?.id} data-rates={JSON.stringify(tripRates)}>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          <div class="lg:col-span-4">
            <h2 id="trip-panel-title" class="font-display text-[26px] font-extrabold tracking-[-0.03em] leading-none flex items-center gap-2.5">
              <Route size={22} strokeWidth={2} className="text-[var(--color-accent)]" aria-hidden="true" />Pour votre trajet
            </h2>
            <label for="trip-km-fiche" class="mt-5 flex items-baseline justify-between gap-3">
              <span class="text-[14px] text-[var(--color-text-muted)]">Trajet quotidien, aller et retour</span>
              <output for="trip-km-fiche" class="font-display text-[26px] font-extrabold tracking-[-0.035em] text-[var(--color-accent)] whitespace-nowrap" data-trip-out>40 km</output>
            </label>
            <input id="trip-km-fiche" type="range" min="10" max="200" step="5" value="40" class="trip-range mt-2" data-trip-range />
            <label class="trip-toggle mt-4">
              <input type="checkbox" data-trip-home checked />
              <span class="trip-toggle-ui" aria-hidden="true"></span>
              <span class="text-[14px]">Je peux recharger chez moi</span>
            </label>
            <a href={url(`/ma-semaine/?v=${vehicle.slug}`)} class="week-cta mt-5" data-week-cta>
              <MapIcon size={18} strokeWidth={2} aria-hidden="true" />
              <span class="flex-1">
                <span class="block font-semibold leading-tight">Ma semaine en {vehicle.model}</span>
                <span class="block text-[12.5px] opacity-80 leading-snug">Sur la carte, depuis chez vous</span>
              </span>
              <ArrowRight size={16} strokeWidth={2.2} aria-hidden="true" />
            </a>
          </div>
          <dl class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-3" aria-live="polite">
            <div class="trip-out">
              <dt>Sans recharger</dt>
              <dd class="trip-out-value"><span class="tabular-nums" data-o-winter>0</span><span class="trip-out-unit" data-o-winter-u>jours en hiver</span></dd>
              <dd class="trip-out-sub" data-o-real>&nbsp;</dd>
            </div>
            <div class="trip-out">
              <dt>Recharges</dt>
              <dd class="trip-out-value"><span class="tabular-nums" data-o-charges>0</span><span class="trip-out-unit" data-o-charges-u>par semaine</span></dd>
              <dd class="trip-out-sub" data-o-charges-sub>&nbsp;</dd>
            </div>
            <div class="trip-out">
              <dt>Énergie par mois</dt>
              <dd class="trip-out-value"><span class="tabular-nums" data-o-cost>0</span><span class="trip-out-unit">€</span></dd>
              <dd class="trip-out-sub" data-o-cost-sub>&nbsp;</dd>
            </div>
          </dl>
        </div>
        <p class="trip-panel-foot">
          Calcul sur 21 jours de trajet par mois, avec la consommation réelle déduite de l'autonomie mesurée. Électricité à {formatNumber(tripRates.home, 2)}&nbsp;€/kWh à domicile ou {formatNumber(tripRates.fast, 2)}&nbsp;€/kWh sur borne rapide, essence à {formatNumber(tripRates.fuel, 2)}&nbsp;€/l pour {formatNumber(tripRates.fuelConso, 1)}&nbsp;l/100&nbsp;km.
          <a href={url(`/simulateur/?v=${vehicle.slug}`)} class="text-[var(--color-accent)] font-semibold underline underline-offset-2 hover:no-underline">Coût complet sur plusieurs années</a>
        </p>
      </section>

      <!-- Présentation en une phrase : ce que les chiffres ci-dessus ne disent pas (type, origine, gamme) -->
      <p class="vehicle-lead">{lead}</p>

      <!-- Actions mobiles / tablette (la sidebar les porte sur grand écran) -->
      <div class="xl:hidden mt-3 flex items-center gap-2">
        <FavoriteButton client:idle slug={vehicle.slug} size={16} className="sidebar-fav-btn" />
        <a
          href={url(`/comparer/?v=${vehicle.slug}:${configurations[0]?.id}`)}
          class="sidebar-cta flex-1"
          id="compare-link-mobile"
        >
          Comparer
        </a>
        <a
          href={url(`/simulateur/?v=${vehicle.slug}`)}
          class="sidebar-tco-btn flex-1"
          id="tco-simulator-link-mobile"
        >
          Coût réel (TCO)
        </a>
      </div>

      <!-- ═══ Sommaire collant ═══ -->
      <nav class="vehicle-toc" aria-label="Sections de la fiche">
        <ul>
          {tocSections.map((s) => (
            <li><a href={`#${s.id}`} data-toc-link={s.id}>{s.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- ═══ 2. Verdict (la valeur ajoutée d'Evly, avant les chiffres de détail) ═══ -->
      {hasVerdict && (
        <section id="verdict" class="vehicle-section" aria-labelledby="verdict-title">
          <header class="vehicle-section-head">
            <h2 id="verdict-title" class="vehicle-section-title">Verdict</h2>
            <p class="vehicle-section-sub">Notre avis indépendant : pour qui, et pour qui pas.</p>
          </header>
          <BentoGrid>
            <Tile size="full" class="reveal">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[var(--color-border)] rounded-lg overflow-hidden mb-5">
                <div class="bg-[var(--color-surface)] p-4 md:p-5 flex flex-col gap-2">
                  <h3 class="label-eyebrow text-[var(--color-accent)]">Pour qui</h3>
                  <p class="text-[var(--color-text)] text-base leading-relaxed">{vehicle.verdict.idealUserProfile}</p>
                </div>
                <div class="bg-[var(--color-surface)] p-4 md:p-5 flex flex-col gap-2">
                  <h3 class="label-eyebrow text-[var(--color-danger)]">Pas pour</h3>
                  <p class="text-[var(--color-text-muted)] text-base leading-relaxed">{vehicle.verdict.notIdealFor}</p>
                </div>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 bg-[var(--color-accent)] inline-block"></span>
                    <h3 class="label-eyebrow text-[var(--color-accent)]">Forces</h3>
                    <span data-numeric class="font-mono text-xs text-[var(--color-text-faint)] ml-auto">{vehicle.verdict.strengths.length.toString().padStart(2, "0")}</span>
                  </div>
                  <ol class="flex flex-col">
                    {vehicle.verdict.strengths.map((s, i) => (
                      <li class="py-2.5 border-b border-[var(--color-border)] last:border-0 flex gap-4">
                        <span data-numeric class="font-mono text-[11px] text-[var(--color-text-faint)] pt-1 w-6 shrink-0">{String(i + 1).padStart(2, "0")}</span>
                        <p class="text-[var(--color-text)] text-sm md:text-base leading-relaxed">{s}</p>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="flex flex-col gap-2">
                  <div class="flex items-center gap-3">
                    <span class="w-1.5 h-1.5 bg-[var(--color-danger)] inline-block"></span>
                    <h3 class="label-eyebrow text-[var(--color-danger)]">Faiblesses</h3>
                    <span data-numeric class="font-mono text-xs text-[var(--color-text-faint)] ml-auto">{vehicle.verdict.weaknesses.length.toString().padStart(2, "0")}</span>
                  </div>
                  <ol class="flex flex-col">
                    {vehicle.verdict.weaknesses.map((s, i) => (
                      <li class="py-2.5 border-b border-[var(--color-border)] last:border-0 flex gap-4">
                        <span data-numeric class="font-mono text-[11px] text-[var(--color-text-faint)] pt-1 w-6 shrink-0">{String(i + 1).padStart(2, "0")}</span>
                        <p class="text-[var(--color-text)] text-sm md:text-base leading-relaxed">{s}</p>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            </Tile>
          </BentoGrid>
        </section>
      )}

      <!-- ═══ 3. Autonomie ═══ -->
      <section id="autonomie" class="vehicle-section" aria-labelledby="autonomie-title">
        <header class="vehicle-section-head">
          <h2 id="autonomie-title" class="vehicle-section-title">Autonomie</h2>
          <p class="vehicle-section-sub">Selon l'usage, la saison et l'usure de la batterie.</p>
        </header>

        <!-- Simulateurs (sur grand écran, ils sont dans la sidebar) -->
        <div class="xl:hidden mb-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-4 flex flex-col gap-4">
          <SohSlider client:idle />
          <div class="border-t border-[var(--color-border)] border-dashed pt-4">
            <TemperatureSlider client:idle chemistry={vehicle.chemistry} heatPump={vehicle.heatPump} />
          </div>
        </div>

        <BentoGrid>
          {configViews.map((cv, index) => (
            <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
              <Tile size="full" variant="elevated" label="Autonomie par usage" class="reveal">
                <div class="flex items-center justify-between gap-3 -mt-2 mb-3">
                  <h3 class="font-display text-base md:text-lg font-semibold tracking-[-0.01em]">{cv.isRangeMeasured ? "Quatre profils calés sur les mesures" : "Quatre profils d'usage estimés"}</h3>
                  <Tag tone="outline" mono>{confidenceLabel[cv.rangeConfidence] ?? cv.rangeConfidence}</Tag>
                </div>
                <SeasonalRange client:visible urban={cv.realRange.urban_km} mixed={cv.realRange.mixed_km} highway={cv.realRange.highway_130_km} winter={cv.realRange.winter_minus5_km} wltp={cv.wltpKm} vehicleName={`${vehicle.brand} ${vehicle.model} ${cv.config.trim}`} />
              </Tile>

              <Tile size="1x1" label="Batterie utile" class="reveal">
                <div class="soh-update-capacity mt-auto" data-base-capacity={cv.batteryCapacity}>
                  <TileStat value={formatNumber(cv.batteryCapacity, Number.isInteger(cv.batteryCapacity) ? 0 : 1)} unit="kWh" size="xl" hint={`${vehicle.chemistry} · ${vehicle.architecture_V} V`} />
                </div>
              </Tile>

              <Tile size="1x1" label="WLTP annoncée" class="reveal">
                <TileStat value={cv.wltpKm.toString()} unit="km" size="xl" hint={`Réel : -${cv.wltpGapPct} % en usage mixte`} />
              </Tile>

              <Tile size="2x1" label="Consommation" class="reveal">
                <div class="grid grid-cols-3 gap-4 mt-auto">
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Mixte</span>
                    <span data-numeric class="display-stat text-2xl md:text-3xl">{formatNumber(cv.consoMixed, 1)}</span>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">kWh/100 km</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Autoroute</span>
                    <span data-numeric class="display-stat text-2xl md:text-3xl">{formatNumber(vehicle.consumption_highway_kWh_per_100km, 1)}</span>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">kWh/100 km</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Hiver</span>
                    <span data-numeric class="display-stat text-2xl md:text-3xl">{formatNumber(vehicle.consumption_winter_kWh_per_100km, 1)}</span>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">kWh/100 km</span>
                  </div>
                </div>
              </Tile>
            </div>
          ))}
        </BentoGrid>
      </section>

      <!-- ═══ 4. Recharge ═══ -->
      <section id="recharge" class="vehicle-section" aria-labelledby="recharge-title">
        <header class="vehicle-section-head">
          <h2 id="recharge-title" class="vehicle-section-title">Recharge</h2>
          <p class="vehicle-section-sub">Sur la route et à la maison.</p>
        </header>
        <BentoGrid>
          {configViews.map((cv, index) => (
            <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
              <Tile size={tkc ? "2x1" : "full"} variant="elevated" label="Recharge DC & AC" source={cv.dcConfidence === "tested" ? "nyland" : undefined} class="reveal">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-auto">
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">10 → 80 % DC</span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-2xl md:text-3xl text-[var(--color-accent)]">{cv.dcMin}</span>
                      <span class="font-mono text-xs text-[var(--color-text-faint)]">min</span>
                    </div>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">bornes rapides DC</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Pic DC</span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-2xl md:text-3xl">{cv.dcPeak}</span>
                      <span class="font-mono text-xs text-[var(--color-text-faint)]">kW</span>
                    </div>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">{vehicle.architecture_V} V</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">+30 min DC</span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-2xl md:text-3xl text-[var(--color-accent)]">+{Math.round((cv.dcKwh30 / cv.consoMixed) * 100)}</span>
                      <span class="font-mono text-xs text-[var(--color-text-faint)]">km</span>
                    </div>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">({cv.dcKwh30} kWh)</span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">0 → 100 % AC</span>
                    <div class="flex items-baseline gap-1">
                      <span data-numeric class="display-stat text-2xl md:text-3xl">{formatHours(vehicle.chargingAC.time_0_100_h)}</span>
                    </div>
                    <span class="font-mono text-[11px] text-[var(--color-text-faint)]">wallbox {vehicle.chargingAC.onboardCharger_kW} kW</span>
                  </div>
                </div>

                <div class="flex flex-wrap gap-2 mt-4">
                  <Tag tone={vehicle.v2l ? "accent" : "outline"} mono>V2L {vehicle.v2l ? (vehicle.v2l_option_EUR ? `option ${formatPrice(vehicle.v2l_option_EUR)}` : "oui") : "non"}</Tag>
                  <Tag tone={vehicle.v2g ? "accent" : "outline"} mono>V2G {vehicle.v2g ? "oui" : "non"}</Tag>
                  <Tag tone={vehicle.plugAndCharge ? "accent" : "outline"} mono>Plug & Charge {vehicle.plugAndCharge ? "oui" : "non"}</Tag>
                </div>

                <details class="group mt-3 pt-3 border-t border-[var(--color-border)]">
                  <summary class="cursor-pointer font-mono text-[11px] text-[var(--color-text-muted)] hover:text-[var(--color-text)] flex items-center justify-between transition-colors list-none select-none min-h-[36px]">
                    <span class="flex items-center gap-2">
                      <svg aria-hidden="true" class="w-3.5 h-3.5 text-[var(--color-accent)] transition-transform duration-200 group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                      Voir la courbe de puissance détaillée (kW / SoC)
                    </span>
                    <Tag tone="outline" mono>{confidenceLabel[cv.dcConfidence] ?? cv.dcConfidence}</Tag>
                  </summary>
                  <div class="pt-4">
                    {(cv.config.chargingCurve ?? vehicle.chargingCurve) ? (
                      <ChargingCurve client:visible curve={cv.config.chargingCurve ?? vehicle.chargingCurve!} peakPower_kW={cv.dcPeak} vehicleName={`${vehicle.brand} ${vehicle.model}`} />
                    ) : (
                      <p class="text-[var(--color-text-faint)] font-mono text-xs mt-2">Données non mesurées.</p>
                    )}
                  </div>
                </details>
              </Tile>

              {tkc && (
                <Tile size="2x1" variant={tkcHasData ? "accent" : "outlined"} label="1000 km challenge" source={tkc.sourceId} sourceDate={tkc.testDate ?? undefined} class="reveal">
                  <div class="flex items-center justify-between gap-3 -mt-2 mb-3">
                    <h3 class="font-display text-base md:text-lg font-semibold tracking-[-0.01em]">Protocole Nyland</h3>
                    <Tag tone={tkcHasData ? "accent" : "warning"} mono>{confidenceLabel[tkc.confidence] ?? tkc.confidence}</Tag>
                  </div>
                  {tkcField && (
                    <figure class="tkc-field" style={`--rows:${tkcField.rows}`}>
                      <figcaption class="tkc-field-head">
                        <span>Temps sur 1 000 km, {tkcField.n} modèles mesurés</span>
                        <span class="tkc-rank"><i class="tkc-key" aria-hidden="true" /><b>{tkcField.rankLabel}</b> sur {tkcField.n}</span>
                      </figcaption>
                      <div class="tkc-dots" aria-hidden="true">
                        {tkcField.dots.map((d) => (
                          <i class:list={["tkc-dot", d.isMine && "is-mine"]} style={`--x:${d.x};--y:${d.y};--c:${d.bin}`} />
                        ))}
                      </div>
                      <div class="tkc-axis" aria-hidden="true">
                        <span>{tkcField.fastest}, le plus rapide</span>
                        <span>le plus lent, {tkcField.slowest}</span>
                      </div>
                    </figure>
                  )}
                  {tkcHasData ? (
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-auto">
                      <div class="flex flex-col gap-1">
                        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Temps</span>
                        <span data-numeric class="display-stat text-2xl md:text-3xl">{tkc.totalTime_minutes != null ? formatHours(tkc.totalTime_minutes / 60) : "n/c"}</span>
                      </div>
                      <div class="flex flex-col gap-1">
                        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Vit. moy</span>
                        <span data-numeric class="display-stat text-2xl md:text-3xl">{tkc.averageSpeed_kmh != null ? formatNumber(tkc.averageSpeed_kmh, 1) : "n/c"}<span class="text-sm text-[var(--color-text-faint)] ml-1 font-mono">km/h</span></span>
                      </div>
                      <div class="flex flex-col gap-1">
                        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Conso</span>
                        <span data-numeric class="display-stat text-2xl md:text-3xl">{tkc.averageConsumption_Wh_km ?? "n/c"}<span class="text-sm text-[var(--color-text-faint)] ml-1 font-mono">Wh/km</span></span>
                      </div>
                      <div class="flex flex-col gap-1">
                        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Arrêts</span>
                        <span data-numeric class="display-stat text-2xl md:text-3xl text-[var(--color-accent)]">{tkc.chargingStops ?? "n/c"}</span>
                      </div>
                    </div>
                  ) : (
                    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">Test publié par {sourceLabels[tkc.sourceId] ?? tkc.sourceId}. Valeurs en cours de vérification, Evly s'interdit toute estimation à la place de la mesure.</p>
                  )}
                  {tkc.videoUrl && (
                    <a href={tkc.videoUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-[11px] text-[var(--color-accent)] hover:underline mt-3 self-start min-h-[44px] inline-flex items-center">Voir la vidéo source ↗</a>
                  )}
                </Tile>
              )}
            </div>
          ))}
        </BentoGrid>
      </section>

      <!-- ═══ 5. Prix & aides ═══ -->
      <section id="prix" class="vehicle-section" aria-labelledby="prix-title">
        <header class="vehicle-section-head">
          <h2 id="prix-title" class="vehicle-section-title">Prix & aides</h2>
          <p class="vehicle-section-sub">Du prix catalogue à ce que vous paierez vraiment.</p>
        </header>

        {vehicle.availableAids.length > 0 && (
          <div class="xl:hidden mb-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl p-4">
            <CeeSimulator client:visible vehicle={vehicle} />
          </div>
        )}

        <BentoGrid>
          {configViews.map((cv, index) => {
            const hasLeasing = cv.config.leasingSocialEligible && cv.config.monthlyLease_EUR;
            return (
              <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
                <Tile size={hasLeasing ? "3x1" : "full"} variant="accent" label="Prime CEE*" class="reveal">
                  {vehicle.availableAids.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mt-auto">
                      <ul class="md:col-span-7 flex flex-col gap-2">
                        {ceeCategories.map((cat) => (
                          <li class="flex items-baseline justify-between gap-3 text-sm">
                            <span class="text-[var(--color-text)]">
                              {HOUSEHOLD_LABELS[cat]}
                              <span class="block font-mono text-[10px] text-[var(--color-text-faint)]">{HOUSEHOLD_CONDITIONS[cat]}</span>
                            </span>
                            <span data-numeric class="font-mono text-[var(--color-accent)] whitespace-nowrap">- {formatPrice(primeFor(vehicle, cat))}</span>
                          </li>
                        ))}
                        {ceeEurope === "possible" && (
                          <li class="flex items-baseline justify-between gap-3 text-sm pt-2 border-t border-[var(--color-border)]">
                            <span class="text-[var(--color-text-muted)]">Si voiture et batterie sont produites en Europe (à confirmer)</span>
                            <span data-numeric class="font-mono text-[var(--color-text-muted)] whitespace-nowrap">jusqu'à - {formatPrice(PRIME_GRID.europe.precarite)}</span>
                          </li>
                        )}
                      </ul>
                      <div class="md:col-span-5 md:border-l md:border-[var(--color-border)] md:pl-6 flex flex-col gap-1">
                        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Prix net, tout ménage*</span>
                        {cv.priceAfterAids != null ? (
                          <>
                            <span data-numeric class="display-stat text-3xl md:text-4xl">{formatPrice(cv.priceAfterAids)}</span>
                            <span class="font-mono text-[11px] text-[var(--color-text-faint)]">au lieu de {formatPrice(cv.config.price_EUR!)} ; jusqu'à {formatPrice(cv.priceAfterAidsMax!)} pour un ménage en précarité.</span>
                          </>
                        ) : cv.config.price_EUR != null && !cv.aidsEligible ? (
                          <>
                            <span data-numeric class="display-stat text-3xl md:text-4xl">{formatPrice(cv.config.price_EUR)}</span>
                            <span class="font-mono text-[11px] text-[var(--color-text-faint)] leading-relaxed">
                              {cv.config.price_EUR > CEE_PRICE_CAP_EUR
                                ? `Cette version dépasse le plafond de ${formatPrice(CEE_PRICE_CAP_EUR)} : pas de prime CEE.`
                                : "Cette version n'est pas éligible à la prime CEE."}
                            </span>
                          </>
                        ) : (
                          <span class="font-mono text-sm text-[var(--color-text-faint)]">Prix non communiqué</span>
                        )}
                      </div>
                    </div>
                  ) : (
                    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mt-auto">
                      Aucune aide CEE applicable à ce modèle. Prix catalogue : <span class="font-semibold text-[var(--color-text)]">{cv.config.price_EUR != null ? formatPrice(cv.config.price_EUR) : "non communiqué"}</span>.
                    </p>
                  )}
                  <p class="mt-4 font-mono text-[11px] text-[var(--color-text-faint)] leading-relaxed">
                    * Montants indicatifs ({CEE_GRID_LABEL}). Depuis le 1er septembre 2026, la réglementation fixe un coefficient par catégorie (revenu fiscal de référence par part), pas un montant : la prime versée dépend de l'organisme qui la paie. Prime plus élevée quand la voiture et sa batterie sont produites en Europe{ceeEurope === "confirmed" ? ", ce qui est le cas ici selon le constructeur" : ""}. Version éco-scorée ADEME, sous 47 000 € TTC hors options et 2,4 t. Demande à faire avant la signature du bon de commande.
                  </p>
                </Tile>

                {hasLeasing && (
                  <Tile size="side" variant="accent" label="Leasing social" class="reveal">
                    <div class="flex flex-col gap-3 mt-auto">
                      <div class="flex items-baseline gap-2">
                        <span data-numeric class="display-stat text-4xl md:text-5xl text-[var(--color-accent)]">{cv.config.monthlyLease_EUR}</span>
                        <span class="font-mono text-sm text-[var(--color-text-muted)]">€/mois</span>
                      </div>
                      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed max-w-sm">
                        <span class="font-semibold text-[var(--color-text)]">Loyer plafonné</span> (barème 2026), sous conditions de revenus. 1<sup>er</sup> loyer pris en charge.
                      </p>
                      <a href={url("/leasing-social")} class="font-mono text-[11px] text-[var(--color-accent)] hover:underline self-start min-h-[32px] inline-flex items-center">Vérifier mon éligibilité ↗</a>
                    </div>
                  </Tile>
                )}
              </div>
            );
          })}

          <Tile size="full" label="Gamme & tarifs" class="reveal">
            <div class="overflow-x-auto -mx-5 md:-mx-7" tabindex="0" role="region" aria-label="Gamme et tarifs, tableau défilant">
              <table class="w-full text-sm min-w-[560px]">
                <thead>
                  <tr class="text-left border-b border-[var(--color-border)]">
                    <th class="label-eyebrow font-normal py-3 px-5 md:px-7">Finition</th>
                    <th class="label-eyebrow font-normal py-3 px-2">Batterie</th>
                    <th class="label-eyebrow font-normal py-3 px-2 text-right">Prix</th>
                    <th class="label-eyebrow font-normal py-3 px-5 md:px-7">Points forts</th>
                  </tr>
                </thead>
                <tbody>
                  {vehicle.trims.map((trim) => (
                    <tr class="border-b border-[var(--color-border)] last:border-0 row-hover transition-colors align-top">
                      <td class="py-3 px-5 md:px-7 text-[var(--color-text)] font-medium">{trim.name.replace(/\s*\d+([.,]\d+)?\s*kWh.*$/i, "").trim() || trim.name}</td>
                      <td class="py-3 px-2 font-mono tabular text-[var(--color-text-muted)] whitespace-nowrap">{trim.batteryUsed}</td>
                      <td class="py-3 px-2 text-right font-mono tabular text-[var(--color-text)] whitespace-nowrap">{trim.price_EUR != null ? formatPrice(trim.price_EUR) : "NC"}</td>
                      <td class="py-3 px-5 md:px-7 text-[var(--color-text-muted)] leading-relaxed">{trim.equipmentHighlights.slice(0, 3).join(" · ")}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Tile>
        </BentoGrid>
      </section>

      <!-- ═══ 6. Fiche technique ═══ -->
      <section id="fiche-technique" class="vehicle-section" aria-labelledby="fiche-technique-title">
        <header class="vehicle-section-head">
          <h2 id="fiche-technique-title" class="vehicle-section-title">Fiche technique</h2>
          <p class="vehicle-section-sub">Toutes les caractéristiques de la configuration choisie.</p>
        </header>
        <BentoGrid>
          {configViews.map((cv, index) => (
            <div data-config-id={cv.config.id} style={{ display: index === 0 ? "contents" : "none" }} class="config-wrapper">
              <Tile size="full" class="reveal">
