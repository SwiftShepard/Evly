<script>
  import { readTrip, onTripChange, paintRails, type Trip } from "@/lib/trip";
  import { tweenNumber } from "@/lib/tween";

  // Panneau « Pour votre trajet » et règles du hero : suivent le trajet, la version,
  // la santé de la batterie et la température choisies dans la barre latérale.
  function setupTripPanel() {
    const panel = document.querySelector<HTMLElement>("[data-trip-panel]");
    if (!panel || panel.dataset.ready) return;
    panel.dataset.ready = "true";
    const configs = JSON.parse(panel.dataset.configs || "{}") as Record<string, { winter: number; real: number; conso: number; dcMin: number }>;
    const rates = JSON.parse(panel.dataset.rates || "{}") as { home: number; fast: number; fuel: number; fuelConso: number };
    let configId = new URLSearchParams(location.search).get("config") || panel.dataset.config || Object.keys(configs)[0]!;
    let soh = 1;
    let temp = 1;
    const nf = new Intl.NumberFormat("fr-FR", { maximumFractionDigits: 0 });
    const days = (n: number) => `${n} jour${n > 1 ? "s" : ""}`;
    const set = (sel: string, text: string) => { const el = panel.querySelector(sel); if (el) el.textContent = text; };

    const render = (t: Trip = readTrip()) => {
      const c = configs[configId] ?? Object.values(configs)[0];
      if (!c) return;
      const winter = c.winter * soh;
      const real = c.real * soh * temp;
      const num = (sel: string, n: number) => { const el = panel.querySelector<HTMLElement>(sel); if (el) tweenNumber(el, n); };
      const dWinter = Math.floor(winter / t.dailyKm);
      num("[data-o-winter]", dWinter);
      set("[data-o-winter-u]", `${dWinter > 1 ? "jours" : "jour"} en hiver`);
      set("[data-o-real]", `${days(Math.floor(real / t.dailyKm))} le reste de l'année`);
      const week = t.dailyKm * 5;
      const perCharge = winter * (t.homeCharging ? 0.8 : 0.7);
      const perWeek = week / perCharge;
      if (perWeek < 0.75) {
        const weeks = Math.max(2, Math.round(1 / perWeek));
        num("[data-o-charges]", weeks);
        set("[data-o-charges-u]", "semaines entre deux");
      } else {
        const n = Math.ceil(perWeek);
        num("[data-o-charges]", n);
        set("[data-o-charges-u]", `fois par semaine`);
      }
      set("[data-o-charges-sub]", t.homeCharging ? "à la maison, la nuit, en hiver" : `sur borne rapide, ${c.dcMin} min de 10 à 80 %`);
      const km = t.dailyKm * 21;
      const cost = (km * c.conso) / 100 * (t.homeCharging ? rates.home : rates.fast);
      const fuel = (km * rates.fuelConso) / 100 * rates.fuel;
      num("[data-o-cost]", Math.round(cost));
      set("[data-o-cost-sub]", `contre ${nf.format(fuel)} € en essence`);

      // Règles du hero : santé et température appliquées, puis repère de la semaine
      document.querySelectorAll<HTMLElement>(".hero-rail").forEach((rail) => {
        const baseReal = Number(rail.dataset.baseReal ??= rail.dataset.real);
        const baseWinter = Number(rail.dataset.baseWinter ??= rail.dataset.winter);
        rail.style.setProperty("--real", String(Math.round(baseReal * soh * temp)));
        rail.style.setProperty("--winter", String(Math.round(Math.min(baseWinter * soh, baseReal * soh * temp))));
        rail.dataset.winter = String(Math.round(baseWinter * soh));
        // Les étiquettes de la règle suivent la santé de la batterie et la température
        const realLabel = rail.querySelector<HTMLElement>("[data-rail-real]");
        const winterLabel = rail.querySelector<HTMLElement>("[data-rail-winter]");
        if (realLabel) tweenNumber(realLabel, Math.round(baseReal * soh * temp));
        if (winterLabel) tweenNumber(winterLabel, Math.round(baseWinter * soh));
      });
      paintRails(t);
    };

    // « Ma semaine en … » ouvre la carte sur la version choisie ici
    const weekCta = panel.querySelector<HTMLAnchorElement>("[data-week-cta]");
    const syncWeekCta = () => {
      if (!weekCta) return;
      const target = new URL(weekCta.href);
      target.searchParams.set("config", configId);
      weekCta.href = target.toString();
    };
    syncWeekCta();

    window.addEventListener("config-changed", (e) => { configId = (e as CustomEvent).detail.configId; render(); syncWeekCta(); });
    window.addEventListener("soh-changed", (e) => { soh = (e as CustomEvent).detail.soh / 100; render(); });
    window.addEventListener("temperature-changed", (e) => { temp = (e as CustomEvent).detail.tempMultiplier ?? 1; render(); });
    const stop = onTripChange(render);
    document.addEventListener("astro:before-swap", stop, { once: true });
    render();
  }
  setupTripPanel();
  document.addEventListener("astro:page-load", setupTripPanel);
</script>

</BaseLayout>
