                            <td class="py-3 px-2 text-right font-mono tabular text-[var(--color-text-muted)] whitespace-nowrap">{test.speed_kmh ? `${test.speed_kmh} km/h` : "n/c"}</td>
                            <td class="py-3 px-2 text-right font-mono tabular text-[var(--color-accent)] whitespace-nowrap">{formatNumber(test.consumption_kWh_100km, 1)}</td>
                            <td class="py-3 px-2 text-right font-mono tabular text-[var(--color-text-muted)] whitespace-nowrap">{test.range_km ? `${test.range_km} km` : "n/c"}</td>
                            <td class="py-3 px-2 text-right font-mono tabular text-[var(--color-text-muted)] whitespace-nowrap">{test.temperature_C !== null ? `${test.temperature_C} °C` : "n/c"}</td>
                            <td class="py-3 px-5 md:px-7"><MethodologyBadge protocol={test.protocol} speed_kmh={test.speed_kmh} wheelSize_inches={test.wheelSize_inches} /></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </Tile>
              )}
            </div>
          ))}

          <Tile size="full" label="Sources & méthodologie" class="reveal">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-2">
              <div class="lg:col-span-4 flex flex-col gap-4">
                <h3 class="display-2 text-2xl md:text-3xl">Transparence</h3>
                <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">
                  Tests Nyland, supertests indépendants et fiche constructeur croisés. Chaque chiffre porte un niveau de confiance, <span class="font-mono text-[var(--color-accent)] text-xs">mesuré</span>, <span class="font-mono text-[var(--color-warning)] text-xs">constructeur</span>, <span class="font-mono text-[var(--color-text-muted)] text-xs">estimé</span> ou <span class="font-mono text-[var(--color-text-muted)] text-xs">en attente</span>.
                </p>
                <div class="flex flex-col gap-1 mt-2">
                  <span class="label-eyebrow">Dernière mise à jour</span>
                  <span class="font-mono text-sm text-[var(--color-text)]">{formatDate(vehicle.lastUpdated)}</span>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="label-eyebrow">Crédit photo</span>
                  <span class="font-mono text-xs text-[var(--color-text-muted)]">{vehicle.imageCredit}</span>
                </div>
                <a href={url("/methodologie") + "#sources"} class="font-mono text-xs text-[var(--color-accent)] hover:underline self-start min-h-[44px] inline-flex items-center">Méthodologie complète ↗</a>
              </div>
              <ol class="lg:col-span-8 flex flex-col">
                {sources.map((source, idx) => (
                  <li class:list={["py-4 grid grid-cols-12 gap-x-4 gap-y-2 items-baseline", idx !== sources.length - 1 && "border-b border-[var(--color-border)]"]}>
                    <span data-numeric class="col-span-1 font-mono text-xs text-[var(--color-text-faint)]">{String(idx + 1).padStart(2, "0")}</span>
                    <div class="col-span-12 md:col-span-7 flex flex-col gap-1">
                      <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--color-text)] text-base leading-snug hover:text-[var(--color-accent)] transition-colors min-h-[44px] inline-flex items-center">{source.name}</a>
                      <span class="font-mono text-[11px] text-[var(--color-text-faint)]">{new URL(source.url).hostname.replace(/^www\./, "")} · {source.type}</span>
                    </div>
                    <span class="col-span-12 md:col-span-4 md:text-right">
                      <Tag tone={trustTone[source.trustLevel]} mono>{trustLabels[source.trustLevel]}</Tag>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          </Tile>
        </BentoGrid>
