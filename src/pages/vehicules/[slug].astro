                    <th class="label-eyebrow font-normal py-3 px-5 md:px-7">Finition</th>
                    <th class="label-eyebrow font-normal py-3 px-2">Batterie</th>
                    <th class="label-eyebrow font-normal py-3 px-2 text-right">Prix</th>
                    <th class="label-eyebrow font-normal py-3 px-5 md:px-7">Points forts</th>
