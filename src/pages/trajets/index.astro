---
/**
 * Tous les grands trajets (roadmap M5) : un axe par carte, avec ce qui se cherche le plus (la
 * distance, combien de modèles passent sans arrêt, le plus rapide). Données de lib/roadTrips.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import BentoGrid from "@/components/ui/BentoGrid.astro";
import Tile from "@/components/ui/Tile.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import { TRIP_GROUPS, type TripGroup } from "@/data/trips";
import { costText, duration, getTripResults, iceTripCost, stopsText, tripCostMedian, tripTitle } from "@/lib/roadTrips";
import { formatKm, formatPrice } from "@/lib/format";
import { url } from "@/lib/url";
import { fitDescription } from "@/lib/seo";
import { ArrowRight } from "lucide-react";

const results = await getTripResults();
const groups = (Object.keys(TRIP_GROUPS) as TripGroup[])
  .map((g) => ({ key: g, label: TRIP_GROUPS[g], trips: results.filter((r) => r.axis.group === g) }))
  .filter((g) => g.trips.length > 0);
const models = results[0]?.rows.length ?? 0;

const description = fitDescription([
  `${results.length} grands trajets en voiture électrique, de Paris → Lyon aux stations de ski : ${models} modèles classés.`,
  "Arrêts sur les vraies bornes, été et hiver.",
]);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Grands trajets en voiture électrique",
  description,
  url: new URL(url("/trajets/"), Astro.site).toString(),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: results.length,
    itemListElement: results.map((r, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${tripTitle(r.axis)} en voiture électrique`,
      url: new URL(url(`/trajets/${r.axis.slug}/`), Astro.site).toString(),
    })),
  },
};
---

<BaseLayout title="Grands trajets en voiture électrique : arrêts et temps par modèle" description={description} jsonLd={jsonLd} ogImage="/og/pages/trajets.jpg">
  <div class="container-edit pt-2 md:pt-3 fade-rise">
    <Breadcrumbs items={[{ label: "Accueil", path: "/" }, { label: "Grands trajets" }]} />
  </div>

  <div class="container-edit pt-2 pb-8 md:pt-3 md:pb-12 flex flex-col gap-10">
    <BentoGrid>
      <Tile size="full" variant="elevated" class="md:!p-8">
        <span class="label-eyebrow fade-rise">Grands trajets · {results.length} itinéraires</span>
        <h1 class="display-2 mt-3 max-w-4xl fade-rise fade-rise-delay-1">Combien d'arrêts, et combien de temps ?</h1>
        <p class="mt-4 max-w-3xl text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed fade-rise fade-rise-delay-2">
          Les trajets des vacances et du ski, calculés pour les {models} modèles du catalogue : l'itinéraire réel, des arrêts posés sur
          de vraies bornes rapides, le temps de charge sur la courbe de chaque version, l'été et par -5 °C.
        </p>
        <a href={url("/ma-semaine/")} class="btn btn-secondary btn-sm mt-6 self-start fade-rise fade-rise-delay-2">
          Votre trajet, depuis chez vous <ArrowRight size={15} strokeWidth={2} className="btn-arrow" aria-hidden="true" />
        </a>
      </Tile>
    </BentoGrid>

    {groups.map((g) => (
      <section aria-labelledby={`g-${g.key}`}>
        <h2 id={`g-${g.key}`} class="section-title">{g.label}</h2>
        <ul class="tg-grid">
          {g.trips.map((r) => {
            const noStop = r.rows.filter((x) => x.summer.stops === 0).length;
            const fastest = r.rows[0];
            return (
              <li>
                <a href={url(`/trajets/${r.axis.slug}/`)} class="tg-card">
                  <span class="tg-title">{tripTitle(r.axis)}</span>
                  <span class="tg-meta tabular">{formatKm(Math.round(r.km))} · {duration(r.driveMin)} de route</span>
                  <span class="tg-line">
                    <b class="tabular">{noStop}</b> {noStop > 1 ? "modèles passent" : "modèle passe"} sans arrêt l'été
                  </span>
                  <span class="tg-line">Énergie de l'aller : <b class="tabular">{costText(tripCostMedian(r))}</b> en médiane, {formatPrice(Math.round(iceTripCost(r.km)))} en essence</span>
                  {fastest && (
                    <span class="tg-line">Le plus rapide : {fastest.name}, {duration(fastest.summer.totalMin)} ({stopsText(fastest.summer.stops)})</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .section-title { font-family: var(--font-display); font-size: clamp(1.375rem, 2.2vw, 1.75rem); font-weight: 600; letter-spacing: -0.022em; line-height: 1.15; margin-bottom: 0.75rem; }
  .tg-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.75rem; }
  @media (min-width: 640px) { .tg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .tg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .tg-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tg-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color 200ms ease, box-shadow 260ms var(--ease-out-expo), transform 260ms var(--ease-out-expo);
  }
  .tg-card:active { transform: scale(0.985); transition-duration: 120ms; }
  @media (hover: hover) and (pointer: fine) { .tg-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-md); } }
  .tg-title { font-family: var(--font-display); font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
  .tg-meta { font-size: 13px; color: var(--color-text-faint); }
  .tg-line { font-size: 13.5px; color: var(--color-text-muted); }
  .tg-line b { color: var(--color-accent); font-weight: 700; }
</style>
