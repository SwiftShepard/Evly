---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehicleImage from "@/components/ui/VehicleImage.astro";
import RangeRail from "@/components/ui/RangeRail.astro";
import TripStudio from "@/components/home/TripStudio.astro";
import TripMatches from "@/components/home/TripMatches.astro";
import HeroCars from "@/components/home/HeroCars.astro";
import { getAllVehicles, getVehicleBySlug } from "@/lib/vehicles";
import { getFleetGap, getMeasuredGap, type MeasuredGap } from "@/lib/rangeGap";
import { formatNumber } from "@/lib/format";
import { DEFAULTS as TCO_DEFAULTS } from "@/components/tco/TcoCalculator";
import { url } from "@/lib/url";
import { CEE_MAX_EUR } from "@/lib/cee";
import { ArrowRight, ArrowUpRight, ShieldCheck, FileSearch, Calculator, Scale } from "lucide-react";

const vehicles = getAllVehicles();
const totalVehicles = vehicles.length;
const totalTests = vehicles.reduce((sum, v) => sum + v.rangeTests.length, 0);
const fleetGap = getFleetGap(vehicles);

// Loyer le plus bas parmi les versions éligibles au leasing social
const leasingMin = Math.min(
  ...vehicles.flatMap((v) =>
    v.configurations.filter((c) => c.leasingSocialEligible && c.monthlyLease_EUR).map((c) => c.monthlyLease_EUR as number)
  )
);

// Coût de 100 km aux tarifs par défaut du calculateur TCO
const tcoExample = getVehicleBySlug("renault-5")!;
const evCost100 = tcoExample.consumption_mixed_kWh_per_100km * TCO_DEFAULTS.elec_home_eur_kwh;
const iceCost100 = TCO_DEFAULTS.ice_conso_l_100 * TCO_DEFAULTS.essence_eur_l;
const euros = (n: number) => `${formatNumber(n, 2)} €`;

// La preuve : modèles connus testés, du plus fidèle au plus optimiste
const PROOF_SLUGS = ["tesla-model-y", "mg-mg4", "tesla-model-3", "byd-dolphin", "vw-id3", "citroen-e-c3", "renault-5", "kia-ev3", "peugeot-e-208", "hyundai-kona"];
const proof = PROOF_SLUGS.map((s) => getVehicleBySlug(s))
  .filter((v) => v !== undefined)
  .map((v) => getMeasuredGap(v))
  .filter((g): g is MeasuredGap => g !== null)
  .sort((a, b) => a.gapPct - b.gapPct);
const PROOF_SCALE = Math.ceil(Math.max(...proof.map((g) => g.wltpKm)) / 100) * 100;

const pillars = [
  { icon: ShieldCheck, title: "100 % indépendant", text: "Aucune marque ne nous paie pour apparaître, aucune concession ne touche de commission sur vos clics. On peut donc vous dire franchement quand un modèle n'est pas terrible." },
  { icon: FileSearch, title: "Sources vérifiables", text: "Chaque chiffre affiché vient d'un essai réel sur route, d'un article de presse ou d'une fiche constructeur, et on vous dit toujours lequel, avec un lien." },
  { icon: Calculator, title: "Calculs expliqués", text: "Comment on mesure l'autonomie, comment on calcule le coût réel sur plusieurs années, comment on estime les aides : tout est expliqué en clair, pas de boîte noire." },
  { icon: Scale, title: "De votre côté", text: "Si un modèle déçoit à l'usage ou qu'un constructeur cache un chiffre gênant, on l'écrit. Notre objectif, c'est que vous en ayez pour votre argent, pas de vendre une voiture." },
];

const description = `Comparez les ${totalVehicles} voitures électriques du marché français : autonomie réelle mesurée, prix après aides et recharge. Indépendant, sans publicité ni commission.`;
---

<BaseLayout title="Comparateur de voitures électriques : autonomie réelle | Evly" description={description}>

  {/* ═════════ HERO : aplat olive ═════════ */}
  <section class="container-edit pt-3">
    <div class="hero-panel on-dark">
      <div class="hero-grid grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 relative z-10">
        <div class="lg:col-span-6 pt-2 md:pt-8 lg:pt-0 lg:pb-12 lg:self-center">
          {/* Le H1 porte la requête visée ; le slogan reste le titre visuel */}
          <h1 class="text-[14.5px] font-medium text-[var(--color-lime)] mb-6 fade-rise">Comparateur indépendant de voitures électriques</h1>
          <p class="display-1 text-[var(--color-accent-on)] fade-rise fade-rise-delay-1 !text-[clamp(2.9rem,6.2vw,5.9rem)]">
            L'électrique, enfin <span class="text-[var(--color-lime)]">clair.</span>
          </p>
          <p class="mt-7 text-[18px] text-[color-mix(in_srgb,var(--color-accent-on)_80%,transparent)] max-w-[40ch] leading-relaxed fade-rise fade-rise-delay-2">
            On mesure l'autonomie sur route, on calcule le vrai prix, et on vous dit franchement pour qui c'est fait.
          </p>
          <div class="mt-9 flex flex-col sm:flex-row gap-3 fade-rise fade-rise-delay-3">
            <a href={url("/recommandation/")} class="btn btn-lime h-[3.25rem] px-7 text-[16px]">
              Trouver mon VE <ArrowRight size={18} strokeWidth={2.25} className="btn-arrow" aria-hidden="true" />
            </a>
            <a href={url("/vehicules/")} class="btn btn-ghost-light h-[3.25rem] px-7 text-[16px]">Explorer le catalogue</a>
          </div>
        </div>
        <HeroCars class="lg:col-span-6" />
      </div>
    </div>
  </section>

  {/* ═════════ VOTRE TRAJET ═════════ */}
  <section class="container-edit mt-3">
    <TripStudio />
  </section>

  {/* ═════════ CE QUI COLLE À VOTRE TRAJET ═════════ */}
  <section class="container-edit mt-24 md:mt-32">
    <TripMatches />
  </section>

  {/* ═════════ LA PREUVE ═════════ */}
  <section class="container-edit mt-24 md:mt-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-5 px-1">
        <p class="font-display font-extrabold text-[clamp(7rem,15vw,12rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)]">
          <span data-count={Math.round(fleetGap.medianPct)}>{formatNumber(Math.round(fleetGap.medianPct))}</span><span class="text-[0.4em] align-top ml-1">%</span>
        </p>
        <h2 class="display-2 mt-6 max-w-[15ch]">d'autonomie en moins sur route, pour un modèle sur deux.</h2>
        <p class="mt-5 text-[16px] text-[var(--color-text-muted)] max-w-[46ch] leading-relaxed">
          Écart médian entre l'annonce WLTP et les essais réels, sur {fleetGap.models} modèles testés par Bjørn Nyland ou la presse VE. Evly met en avant l'autonomie réelle, et vous dit toujours d'où vient le chiffre.
        </p>
        <a href={url("/observatoire/")} class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-dim)]">
          L'observatoire, marque par marque <ArrowRight size={16} strokeWidth={2.25} className="arrow-animate" aria-hidden="true" />
        </a>
      </div>
      <div class="lg:col-span-7 proof-card no-glossary reveal">
        <div class="rail-legend mb-6">
          <span><i class="rail-key rail-key-winter"></i>Hiver</span>
          <span><i class="rail-key rail-key-real"></i>Réelle</span>
          <span><i class="rail-key rail-key-promise"></i>Promis, jamais parcouru</span>
          <span><i class="rail-key rail-key-need"></i>Votre semaine</span>
        </div>
        <ul class="flex flex-col gap-4">
          {proof.map((g, i) => {
            const winter = g.config.realRange?.winter_minus5_km ?? g.vehicle.realRange.winter_minus5_km;
            return (
              <li>
                <a href={url(`/vehicules/${g.vehicle.slug}/`)} class="proof-row group" aria-label={`${g.vehicle.brand} ${g.vehicle.model} : ${g.realKm} km mesurés sur route pour ${g.wltpKm} km annoncés, soit ${Math.round(g.gapPct)} % de moins.`}>
                  <span class="proof-name" aria-hidden="true">{g.vehicle.brand} {g.vehicle.model.replace(/ & .*$/, "")}</span>
                  <span class="proof-values" aria-hidden="true"><b>{g.realKm}</b> / {g.wltpKm} km</span>
                  <RangeRail real={g.realKm} wltp={g.wltpKm} winter={winter} scale={PROOF_SCALE} reveal index={i} class="proof-rail" />
                  <span class="proof-gap" aria-hidden="true">-{formatNumber(Math.round(g.gapPct))}&nbsp;%</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  {/* ═════════ OUTILS ═════════ */}
  <section class="container-edit mt-24 md:mt-32">
    <h2 class="display-2 mb-8 px-1">Comparer, chiffrer, décider.</h2>
    <div class="tools no-glossary">
      <a href={url("/comparer/")} class="tool tool-compare on-dark">
        <span class="tool-top"><span class="font-display text-[30px] font-extrabold tracking-[-0.03em]">Comparateur</span><ArrowUpRight size={22} strokeWidth={2} className="tool-arrow" aria-hidden="true" /></span>
        <span class="tool-compare-desc text-[15px] max-w-[32ch]">Jusqu'à 4 modèles côte à côte, batterie, finition et jantes comprises.</span>
        <span class="tool-cars" aria-hidden="true">
          <VehicleImage slug="peugeot-e-208" alt="" widths={[320, 640]} sizes="240px" class="w-full h-full" />
          <span class="vs font-display">vs</span>
          <VehicleImage slug="citroen-e-c3" alt="" widths={[320, 640]} sizes="240px" class="w-full h-full" />
        </span>
      </a>
      <a href={url("/simulateur/")} class="tool tool-tco">
        <span class="tool-top"><span class="font-display text-[30px] font-extrabold tracking-[-0.03em]">Coût réel</span><ArrowUpRight size={22} strokeWidth={2} className="tool-arrow" aria-hidden="true" /></span>
        <span class="mt-auto block">
          <span class="text-[14px] text-[var(--color-text-muted)]">100 km rechargés à la maison</span>
          <span class="mt-2 flex items-baseline gap-3"><span class="font-display text-[44px] font-extrabold tracking-[-0.04em] text-[var(--color-accent)]">{euros(evCost100)}</span><span class="text-[14px] text-[var(--color-text-muted)]">Renault 5</span></span>
          <span class="flex items-baseline gap-3"><span class="font-display text-[28px] font-extrabold tracking-[-0.03em] text-[var(--color-text-faint)] line-through decoration-2">{euros(iceCost100)}</span><span class="text-[14px] text-[var(--color-text-muted)]">essence, {formatNumber(TCO_DEFAULTS.ice_conso_l_100, 1)}&nbsp;l/100</span></span>
          <span class="block mt-3 text-[12px] text-[var(--color-text-faint)]">À {formatNumber(TCO_DEFAULTS.elec_home_eur_kwh, 2)}&nbsp;€/kWh et {formatNumber(TCO_DEFAULTS.essence_eur_l, 2)}&nbsp;€/l, réglables dans le calculateur.</span>
        </span>
      </a>
      <a href={url("/aides/")} class="tool tool-leasing">
        <span class="tool-top"><span class="font-display text-[30px] font-extrabold tracking-[-0.03em]">Aides 2026</span><ArrowUpRight size={22} strokeWidth={2} className="tool-arrow" aria-hidden="true" /></span>
        <span class="mt-auto block">
          <span class="text-[14px] text-[color-mix(in_srgb,var(--color-accent-on)_75%,transparent)]">Prime CEE jusqu'à</span>
          <span class="block font-display text-[56px] font-extrabold tracking-[-0.05em] leading-none text-[var(--color-lime)]">{formatNumber(CEE_MAX_EUR)}&nbsp;€</span>
          <span class="block mt-2 text-[14px] text-[color-mix(in_srgb,var(--color-accent-on)_75%,transparent)]">Et le leasing social dès {leasingMin}&nbsp;€/mois, sans apport, selon vos revenus.</span>
        </span>
      </a>
    </div>
  </section>

  {/* ═════════ INDÉPENDANCE ═════════ */}
  <section class="container-edit mt-24 md:mt-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4 px-1">
        <h2 class="display-2 max-w-[12ch]">Aucune marque ne nous paie.</h2>
        <dl class="mt-8 grid grid-cols-2 gap-4">
          <div><dt class="text-[13px] text-[var(--color-text-faint)]">Modèles suivis</dt><dd class="font-display text-[44px] font-extrabold tracking-[-0.04em] leading-none mt-1">{totalVehicles}</dd></div>
          <div><dt class="text-[13px] text-[var(--color-text-faint)]">Essais sur route</dt><dd class="font-display text-[44px] font-extrabold tracking-[-0.04em] leading-none mt-1">{totalTests}</dd></div>
        </dl>
      </div>
      <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-3">
        {pillars.map(({ icon: Icon, title, text }) => (
          <li class="pillar">
            <span class="inline-flex w-11 h-11 items-center justify-center rounded-full bg-[var(--color-surface-accent)] text-[var(--color-accent)]">
              <Icon size={20} strokeWidth={1.75} aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-[21px] font-extrabold tracking-[-0.025em]">{title}</h3>
            <p class="mt-2 text-[15px] text-[var(--color-text-muted)] leading-relaxed">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═════════ SECTION SEO / DÉCOUVERTE ═════════ */}
  <section class="container-edit mt-24 md:mt-32">
    <div class="pt-12 border-t border-[var(--color-border)] grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14">
      <h2 class="lg:col-span-4 font-display text-[26px] md:text-[30px] font-extrabold tracking-[-0.03em] leading-[1.08] max-w-[20ch] px-1">
        Le comparateur de voiture électrique qui ne travaille que pour vous.
      </h2>
      <div class="lg:col-span-8 grid md:grid-cols-2 gap-x-10 gap-y-4 text-[15px] text-[var(--color-text-muted)] leading-relaxed">
        <p>
          <strong class="text-[var(--color-text)] font-semibold">Evly</strong> est un comparateur de voitures électriques indépendant, pensé pour tout le monde : que vous cherchiez votre premier véhicule électrique ou que vous en soyez à votre troisième, que vous ayez 20 ans ou 70 ans, vous n'avez pas besoin de connaître la différence entre une batterie LFP et une NMC pour trouver la bonne voiture au bon prix. C'est notre travail de traduire ces chiffres en une réponse simple : est-ce que ce modèle vous convient, et est-ce que vous le payez au juste prix ?
        </p>
        <p>
          Petite citadine pour la ville, SUV familial pour les vacances ou utilitaire pour le travail : nos outils filtrent et comparent objectivement le catalogue selon vos besoins réels. On intègre aussi la prime CEE (le coup de pouce qui a remplacé le bonus écologique) et l'éligibilité au leasing social pour vous montrer le prix que vous paierez vraiment, pas le prix catalogue.
        </p>
        <p>
          Aucun constructeur ni aucune concession ne nous rémunère. Notre base de données rassemble {totalVehicles} modèles, avec pour chacun l'autonomie réellement constatée sur route (souvent inférieure à l'annonce du constructeur), la vitesse de recharge, et le coût complet sur plusieurs années, pas seulement le prix affiché en vitrine.
        </p>
        <p>
          Vous ne savez pas par où commencer ? Répondez à quelques questions simples sur votre <a href={url("/recommandation/")} class="text-[var(--color-accent)] underline underline-offset-2 hover:no-underline">quotidien avec notre outil de recommandation</a>, ou allez directement voir nos <a href={url("/bons-plans/")} class="text-[var(--color-accent)] underline underline-offset-2 hover:no-underline">duels à prix égal</a> : les cas où, pour le même budget qu'un modèle connu, une autre voiture électrique fait tout simplement mieux.
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero-panel {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border-radius: 32px;
      padding: 1.75rem 1.5rem 0;
      background:
        radial-gradient(ellipse 55% 60% at 80% 85%, rgba(212, 234, 127, 0.22), transparent 70%),
        linear-gradient(150deg, var(--color-accent) 0%, var(--color-ink) 100%);
    }
    @media (min-width: 768px) { .hero-panel { padding: 3rem 3.5rem 0; } }
    @media (min-width: 1024px) { .hero-panel { min-height: min(74dvh, 660px); } }
    /* La grille occupe toute la hauteur du panneau : les voitures sont ancrées en bas */
    .hero-grid { flex: 1; }

    .proof-card { padding: 1.5rem; border-radius: var(--radius-tile); background: var(--color-surface); border: 1px solid var(--color-border); }
    @media (min-width: 768px) { .proof-card { padding: 2.25rem; } }
    .proof-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "name values" "rail gap";
      align-items: center;
      column-gap: 1rem;
      row-gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      margin-inline: -0.75rem;
      border-radius: 16px;
      transition: background-color 200ms var(--ease-out-expo);
    }
    @media (hover: hover) and (pointer: fine) {
      .proof-row:hover { background: var(--color-bg); }
      .proof-row:hover :global(.rail) { --rail-surface: var(--color-bg); }
    }
    .proof-name { grid-area: name; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
    .proof-values { grid-area: values; font-size: 13px; color: var(--color-text-faint); text-align: right; }
    .proof-values b { color: var(--color-text); font-weight: 700; }
    .proof-row :global(.proof-rail) { grid-area: rail; }
    .proof-gap { grid-area: gap; min-width: 3.5rem; text-align: right; font-family: var(--font-display); font-size: 17px; font-weight: 800; letter-spacing: -0.03em; }

    .tools { display: grid; gap: 0.75rem; }
    @media (min-width: 1024px) { .tools { grid-template-columns: 1.4fr 1fr 1fr; } }
    .tool {
      position: relative; display: flex; flex-direction: column; gap: 0.75rem; min-height: 22rem; padding: 2rem;
      border-radius: 28px; overflow: hidden; transition: transform 260ms var(--ease-out-expo), box-shadow 260ms var(--ease-out-expo);
    }
    @media (hover: hover) and (pointer: fine) {
      .tool:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
      .tool:hover :global(.tool-arrow) { transform: rotate(45deg); }
      .tool:hover .tool-cars :global(img) { transform: translateX(-6px) scaleX(-1); }
      .tool:hover .tool-cars :global(img:last-child) { transform: translateX(6px); }
    }
    .tool:active { transform: scale(0.985); transition-duration: 120ms; }
    .tool-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .tool :global(.tool-arrow) { flex-shrink: 0; transition: transform 300ms var(--ease-out-expo); }
    .tool-compare { background: var(--color-lime); color: var(--color-ink); }
    .tool-compare-desc { color: color-mix(in srgb, var(--color-ink) 85%, transparent); }
    .tool-cars { margin-top: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 0.5rem; height: 9rem; }
    .tool-cars :global(img) { transition: transform 260ms var(--ease-out-expo); }
    .tool-cars :global(img:first-child) { transform: scaleX(-1); }
    .vs { align-self: center; font-size: 22px; font-weight: 800; color: var(--color-accent); }
    .tool-tco { background: var(--color-surface); border: 1px solid var(--color-border); }
    .tool-leasing { background: var(--color-ink); color: var(--color-accent-on); }

    .pillar { padding: 1.75rem; border-radius: var(--radius-tile); background: var(--color-surface); border: 1px solid var(--color-border); }
  </style>
</BaseLayout>
