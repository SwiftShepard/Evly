---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Tag from "@/components/ui/Tag.astro";
import VehicleImage from "@/components/ui/VehicleImage.astro";
import BrandLogo from "@/components/ui/BrandLogo.astro";
import RangeSpecimen from "@/components/home/RangeSpecimen.astro";
import RangeGapChart from "@/components/home/RangeGapChart.astro";
import { getAllVehicles } from "@/lib/vehicles";
import { formatPrice, formatNumber } from "@/lib/format";
import { getVehicleCardSummary } from "@/lib/vehicleCard";
import { getFleetGap } from "@/lib/rangeGap";
import { getVehicleBySlug } from "@/lib/vehicles";
import { DEFAULTS as TCO_DEFAULTS } from "@/components/tco/TcoCalculator";
import { url } from "@/lib/url";
import { ArrowRight, ArrowUpRight, ChevronLeft, ChevronRight, ShieldCheck, FileSearch, Calculator, Scale } from "lucide-react";

const vehicles = getAllVehicles();
const totalVehicles = vehicles.length;
const totalTests = vehicles.reduce((sum, v) => sum + v.rangeTests.length, 0);
const totalConfigs = vehicles.reduce((sum, v) => sum + v.configurations.length, 0);
const fleetGap = getFleetGap(vehicles);

// Loyer le plus bas parmi les versions éligibles au leasing social
const leasingMin = Math.min(
  ...vehicles.flatMap((v) =>
    v.configurations
      .filter((c) => c.leasingSocialEligible && c.monthlyLease_EUR)
      .map((c) => c.monthlyLease_EUR as number)
  )
);

// Coût de 100 km aux tarifs par défaut du calculateur TCO : électrique rechargé à domicile vs essence
const tcoExample = getVehicleBySlug("renault-5")!;
const evCost100 = tcoExample.consumption_mixed_kWh_per_100km * TCO_DEFAULTS.elec_home_eur_kwh;
const iceCost100 = TCO_DEFAULTS.ice_conso_l_100 * TCO_DEFAULTS.essence_eur_l;
const euros = (n: number) => `${formatNumber(n, 2)} €`;

// Tri par date de dernière mise à jour / ajout (lastUpdated) décroissant, puis par marque/modèle
const latestVehicles = [...vehicles]
  .sort((a, b) => {
    const dateComp = b.lastUpdated.localeCompare(a.lastUpdated);
    if (dateComp !== 0) return dateComp;
    return a.brand.localeCompare(b.brand) || a.model.localeCompare(b.model);
  })
  .slice(0, 10);

const GAP_CHART_SLUGS = [
  "tesla-model-y", "mg-mg4", "tesla-model-3", "byd-dolphin", "volvo-ex30", "vw-id3",
  "citroen-e-c3", "renault-5", "kia-ev3", "peugeot-e-208", "renault-scenic", "hyundai-kona",
];

const pillars = [
  {
    icon: ShieldCheck,
    title: "100 % indépendant",
    text: "Aucune marque ne nous paie pour apparaître, aucune concession ne touche de commission sur vos clics. On peut donc vous dire franchement quand un modèle n'est pas terrible.",
  },
  {
    icon: FileSearch,
    title: "Sources vérifiables",
    text: "Chaque chiffre affiché vient d'un essai réel sur route, d'un article de presse ou d'une fiche constructeur, et on vous dit toujours lequel, avec un lien.",
  },
  {
    icon: Calculator,
    title: "Calculs expliqués",
    text: "Comment on mesure l'autonomie, comment on calcule le coût réel sur plusieurs années, comment on estime les aides : tout est expliqué en clair, pas de boîte noire.",
  },
  {
    icon: Scale,
    title: "De votre côté",
    text: "Si un modèle déçoit à l'usage ou qu'un constructeur cache un chiffre gênant, on l'écrit. Notre objectif, c'est que vous en ayez pour votre argent, pas de vendre une voiture.",
  },
];

const description = `Comparez les ${totalVehicles} voitures électriques du marché français : autonomie réelle mesurée, prix après aides et recharge. Indépendant, sans publicité ni commission.`;
---

<BaseLayout title="Comparateur de voitures électriques : autonomie réelle | Evly" description={description}>

  {/* ═════════ HERO ═════════ */}
  <section class="container-edit pt-8 md:pt-14 lg:pt-20 pb-20 md:pb-28">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-6 xl:col-span-6">
        {/* Le H1 porte la requête visée ; le slogan reste le titre visuel */}
        <h1 class="fade-rise text-[14px] md:text-[15px] font-medium text-[var(--color-accent)] tracking-[-0.01em] mb-5">
          Comparateur indépendant de voitures électriques
        </h1>
        <p class="display-1 fade-rise fade-rise-delay-1 max-w-[12ch]">
          L'électrique, enfin <span class="text-[var(--color-accent)]">clair.</span>
        </p>
        <p class="mt-6 md:mt-7 text-[17px] md:text-lg text-[var(--color-text-muted)] max-w-[44ch] leading-relaxed fade-rise fade-rise-delay-2">
          Autonomie réelle sur route, prix après aides, coût sur la durée. Sans publicité ni commission.
        </p>
        <div class="mt-8 md:mt-10 flex flex-col sm:flex-row gap-3 fade-rise fade-rise-delay-3">
          <a href={url("/recommandation/")} class="btn btn-primary">
            Trouver mon VE
            <ArrowRight size={17} strokeWidth={2} className="btn-arrow" aria-hidden="true" />
          </a>
          <a href={url("/vehicules/")} class="btn btn-secondary">
            Explorer le catalogue
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 xl:col-span-6 fade-rise fade-rise-delay-2">
        <RangeSpecimen />
      </div>
    </div>
  </section>

  {/* ═════════ LA PREUVE : ANNONCE VS ROUTE ═════════ */}
  <section class="container-edit pb-24 md:pb-32">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 reveal">
      <div class="lg:col-span-4 flex flex-col">
        <h2 class="display-2 max-w-[14ch]">L'autonomie annoncée n'est pas celle de la route.</h2>
        <p class="mt-5 text-base text-[var(--color-text-muted)] leading-relaxed max-w-[42ch]">
          Le chiffre WLTP sort d'un laboratoire. Evly met en avant l'autonomie réelle, mesurée sur route dès qu'un essai existe, et vous dit toujours d'où vient le chiffre.
        </p>
        <div class="mt-10 pt-8 border-t border-[var(--color-border)]">
          <p class="text-[64px] md:text-[80px] font-semibold tracking-[-0.05em] leading-[0.9]">
            {formatNumber(Math.round(fleetGap.medianPct))}<span class="text-[0.5em] tracking-[-0.02em] ml-1">%</span>
          </p>
          <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed max-w-[34ch]">
            d'écart médian entre l'annonce et la route, sur les {fleetGap.models} modèles testés par Bjørn Nyland ou la presse VE.
          </p>
          <a href={url("/methodologie/") + "#protocoles"} class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-dim)]">
            Nos protocoles de mesure
            <ArrowRight size={15} strokeWidth={2} className="arrow-animate" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-8 rounded-[var(--radius-tile)] border border-[var(--color-border)] bg-[var(--color-surface-elevated)] shadow-[var(--shadow-sm)] p-5 md:p-8">
        <RangeGapChart slugs={GAP_CHART_SLUGS} />
      </div>
    </div>
  </section>

  {/* ═════════ OUTILS ═════════ */}
  <section class="container-edit pb-24 md:pb-32">
    <h2 class="display-2 mb-8 md:mb-10 reveal">Choisir, comparer, chiffrer.</h2>

    <div class="tools-grid reveal-stagger no-glossary">
      {/* Recommandation : entrée principale */}
      <a href={url("/recommandation/")} class="tool tool-reco reveal">
        <div class="relative z-10 max-w-md">
          <h3 class="text-[26px] md:text-[32px] font-semibold tracking-[-0.035em] leading-[1.08]">
            Pas d'idée précise&nbsp;? On vous guide.
          </h3>
          <p class="mt-3 text-[15px] text-[var(--color-text-muted)] leading-relaxed max-w-[40ch]">
            Quelques questions sur vos trajets et votre budget, puis les 3 à 5 modèles qui vous correspondent vraiment.
          </p>
          <span class="btn btn-primary mt-6 pointer-events-none">
            Trouver mon VE
            <ArrowRight size={17} strokeWidth={2} className="btn-arrow" aria-hidden="true" />
          </span>
        </div>
        <div class="tool-reco-cars" aria-hidden="true">
          <VehicleImage slug="renault-scenic" alt="" widths={[360, 720]} sizes="300px" class="car car-back-left" />
          <VehicleImage slug="skoda-elroq" alt="" widths={[360, 720]} sizes="300px" class="car car-back-right" />
          <VehicleImage slug="renault-5" alt="" widths={[480, 960]} sizes="380px" class="car car-front" />
        </div>
      </a>

      {/* Comparateur */}
      <a href={url("/comparer/")} class="tool tool-compare reveal">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-xl md:text-2xl font-semibold tracking-[-0.03em] leading-tight">Comparateur</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed max-w-[34ch]">
              Jusqu'à 4 modèles côte à côte, batterie, finition et jantes comprises.
            </p>
          </div>
          <span class="tool-arrow"><ArrowUpRight size={18} strokeWidth={1.75} aria-hidden="true" /></span>
        </div>
        <div class="tool-compare-cars" aria-hidden="true">
          <VehicleImage slug="peugeot-e-208" alt="" widths={[320, 640]} sizes="260px" class="w-full h-full" />
          <span class="tool-compare-divider"></span>
          <VehicleImage slug="byd-dolphin" alt="" widths={[320, 640]} sizes="260px" class="w-full h-full" />
        </div>
      </a>

      {/* Calculateur TCO */}
      <a href={url("/simulateur/")} class="tool tool-tco reveal">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-xl font-semibold tracking-[-0.03em] leading-tight">Le vrai coût, sur 1 à 10 ans</h3>
          <span class="tool-arrow"><ArrowUpRight size={18} strokeWidth={1.75} aria-hidden="true" /></span>
        </div>
        <div class="mt-auto pt-6">
          <p class="text-[13px] text-[var(--color-text-muted)]">Prix de 100 km</p>
          <div class="tco-bars mt-2.5" style={`--ev: ${(evCost100 / iceCost100) * 100}%`}>
            <div class="tco-bar-row">
              <span class="tco-bar tco-bar-ev"></span>
              <span class="tco-bar-label"><strong>{euros(evCost100)}</strong> {tcoExample.brand} {tcoExample.model.replace(/ E-Tech$/, "")}, à domicile</span>
            </div>
            <div class="tco-bar-row">
              <span class="tco-bar tco-bar-ice"></span>
              <span class="tco-bar-label"><strong>{euros(iceCost100)}</strong> Essence, {formatNumber(TCO_DEFAULTS.ice_conso_l_100, 1)}&nbsp;l/100</span>
            </div>
          </div>
          <p class="mt-3 text-[11.5px] text-[var(--color-text-faint)] leading-snug">
            À {formatNumber(TCO_DEFAULTS.elec_home_eur_kwh, 2)}&nbsp;€/kWh et {formatNumber(TCO_DEFAULTS.essence_eur_l, 2)}&nbsp;€/l, tarifs réglables dans le calculateur.
          </p>
        </div>
      </a>

      {/* Leasing social */}
      <a href={url("/leasing-social/")} class="tool tool-leasing reveal">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-xl font-semibold tracking-[-0.03em] leading-tight">Leasing social</h3>
          <span class="tool-arrow"><ArrowUpRight size={18} strokeWidth={1.75} aria-hidden="true" /></span>
        </div>
        <p class="mt-auto pt-6">
          <span class="block text-[13px] text-[color-mix(in_srgb,var(--color-accent-on)_72%,transparent)]">Dès</span>
          <span class="text-[40px] font-semibold tracking-[-0.045em] leading-none">{leasingMin}&nbsp;€</span>
          <span class="text-[15px] text-[color-mix(in_srgb,var(--color-accent-on)_72%,transparent)]">/mois</span>
        </p>
        <p class="mt-2 text-[13px] text-[color-mix(in_srgb,var(--color-accent-on)_72%,transparent)] leading-snug">
          Sans apport, sous conditions de revenus.
        </p>
      </a>
    </div>
  </section>

  {/* ═════════ NOUVEAUTÉS ═════════ */}
  <section class="pb-24 md:pb-32" data-carousel>
    <div class="container-edit flex flex-wrap items-end justify-between gap-4 mb-8 md:mb-10">
      <h2 class="display-2">Nouveautés et mises à jour</h2>
      <div class="flex items-center gap-2">
        <a href={url("/vehicules/")} class="btn btn-secondary btn-sm">Explorer le catalogue</a>
        <button type="button" class="carousel-btn hidden md:inline-flex" data-carousel-prev aria-label="Modèles précédents">
          <ChevronLeft size={18} strokeWidth={1.75} aria-hidden="true" />
        </button>
        <button type="button" class="carousel-btn hidden md:inline-flex" data-carousel-next aria-label="Modèles suivants">
          <ChevronRight size={18} strokeWidth={1.75} aria-hidden="true" />
        </button>
      </div>
    </div>

    <ul class="latest-row no-glossary" data-carousel-track>
      {latestVehicles.map((v) => {
        const card = getVehicleCardSummary(v);
        const isNew = v.releaseYear >= 2026;
        return (
          <li class="latest-item">
            <a href={url(`/vehicules/${v.slug}/`)} class="latest-card">
              <div class="latest-photo">
                <VehicleImage slug={v.slug} alt={`${v.brand} ${v.model}`} widths={[360, 720]} sizes="300px" class="w-[88%] h-full" />
              </div>
              <div class="p-4 pt-3.5 flex flex-col flex-1">
                <div class="flex items-center justify-between gap-2">
                  <span class="flex items-center gap-1.5 text-[13px] text-[var(--color-text-faint)] min-w-0">
                    <BrandLogo brand={v.brand} class="w-3.5 h-3.5 shrink-0" />
                    <span class="truncate">{v.brand}</span>
                  </span>
                  <Tag tone={isNew ? "accent" : "neutral"}>{isNew ? "Nouveauté" : "Mis à jour"}</Tag>
                </div>
                <h3 class="mt-2 text-lg font-semibold tracking-[-0.025em] leading-tight">{v.model}</h3>
                <p class="mt-0.5 text-[13px] text-[var(--color-text-faint)]">{card.subtitle}</p>
                <div class="mt-auto pt-4 grid grid-cols-2 gap-3">
                  <div>
                    <p class="text-[12px] text-[var(--color-text-faint)]">Autonomie réelle</p>
                    <p class="mt-0.5 flex items-baseline gap-1">
                      <span class="text-xl font-semibold tracking-[-0.03em] text-[var(--color-accent)]">{v.realRange.mixed_km}</span>
                      <span class="text-[13px] text-[var(--color-text-faint)]">km</span>
                    </p>
                    <span class="card-confidence mt-1" data-level={card.rangeConfidence}>{card.rangeConfidenceLabel}</span>
                  </div>
                  <div class="text-right">
                    <p class="text-[12px] text-[var(--color-text-faint)]">{card.cheapestPrice !== null ? "Dès" : "Prix"}</p>
                    {card.cheapestPrice !== null ? (
                      <p class="mt-0.5 text-xl font-semibold tracking-[-0.03em]">{formatPrice(card.cheapestPrice)}</p>
                    ) : (
                      <p class="mt-1 text-sm font-medium text-[var(--color-text-faint)] leading-tight">Non communiqué</p>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {/* ═════════ POURQUOI EVLY ═════════ */}
  <section class="container-edit pb-24 md:pb-32">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28 reveal">
          <h2 class="display-2 max-w-[13ch]">Aucune marque ne nous paie.</h2>
          <p class="mt-5 text-base text-[var(--color-text-muted)] leading-relaxed max-w-[44ch]">
            Le marché est saturé de comparateurs financés par la publicité ou les commissions. Evly choisit la transparence : données mesurées, sources tracées, zéro rémunération.
          </p>
          <dl class="mt-10 grid grid-cols-3 gap-4 pt-6 border-t border-[var(--color-border)] [&>div]:flex [&>div]:flex-col [&>div]:justify-between">
            <div>
              <dt class="text-[13px] text-[var(--color-text-faint)]">Modèles suivis</dt>
              <dd class="mt-1 text-3xl md:text-4xl font-semibold tracking-[-0.04em]">{totalVehicles}</dd>
            </div>
            <div>
              <dt class="text-[13px] text-[var(--color-text-faint)]">Essais sur route</dt>
              <dd class="mt-1 text-3xl md:text-4xl font-semibold tracking-[-0.04em]">{totalTests}</dd>
            </div>
            <div>
              <dt class="text-[13px] text-[var(--color-text-faint)]">Versions détaillées</dt>
              <dd class="mt-1 text-3xl md:text-4xl font-semibold tracking-[-0.04em]">{totalConfigs}</dd>
            </div>
          </dl>
        </div>
      </div>

      <ul class="lg:col-span-7 grid sm:grid-cols-2 gap-x-10 reveal-stagger">
        {pillars.map(({ icon: Icon, title, text }) => (
          <li class="reveal py-7 border-t border-[var(--color-border)]">
            <span class="inline-flex w-10 h-10 items-center justify-center rounded-full bg-[var(--color-surface-accent)] text-[var(--color-accent)]">
              <Icon size={19} strokeWidth={1.75} aria-hidden="true" />
            </span>
            <h3 class="mt-4 text-lg font-semibold tracking-[-0.025em]">{title}</h3>
            <p class="mt-2 text-[15px] text-[var(--color-text-muted)] leading-relaxed">{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ═════════ SECTION SEO / DÉCOUVERTE ═════════ */}
  <section class="container-edit">
    <div class="pt-14 border-t border-[var(--color-border)] grid lg:grid-cols-12 gap-8 lg:gap-14">
      <h2 class="lg:col-span-4 text-2xl md:text-[28px] font-semibold tracking-[-0.03em] leading-[1.15] max-w-[22ch]">
        Le comparateur de voiture électrique qui ne travaille que pour vous.
      </h2>
      <div class="lg:col-span-8 grid md:grid-cols-2 gap-x-10 gap-y-4 text-[15px] text-[var(--color-text-muted)] leading-relaxed">
        <p>
          <strong class="text-[var(--color-text)] font-semibold">Evly</strong> est un comparateur de voitures électriques indépendant, pensé pour tout le monde : que vous cherchiez votre premier véhicule électrique ou que vous en soyez à votre troisième, que vous ayez 20 ans ou 70 ans, vous n'avez pas besoin de connaître la différence entre une batterie LFP et une NMC pour trouver la bonne voiture au bon prix. C'est notre travail de traduire ces chiffres en une réponse simple : est-ce que ce modèle vous convient, et est-ce que vous le payez au juste prix ?
        </p>
        <p>
          Petite citadine pour la ville, SUV familial pour les vacances ou utilitaire pour le travail : nos outils filtrent et comparent objectivement le catalogue selon vos besoins réels. On intègre aussi les aides de l'État (bonus, prime à la conversion, coup de pouce CEE) et l'éligibilité au leasing social pour vous montrer le prix que vous paierez vraiment, pas le prix catalogue.
        </p>
        <p>
          Aucun constructeur ni aucune concession ne nous rémunère. Notre base de données rassemble {totalVehicles} modèles, avec pour chacun l'autonomie réellement constatée sur route (souvent inférieure à l'annonce du constructeur), la vitesse de recharge, et le coût complet sur plusieurs années, pas seulement le prix affiché en vitrine.
        </p>
        <p>
          Vous ne savez pas par où commencer ? Répondez à quelques questions simples sur votre <a href={url("/recommandation/")} class="text-[var(--color-accent)] underline underline-offset-2 hover:no-underline">quotidien avec notre outil de recommandation</a>, ou allez directement voir nos <a href={url("/bons-plans/")} class="text-[var(--color-accent)] underline underline-offset-2 hover:no-underline">bons plans</a> : les cas où, pour le même budget qu'un modèle connu, une autre voiture électrique fait tout simplement mieux.
        </p>
      </div>
    </div>
  </section>

  <style>
    /* ── Bento outils : 1 grande entrée + 3 tuiles (lg) ── */
    .tools-grid {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 768px) {
      .tools-grid {
        gap: 1rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .tool-reco { grid-column: 1 / -1; }
      .tool-compare { grid-column: 1 / -1; }
    }
    @media (min-width: 1024px) {
      .tools-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-template-rows: repeat(2, minmax(15rem, auto));
      }
      .tool-reco { grid-column: 1 / span 2; grid-row: 1 / span 2; }
      .tool-compare { grid-column: 3 / span 2; grid-row: 1; }
      .tool-tco { grid-column: 3; grid-row: 2; }
      .tool-leasing { grid-column: 4; grid-row: 2; }
    }

    .tool {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 13rem;
      padding: 1.5rem;
      border-radius: var(--radius-tile);
      border: 1px solid var(--color-border);
      background: var(--color-surface-elevated);
      overflow: hidden;
      transition:
        transform 450ms var(--ease-out-expo),
        box-shadow 450ms var(--ease-out-expo),
        border-color 450ms var(--ease-out-expo),
        opacity 0.7s var(--ease-out-expo);
    }
    @media (min-width: 768px) {
      .tool { padding: 1.75rem; }
    }
    @media (hover: hover) {
      .tool:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--color-border-strong);
      }
      .tool:active { transform: translateY(0) scale(0.995); transition-duration: 120ms; }
    }

    .tool-arrow {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      transition: background-color 250ms var(--ease-out-expo), color 250ms var(--ease-out-expo), transform 300ms var(--ease-out-expo), border-color 250ms var(--ease-out-expo);
    }
    @media (hover: hover) {
      .tool:hover .tool-arrow {
        background: var(--color-text);
        border-color: var(--color-text);
        color: var(--color-bg-elevated);
        transform: rotate(45deg);
      }
    }

    /* Recommandation : fond vert tendre, voitures en perspective */
    .tool-reco {
      min-height: 26rem;
      background:
        radial-gradient(ellipse 70% 22% at 62% 96%, rgba(28, 36, 18, 0.14), transparent 70%),
        linear-gradient(160deg, var(--color-surface-accent) 0%, color-mix(in srgb, var(--color-surface-accent) 55%, var(--color-surface-elevated)) 100%);
      border-color: color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    }
    @media (min-width: 768px) {
      .tool-reco { padding: 2.25rem; }
    }
    .tool-reco-cars {
      position: relative;
      margin-top: auto;
      height: 11rem;
    }
    .tool-reco-cars :global(.car) {
      position: absolute;
      bottom: 0;
      transition: transform 700ms var(--ease-out-expo);
    }
    .tool-reco-cars :global(.car-front) { left: 18%; width: 62%; height: 100%; z-index: 2; }
    .tool-reco-cars :global(.car-back-left) { left: -2%; bottom: 1.75rem; width: 44%; height: 62%; opacity: 0.9; }
    .tool-reco-cars :global(.car-back-right) { right: -4%; bottom: 1.75rem; width: 44%; height: 62%; opacity: 0.9; }
    @media (hover: hover) {
      .tool-reco:hover :global(.car-front) { transform: translateX(10px); }
      .tool-reco:hover :global(.car-back-left) { transform: translateX(-6px); }
      .tool-reco:hover :global(.car-back-right) { transform: translateX(6px); }
    }
    @media (min-width: 1024px) {
      .tool-reco-cars { height: 14rem; }
    }

    /* Comparateur : deux modèles face à face */
    .tool-compare-cars {
      margin-top: auto;
      padding-top: 1.25rem;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: 1rem;
      height: 9rem;
    }
    .tool-compare-cars :global(img:first-child) { transform: scaleX(-1); }
    .tool-compare-divider {
      width: 1px;
      height: 70%;
      background: var(--color-border-strong);
      align-self: center;
    }

    /* TCO : surface neutre teintée */
    .tool-tco {
      background: var(--color-bg-subtle);
      border-color: transparent;
    }

    .tco-bars { display: flex; flex-direction: column; gap: 0.5rem; }
    .tco-bar-row { display: flex; flex-direction: column; gap: 0.3rem; }
    .tco-bar { display: block; height: 8px; border-radius: 0 4px 4px 0; transform-origin: left center; }
    .tco-bar-ev { width: var(--ev); background: var(--color-accent); }
    .tco-bar-ice { width: 100%; background: var(--color-text-faint); }
    .tco-bar-label { font-size: 12.5px; color: var(--color-text-muted); line-height: 1.2; }
    .tco-bar-label strong { color: var(--color-text); font-weight: 600; margin-right: 0.25rem; }

    /* Leasing social : aplat vert très sombre */
    .tool-leasing {
      background: var(--color-ink);
      border-color: var(--color-ink);
      color: var(--color-accent-on);
    }
    .tool-leasing .tool-arrow {
      border-color: color-mix(in srgb, var(--color-accent-on) 25%, transparent);
      color: var(--color-accent-on);
    }
    @media (hover: hover) {
      .tool-leasing:hover { border-color: var(--color-ink); }
      .tool-leasing:hover .tool-arrow {
        background: var(--color-accent-on);
        border-color: var(--color-accent-on);
        color: var(--color-ink);
      }
    }

    /* ── Rangée défilante des nouveautés ── */
    .latest-row {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(1rem, calc((100vw - var(--container-max)) / 2 + 2.5rem));
      padding-inline: max(1rem, calc((100vw - var(--container-max)) / 2 + 2.5rem));
      padding-block: 0.25rem 1rem;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .latest-row::-webkit-scrollbar { display: none; }
    @media (min-width: 768px) {
      .latest-row {
        gap: 1rem;
        scroll-padding-inline: max(2rem, calc((100vw - var(--container-max)) / 2 + 2.5rem));
        padding-inline: max(2rem, calc((100vw - var(--container-max)) / 2 + 2.5rem));
      }
    }
    .latest-item {
      flex: 0 0 auto;
      width: 78vw;
      max-width: 300px;
      scroll-snap-align: start;
      display: flex;
    }
    .latest-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      border-radius: var(--radius-tile);
      border: 1px solid var(--color-border);
      background: var(--color-surface-elevated);
      overflow: hidden;
      transition: transform 450ms var(--ease-out-expo), box-shadow 450ms var(--ease-out-expo), border-color 450ms var(--ease-out-expo);
    }
    .latest-photo {
      height: 9.5rem;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-top: 0.75rem;
      background:
        radial-gradient(ellipse 50% 14% at 50% 94%, rgba(28, 36, 18, 0.13), transparent 70%),
        var(--color-bg-subtle);
    }
    .latest-photo :global(img) {
      transition: transform 600ms var(--ease-out-expo);
    }
    @media (hover: hover) {
      .latest-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--color-border-strong);
      }
      .latest-card:hover .latest-photo :global(img) { transform: scale(1.04); }
    }

    .carousel-btn {
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface-elevated);
      color: var(--color-text);
      transition: border-color 200ms var(--ease-out-expo), opacity 200ms var(--ease-out-expo), transform 160ms var(--ease-out-expo);
    }
    .carousel-btn:active { transform: scale(0.94); }
    .carousel-btn:disabled { opacity: 0.35; cursor: default; }
    @media (hover: hover) {
      .carousel-btn:not(:disabled):hover { border-color: var(--color-text); }
    }
  </style>

  <script>
    // Boutons précédent / suivant de la rangée des nouveautés (défilement natif avec accroche)
    function setupCarousels() {
      document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
        if (root.dataset.ready) return;
        root.dataset.ready = "true";
        const track = root.querySelector<HTMLElement>("[data-carousel-track]");
        const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
        const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
        if (!track || !prev || !next) return;
        const items = track.querySelectorAll<HTMLElement>(".latest-item");
        const first = items[0];
        const last = items[items.length - 1];
        if (!first || !last) return;
        const step = () => first.offsetWidth + 16;
        prev.addEventListener("click", () => track.scrollBy({ left: -step() * 2, behavior: "smooth" }));
        next.addEventListener("click", () => track.scrollBy({ left: step() * 2, behavior: "smooth" }));
        // Bouton désactivé quand la première / dernière carte est entièrement visible
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const atEdge = e.intersectionRatio > 0.95;
              if (e.target === first) prev.disabled = atEdge;
              if (e.target === last) next.disabled = atEdge;
            }
          },
          { root: track, threshold: [0, 0.95, 1] }
        );
        io.observe(first);
        io.observe(last);
        document.addEventListener("astro:before-swap", () => io.disconnect(), { once: true });
      });
    }
    setupCarousels();
    document.addEventListener("astro:page-load", setupCarousels);
  </script>
</BaseLayout>
