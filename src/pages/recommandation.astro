---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StrategicMatcher from "@/components/matcher/StrategicMatcher.tsx";
import { getAllVehicles } from "@/lib/vehicles";

const STRICT_UTILITY_SLUGS = new Set([
  "citroen-e-jumper",
  "citroen-e-jumpy",
  "citroen-e-spacetourer",
  "fiat-e-ducato",
  "fiat-e-scudo",
  "ford-e-transit",
  "kia-pv5-cargo",
  "maxus-edeliver-3",
  "maxus-edeliver-5",
  "maxus-edeliver-7",
  "maxus-edeliver-9",
  "opel-movano-e",
  "opel-vivaro-e-life",
  "peugeot-e-boxer",
  "peugeot-e-expert-combi",
  "peugeot-e-partner",
  "peugeot-e-traveller",
  "renault-master-e-tech",
  "renault-trafic-e-tech",
  "toyota-proace-max-electric",
]);

const vehicles = getAllVehicles().filter(
  (v) =>
    !STRICT_UTILITY_SLUGS.has(v.slug) &&
    v.bodyType !== "Fourgon" &&
    v.bodyType !== "Fourgonnette" &&
    v.bodyType !== "Combi utilitaire"
);
---

<BaseLayout
  title="Trouver sa Voiture Électrique Idéale : Matcher Intelligent | Evly"
  description="🎯 Quelle voiture électrique est faite pour vous ? Faites le test en 2 minutes : diagnostic basé sur vos trajets quotidiens réels, votre budget et votre mode de recharge."
>
  <div class="container-edit py-6 md:py-10">
    <div class="fade-rise fade-rise-delay-1">
      <StrategicMatcher client:load vehicles={vehicles} />
    </div>

    <!-- ═════════ SECTION SEO / DÉCOUVERTE ═════════ -->
    <section class="mt-16 pt-16 border-t border-[var(--color-border)]">
      <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-[-0.015em] mb-6">
        Trouver sa voiture électrique idéale, même sans rien y connaître
      </h2>
      <div class="grid md:grid-cols-2 gap-8 text-sm text-[var(--color-text-muted)] leading-relaxed">
        <div class="flex flex-col gap-4">
          <p>
            Face à des dizaines de modèles électriques, difficile de savoir lequel vous correspond, encore moins lequel est un bon achat. Pas besoin de connaître le vocabulaire technique : notre outil de recommandation vous pose des questions sur votre vie de tous les jours et vous propose les modèles qui vous vont vraiment, pas ceux qu'on essaie de vous vendre.
          </p>
          <p>
            Onze questions simples sur vos trajets habituels, la façon dont vous rechargeriez (chez vous, au travail, en borne publique), la taille de votre foyer et votre budget maximum suffisent pour passer en revue tout le catalogue de façon objective.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <p>
            L'outil calcule aussi, en temps réel, à quelles aides de l'État vous pouvez prétendre et si vous êtes éligible au leasing social, pour vous donner le prix que vous paierez réellement, à l'achat comme en loyer mensuel.
          </p>
          <p>
            On tient compte de ce qui compte pour vous au quotidien : un bon assistant de navigation si vous roulez beaucoup, un grand coffre si vous avez des enfants ou des loisirs encombrants. À la fin, vous repartez avec 3 à 5 modèles qui ont vraiment du sens pour vous, pas une liste de 150 voitures à trier seul.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

