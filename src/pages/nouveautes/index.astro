---
/**
 * Nouveautés des données : chaque changement publié sur une fiche (nouveaux modèles et
 * versions, autonomies mesurées, courbes de recharge, prix), tiré de l'historique git par
 * lib/dataHistory. Une mise à jour par commit, les modèles concernés dépliables sur place.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import BentoGrid from "@/components/ui/BentoGrid.astro";
import Tile from "@/components/ui/Tile.astro";
import Breadcrumbs from "@/components/nav/Breadcrumbs.astro";
import { changeSummary, countsText, getDataUpdates, itemText, type ChangeKind } from "@/lib/dataHistory";
import { getVehicleBySlug } from "@/lib/vehicles";
import { getVehicleName } from "@/lib/seo";
import { formatNumber } from "@/lib/format";
import { url } from "@/lib/url";
import { ArrowRight, ChevronDown, Rss } from "lucide-react";

const updates = getDataUpdates();
/** Modèles montrés d'emblée par mise à jour ; les suivants se déplient */
const SHOWN = 6;

const dateFmt = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Paris" });
const fmtDate = (iso: string) => dateFmt.format(new Date(iso));

const total = (k: ChangeKind) => updates.reduce((n, u) => n + u.counts[k], 0);
const first = updates.at(-1);
const last = updates[0];

const rows = updates.map((u) => ({
  ...u,
  vehicles: u.vehicles.map((v) => {
    const current = getVehicleBySlug(v.slug);
    return { ...v, name: current ? getVehicleName(current) : v.name, href: current ? url(`/vehicules/${v.slug}/`) : null };
  }),
}));

const description = `Les nouveautés des données d'Evly : nouveaux modèles, autonomies mesurées sur route, courbes de recharge et prix, mise à jour par mise à jour${last ? ` (dernière le ${fmtDate(last.date)})` : ""}. Aussi en flux RSS.`;
---

<BaseLayout title="Nouveautés des données : modèles, autonomies mesurées, prix" description={description} ogImage="/og/pages/nouveautes.jpg">
  <div class="container-edit pt-2 md:pt-3 fade-rise">
    <Breadcrumbs items={[{ label: "Accueil", path: "/" }, { label: "Nos mesures", path: "/methodologie/" }, { label: "Nouveautés des données" }]} />
  </div>

  <div class="container-edit pt-2 pb-8 md:pt-3 md:pb-12 flex flex-col gap-10">
    <BentoGrid>
      <Tile size="full" variant="elevated" class="md:!p-8">
        <span class="label-eyebrow fade-rise">Nos mesures{last && <> · dernière mise à jour le {fmtDate(last.date)}</>}</span>
        <h1 class="display-2 mt-3 max-w-4xl fade-rise fade-rise-delay-1">Ce qui change dans les fiches.</h1>
        <p class="mt-4 max-w-3xl text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed fade-rise fade-rise-delay-2">
          Chaque fois qu'une fiche change, c'est écrit ici : un modèle entre au catalogue, une autonomie passe d'estimée à
          mesurée sur route, une courbe de recharge est relevée, un prix bouge. La liste se fait toute seule à partir de
          l'historique du site, rien n'est réécrit à la main.
        </p>
        {first && (
          <dl class="nv-facts fade-rise fade-rise-delay-2">
            <div><dt>Autonomies mesurées</dt><dd><b>{formatNumber(total("measured"))}</b> versions</dd></div>
            <div><dt>Nouveaux modèles</dt><dd><b>{formatNumber(total("model"))}</b></dd></div>
            <div><dt>Prix mis à jour</dt><dd><b>{formatNumber(total("price"))}</b></dd></div>
          </dl>
        )}
        {first && (
          <p class="nv-facts-since">Depuis le {fmtDate(first.date)}, première mise à jour suivie.</p>
        )}
        <div class="mt-6 flex flex-wrap gap-2 fade-rise fade-rise-delay-2">
          <a href={url("/nouveautes/rss.xml")} class="btn btn-secondary btn-sm">
            <Rss size={15} strokeWidth={2.2} aria-hidden="true" /> Suivre par RSS
          </a>
          <a href={url("/observatoire/")} class="btn btn-secondary btn-sm">
            Observatoire de l'autonomie <ArrowRight size={15} strokeWidth={2} className="btn-arrow" aria-hidden="true" />
          </a>
        </div>
      </Tile>
    </BentoGrid>

    {rows.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">L'historique des fiches n'est pas disponible pour cette version du site.</p>
    ) : (
      <ol class="nv-list">
        {rows.map((u) => (
          <li class="nv-update">
            <h2 class="nv-date"><time datetime={u.date}>{fmtDate(u.date)}</time></h2>
            <div class="nv-body">
            <p class="nv-counts">{countsText(u.counts).join(" · ")}</p>
            <ul class="nv-vehicles">
              {u.vehicles.slice(0, SHOWN).map((v) => (
                <li class="nv-row">
                  <button type="button" class="nv-row-head" aria-expanded="false" data-nv-toggle>
                    <span class="nv-name">{v.name}</span>
                    <span class="nv-sum">{changeSummary(v)}</span>
                    <ChevronDown size={16} strokeWidth={2.25} className="nv-chevron" aria-hidden="true" />
                  </button>
                  <div class="nv-reveal">
                    <div>
                      <ul class="nv-items">{v.items.map((it) => <li>{itemText(it)}</li>)}</ul>
                      {v.href && <a href={v.href} class="nv-link">Voir la fiche <ArrowRight size={13} strokeWidth={2.2} aria-hidden="true" /></a>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            {u.vehicles.length > SHOWN && (
              <>
                <button type="button" class="nv-more" aria-expanded="false" data-nv-toggle>
                  {u.vehicles.length - SHOWN} autres modèles <ChevronDown size={15} strokeWidth={2.25} className="nv-chevron" aria-hidden="true" />
                </button>
                <div class="nv-reveal">
                  <div>
                    <ul class="nv-vehicles nv-vehicles-rest">
                      {u.vehicles.slice(SHOWN).map((v) => (
                        <li class="nv-rest">
                          {v.href ? <a href={v.href}>{v.name}</a> : <span>{v.name}</span>} <span class="nv-sum">{changeSummary(v)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </>
            )}
            </div>
          </li>
        ))}
      </ol>
    )}

    <p class="nv-foot">
      Une mise à jour correspond à une publication du site. Un prix « mis à jour » peut être une baisse, une hausse ou une
      correction de la fiche ; une autonomie « mesurée » vient d'un essai sur route sourcé (Bjørn Nyland ou presse), jamais
      d'une estimation. <a href={url("/methodologie/")}>Notre méthode</a>
    </p>
  </div>
</BaseLayout>

<script>
  // Dépliage sur place : le bouton pilote le bloc qui le suit
  function setup() {
    document.querySelectorAll<HTMLButtonElement>("[data-nv-toggle]").forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = "1";
      btn.addEventListener("click", () => {
        const open = btn.getAttribute("aria-expanded") !== "true";
        btn.setAttribute("aria-expanded", String(open));
        const panel = btn.nextElementSibling as HTMLElement | null;
        if (panel) panel.toggleAttribute("data-open", open);
      });
    });
  }
  setup();
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .nv-facts { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.6rem; margin-top: 1.75rem; }
  @media (min-width: 640px) { .nv-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .nv-facts > div { padding: 1rem 1.1rem; border-radius: var(--radius-tile-sm); background: var(--color-surface-accent); }
  .nv-facts dt { font-size: 12.5px; font-weight: 600; color: var(--color-accent-dim); }
  .nv-facts dd { font-size: 13.5px; color: var(--color-text-muted); }
  .nv-facts dd b { font-family: var(--font-display); font-size: 1.7rem; font-weight: 800; letter-spacing: -0.035em; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .nv-facts-since { margin-top: 0.5rem; font-size: 12.5px; color: var(--color-text-faint); }

  .nv-list { display: flex; flex-direction: column; gap: 2.25rem; }
  .nv-update { display: grid; grid-template-columns: 1fr; gap: 0.35rem 2rem; }
  @media (min-width: 900px) { .nv-update { grid-template-columns: 13rem minmax(0, 1fr); } }
  .nv-body { display: flex; flex-direction: column; min-width: 0; }
  .nv-date { font-family: var(--font-display); font-size: 1.3rem; font-weight: 650; letter-spacing: -0.02em; line-height: 1.2; }
  .nv-counts { font-size: 13.5px; font-weight: 600; color: var(--color-accent); }
  .nv-vehicles { display: flex; flex-direction: column; border-top: 1px solid var(--color-border); margin-top: 0.4rem; }
  .nv-row { border-bottom: 1px solid var(--color-border); }
  .nv-row-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.1rem 1rem;
    width: 100%;
    padding: 0.7rem 0;
    text-align: left;
  }
  @media (min-width: 640px) { .nv-row-head { grid-template-columns: 15rem minmax(0, 1fr) auto; } }
  .nv-name { font-weight: 650; font-size: 15px; letter-spacing: -0.01em; }
  .nv-sum { font-size: 14px; color: var(--color-text-muted); }
  .nv-row-head .nv-sum { grid-column: 1; }
  @media (min-width: 640px) { .nv-row-head .nv-sum { grid-column: 2; } }
  .nv-row-head :global(.nv-chevron) { grid-row: 1; grid-column: -2; align-self: center; color: var(--color-text-faint); transition: transform 260ms var(--ease-out-expo); }
  .nv-row-head[aria-expanded="true"] :global(.nv-chevron),
  .nv-more[aria-expanded="true"] :global(.nv-chevron) { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) { .nv-row-head:hover .nv-name { color: var(--color-accent); } }

  .nv-reveal { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 320ms var(--ease-out-expo); }
  .nv-reveal > div { overflow: hidden; min-height: 0; }
  .nv-reveal[data-open] { grid-template-rows: 1fr; }
  .nv-items { display: flex; flex-direction: column; gap: 0.25rem; padding: 0 0 0.4rem; font-size: 14px; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  @media (min-width: 640px) { .nv-items, .nv-link { margin-left: 16rem; } }
  .nv-link { display: inline-flex; align-items: center; gap: 0.25rem; margin-bottom: 0.8rem; font-size: 13.5px; font-weight: 600; color: var(--color-accent); }

  .nv-more { display: inline-flex; align-items: center; gap: 0.3rem; align-self: flex-start; margin-top: 0.6rem; font-size: 14px; font-weight: 600; color: var(--color-accent); }
  .nv-vehicles-rest { border-top: 0; margin-top: 0.3rem; gap: 0.3rem; }
  .nv-rest { font-size: 14px; }
  .nv-rest a, .nv-rest > span:first-child { font-weight: 600; }
  .nv-rest a:hover { color: var(--color-accent); }

  .nv-foot { max-width: 80ch; font-size: 13.5px; color: var(--color-text-faint); }
  .nv-foot a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
</style>
