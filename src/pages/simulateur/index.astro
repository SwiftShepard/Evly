---
import { url } from "@/lib/url";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TcoCalculator from "@/components/tco/TcoCalculator";
import { getTcoVehicles } from "@/lib/tcoVehicles";
import "@/styles/tco.css";

// Un seul calculateur de coût pour le site (particulier ou société), cf. lib/tcoVehicles
const summaries = getTcoVehicles();

const description =
  "Voiture électrique ou thermique : calculez le coût total (TCO) sur 1 à 10 ans, en particulier ou pour une société : achat, aides, énergie réelle, assurance, entretien et revente compris. Gratuit.";
---

<BaseLayout title="Simulateur coût voiture électrique vs thermique (TCO)" description={description} ogImage="/og/pages/simulateur.jpg">
  <div class="tco-page-wrap">
    <div class="tco-page-header">
      <h1 class="label-eyebrow fade-rise mb-4 md:mb-5">Simulateur de coût : voiture électrique ou thermique</h1>
      <p class="display-1 max-w-4xl fade-rise fade-rise-delay-1">
        Le vrai coût d'une électrique
        <span class="text-[var(--color-accent)]">sur 1 à 10 ans.</span>
      </p>

      <p class="mt-6 md:mt-8 text-base md:text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed fade-rise fade-rise-delay-2">
        Choisissez un modèle et votre usage, en particulier ou pour une société : le coût total se recalcule à chaque réglage,
        achat, aides, énergie réelle, entretien, assurance et décote compris.
      </p>
    </div>

    <TcoCalculator client:load vehicles={summaries} />

    <p class="tco-week-link">
      Vous ne connaissez pas votre kilométrage annuel ?
      <a href={url("/ma-semaine/")}>Ma semaine en électrique</a> le calcule depuis votre adresse, avec vos trajets, vos recharges et le
      coût de l'énergie face à l'essence.
    </p>
  </div>
</BaseLayout>

<style>
  .tco-week-link {
    max-width: 72ch;
    margin: 2.5rem auto 0;
    padding-inline: 1rem;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-muted);
    text-align: center;
  }
  .tco-week-link a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Full-width page wrapper ─────────────────────────── */
  .tco-page-wrap {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: 1.5rem 1rem;
  }
  @media (min-width: 768px) {
    .tco-page-wrap { padding: 2rem 2rem; }
  }
  @media (min-width: 1280px) {
    .tco-page-wrap { padding: 2.5rem 3rem; }
  }

  .tco-page-header {
    margin-bottom: 2.5rem;
  }

</style>
