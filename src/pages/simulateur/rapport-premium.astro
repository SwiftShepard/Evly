---
/**
 * Rapport imprimable du simulateur (roadmap F8), gratuit : deux pages A4 à imprimer ou enregistrer
 * en PDF. Les réglages arrivent par l'adresse ; les données sont celles des fiches (lib/report).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import CostReport from "@/components/report/CostReport";
import { getReportVehicles } from "@/lib/report";

const vehicles = await getReportVehicles();
---

<BaseLayout title="Rapport de coût | Evly" description="Votre comparaison électrique ou thermique, à imprimer ou enregistrer en PDF." noindex>
  <CostReport client:only="react" vehicles={vehicles} />
</BaseLayout>

<style is:global>
  /* Global, préfixé .rp- : composant React rendu côté client */
  .rp-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; max-width: 60rem; margin: 1rem auto 0; padding: 0 1rem; font-size: 13px; font-weight: 600; color: var(--color-text-muted); }
  .rp-bar div { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .rp-bar a, .rp-bar button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem; border-radius: 999px; font-size: 13px; font-weight: 600; }
  .rp-bar a { border: 1px solid var(--color-border-strong); color: var(--color-text); }
  .rp-bar button { background: var(--color-accent); color: var(--color-accent-on); cursor: pointer; }
  .rp-empty { max-width: 40rem; margin: 3rem auto; padding: 0 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .rp-empty a { color: var(--color-accent); font-weight: 600; }

  .rp { display: flex; flex-direction: column; gap: 1.5rem; max-width: 60rem; margin: 1rem auto 3rem; padding: 0 1rem; color: var(--color-text); }
  .rp .report-page { display: flex; flex-direction: column; gap: 0.9rem; padding: 2rem 1.25rem; border-radius: var(--radius-tile); background: var(--color-surface); border: 1px solid var(--color-border); }
  @media (min-width: 768px) { .rp .report-page { padding: 2.75rem 3rem; } }
  .rp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-border); font-size: 12px; color: var(--color-text-faint); }
  .rp .report-logo { font-family: var(--font-display); font-size: 22px; font-weight: 800; letter-spacing: -0.03em; color: var(--color-accent); }
  .rp h1 { font-family: var(--font-display); font-size: clamp(1.6rem, 3.2vw, 2.2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .rp h2 { margin-top: 0.6rem; font-family: var(--font-display); font-size: 1.2rem; font-weight: 650; letter-spacing: -0.02em; }
  .rp-sub { margin-top: -0.4rem; font-size: 14px; color: var(--color-text-muted); }
  .rp-verdict { padding: 0.9rem 1.1rem; border-radius: var(--radius-tile-sm); background: var(--color-surface-accent); font-size: 15.5px; font-weight: 500; line-height: 1.5; }
  .rp-text { font-size: 14px; line-height: 1.55; color: var(--color-text-muted); }
  .rp-text b { color: var(--color-text); }
  .rp-small { font-size: 12.5px; line-height: 1.5; color: var(--color-text-faint); }
  .rp-list { display: flex; flex-direction: column; gap: 0.35rem; margin-left: 1.1rem; list-style: disc; font-size: 13px; line-height: 1.5; color: var(--color-text-muted); }
  .rp-foot { margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--color-border); font-size: 11.5px; color: var(--color-text-faint); }

  .rp-table { width: 100%; border-collapse: collapse; font-size: 13.5px; font-variant-numeric: tabular-nums; }
  .rp-table th, .rp-table td { padding: 0.5rem 0.4rem; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: baseline; }
  .rp-table td { text-align: right; white-space: nowrap; }
  .rp-table thead th { font-size: 11.5px; font-weight: 600; color: var(--color-text-faint); }
  .rp-table thead th:not(:first-child) { text-align: right; }
  .rp-table tbody th { font-weight: 600; }
  .rp-table tbody th span { display: block; font-size: 11.5px; font-weight: 400; color: var(--color-text-faint); }
  .rp-total th, .rp-total td { border-bottom: 0; font-family: var(--font-display); font-size: 1.05rem; font-weight: 800; }
  .rp-compact th, .rp-compact td { padding-block: 0.35rem; }

  @media print {
    .no-print, header, footer, nav, #reading-progress, .reading-progress, [class*="nav-header"] { display: none !important; }
    body, html { background: #fff !important; color: #111 !important; font-size: 10pt !important; margin: 0 !important; padding: 0 !important; }
    .rp { max-width: none !important; margin: 0 !important; padding: 0 !important; gap: 0 !important; }
    .rp .report-page {
      height: 296mm !important;
      width: 210mm !important;
      padding: 1.6cm !important;
      box-sizing: border-box !important;
      border: none !important;
      border-radius: 0 !important;
      background: #fff !important;
      break-after: page !important;
      page-break-after: always !important;
    }
    .rp-verdict { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .rp-table tr { break-inside: avoid; }
  }
</style>
