  .cc-ev, .cc-ice { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cc-ev { stroke: var(--cc-ev); }
  .cc-ice { stroke: var(--cc-ice); }
  .cc-dot, .cc-hover { stroke: var(--color-surface); stroke-width: 2; }
